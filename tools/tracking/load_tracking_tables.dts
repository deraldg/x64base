* load_tracking_tables.dts -- CREATE X64 + IMPORT the portal tracking tables (AIF-086 M1).
* Lane: TRACKING_STATE_DOGFOOD_LANE_V1.md. MAINTAINER-RUN: the steward sandbox cannot run
* the engine (glibc 2.35 vs required 2.38, measured 2026-08-04) -- authored, not run here.
*
* PRECONDITION -- run the extractor first, which (re)writes the CSVs:
*   python tools\tracking\seed_tracking.py
*   -> SYSLANE/SYSRUN/SYSRUNLANE/SYSPROOF .csv under dottalkpp\data\metadata\portal\seed\
*
* PATHS TO CONFIRM (owner) -- flagged, not guessed:
*   1. destination catalog dir: SET PATH DBF metadata/portal (parallel to identity/bbs per
*      DOTTALKPP_DBF_PATH_POLICY). Adjust if the portal catalog belongs elsewhere.
*   2. IMPORT source: metadata/portal/seed/<T>.csv, relative to the engine data root
*      (dottalkpp\data = datarun.ps1 cwd). Switch to absolute paths if your run cwd differs.
*
* Full re-seed snapshot. If a table already exists and re-seeding is authorized, uncomment
* its ERASE line. SYSTASK is intentionally absent (deferred: its source needs its own mapping).
* Grammar verified against cmd_create.cpp and tested regression scripts (buffer_visibility_*,
* canaries/*, comments/SOURCE_COMMENT_IMPORT_ONLY.dts).

SET ECHO OFF
ECHO ===== TRACKING TABLES CREATE + IMPORT START =====
SET PATH DBF metadata/portal

* ERASE SYSLANE CONFIRM
SELECT 0
CREATE X64 SYSLANE (ID N(20,0), LKEY C(16), TITLE C(160), OWNERKEY C(64), STEWARDKEY C(64), PROJECT C(48), SDLCLANE C(24), STATUS N(2,0), CLAIMED L, ANCHOR C(160), OPENAT N(20,0), CLOSEAT N(20,0), ROWVER N(20,0))
IMPORT metadata/portal/seed/SYSLANE.csv
ECHO SYSLANE loaded.

* ERASE SYSRUN CONFIRM
SELECT 1
CREATE X64 SYSRUN (ID N(20,0), RKEY C(48), MEMBERKEY C(64), ROLE C(24), OWNERKEY C(64), COMMITKEY C(64), AUTHORKEY C(64), PLANKEY C(64), PROJECT C(48), STATUS N(2,0), STARTAT N(20,0), BRANCH C(48), HANDLE C(48), REPORT C(48), ROWVER N(20,0))
IMPORT metadata/portal/seed/SYSRUN.csv
ECHO SYSRUN loaded.

* ERASE SYSRUNLANE CONFIRM
SELECT 2
CREATE X64 SYSRUNLANE (RUNKEY C(48), LANEKEY C(16))
IMPORT metadata/portal/seed/SYSRUNLANE.csv
ECHO SYSRUNLANE loaded.

* ERASE SYSPROOF CONFIRM
SELECT 3
CREATE X64 SYSPROOF (ID N(20,0), PKEY C(64), LABEL C(160), STATE C(24), LANEKEY C(16), SOURCE C(160), OBSAT N(20,0), ROWVER N(20,0))
IMPORT metadata/portal/seed/SYSPROOF.csv
ECHO SYSPROOF loaded.

ECHO ===== TRACKING TABLES CREATE + IMPORT DONE =====
