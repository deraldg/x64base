* ============================================================
* X64_FALLBACK_LOOKUP_ALIAS_CANARY.DTS
*
* Purpose:
*   Verify x64 descriptor fallback tokens are usable as command
*   lookup aliases after unique ~n fallback generation.
*
* Expected:
*   - authoritative long-name lookup works.
*   - fallback descriptor-token lookup works:
*       ABCDEFGHIJ
*       ABCDEFGH~1
*       ABCDEFGH~2
*   - close/reopen preserves both.
*   - COPY AS X64 VECTOR preserves both.
*   - COPY AS VFP remains strict and refuses destructive collisions.
*
* Scope:
*   Non-memo only.
*   No DBC support.
*   No memo vectors.
* ============================================================

SET ECHO OFF
ECHO ===== X64 FALLBACK LOOKUP ALIAS CANARY START =====

DO X64
ERASE VECALIAS CONFIRM
ERASE VECALIASCP CONFIRM
ERASE VECALIASVFP CONFIRM

ECHO ===== CREATE X64 WITH COLLIDING 10-BYTE FALLBACKS =====
CREATE X64 VECALIAS (ABCDEFGHIJK C(10), ABCDEFGHIJL C(10), ABCDEFGHIJM C(10), NORMAL C(10))
APPEND
REPLACE ABCDEFGHIJK WITH "ONE"
REPLACE ABCDEFGHIJL WITH "TWO"
REPLACE ABCDEFGHIJM WITH "THREE"
REPLACE NORMAL WITH "OK"

ECHO ===== AUTHORITATIVE LONG-NAME LOOKUP =====
TUPLE ABCDEFGHIJK,ABCDEFGHIJL,ABCDEFGHIJM,NORMAL

ECHO ===== FALLBACK TOKEN LOOKUP =====
TUPLE ABCDEFGHIJ,ABCDEFGH~1,ABCDEFGH~2,NORMAL

CLOSE
USE VECALIAS

ECHO ===== REOPEN AUTHORITATIVE LONG-NAME LOOKUP =====
TUPLE ABCDEFGHIJK,ABCDEFGHIJL,ABCDEFGHIJM,NORMAL

ECHO ===== REOPEN FALLBACK TOKEN LOOKUP =====
TUPLE ABCDEFGHIJ,ABCDEFGH~1,ABCDEFGH~2,NORMAL

ECHO ===== COPY AS X64 VECTOR SHOULD PRESERVE BOTH LOOKUP PATHS =====
COPY TO VECALIASCP AS X64 VECTOR OVERWRITE
CLOSE
USE VECALIASCP
TUPLE ABCDEFGHIJK,ABCDEFGHIJL,ABCDEFGHIJM,NORMAL
TUPLE ABCDEFGHIJ,ABCDEFGH~1,ABCDEFGH~2,NORMAL
CLOSE

ECHO ===== COPY AS VFP SHOULD STILL FAIL STRICTLY =====
USE VECALIAS
COPY TO VECALIASVFP AS VFP OVERWRITE
CLOSE
USE VECALIASVFP
STRUCT
CLOSE

ECHO ===== CLEANUP =====
DO X64
ERASE VECALIAS CONFIRM
ERASE VECALIASCP CONFIRM
ERASE VECALIASVFP CONFIRM

ECHO ===== X64 FALLBACK LOOKUP ALIAS CANARY END =====
