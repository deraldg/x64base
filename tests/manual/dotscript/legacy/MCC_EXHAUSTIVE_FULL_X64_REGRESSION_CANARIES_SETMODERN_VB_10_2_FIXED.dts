RECNO

* ------------------------------------------------------------
* SECTION 6 - STUDENTS PUBLIC INDEX WORKFLOW
* ------------------------------------------------------------
ECHO ===== STUDENTS / PUBLIC INDEX WORKFLOW =====
SELECT STUDENTS
AREA
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
AREA
ECHO [ORDER-ENTRY CANARY] TOP immediately after SET ORDER:
TOP
RECNO
LIST 5

ECHO ===== LOCATE / FIND / SEEK =====
LOCATE lname = Anderson
RECNO
TUPLE *
TOP
LOCATE lname = Taylor
RECNO
TUPLE *
TOP
FIND Taylor
TOP
FIND White
TOP
SEEK Davis
RECNO
TUPLE *
TOP

SET ORDER TO TAG FNAME
AREA
ECHO [ORDER-ENTRY CANARY] TOP immediately after SET ORDER:
TOP
RECNO
LIST 5
SEEK Alex
RECNO
TUPLE *
FIND Ava
LOCATE fname = Ava
TUPLE *

SET ORDER TO TAG LNAME
AREA
TOP
RECNO

ECHO ===== ORDERED CURSOR CANARIES =====
SEEK Taylor
RECNO
TUPLE *
LIST 1
LOCATE lname = Davis
RECNO
TUPLE *
LIST 1
SET ORDER TO TAG FNAME
SEEK Ava
RECNO
TUPLE *
LIST 1
LOCATE fname = Ava
RECNO
TUPLE *
LIST 1
SET ORDER TO TAG LNAME
TOP
RECNO

ECHO ===== BOOLEAN / PREDICATE GRAMMAR =====
TOP
LOCATE lname = Taylor
LIST 1
BOOLEAN (GPA > 3)
BOOLEAN (GPA < 3)
BOOLEAN (GPA >= 2 AND GPA <= 4)

ECHO ===== SMARTLIST =====
RECNO
SMARTLIST 5 FOR GPA >= 3.5
RECNO

ECHO ===== AGGREGATES =====
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA

ECHO ===== STUDENTS DATE FIELDS + DATE ALGEBRA =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
TUPLE DOB
TUPLE ENROLL_D
CALC DOB
CALC DOB + 1
CALC DOB - 1
CALC DATEADD(DOB, 30)
CALC DATEDIFF(DOB, DATE())
CALC DATE() - DOB
SET ORDER TO 0

* ------------------------------------------------------------
* SECTION 7 - RELATIONS ENGINE
* ------------------------------------------------------------
ECHO ===== RELATIONS ENGINE =====
REL CLEAR ALL
SELECT STUDENTS
SET RELATION OFF ALL
SELECT ENROLL
SET RELATION OFF ALL
REL CLEAR ALL
REL LIST

ECHO [REL-FOXPRO-CREATE-1]
SELECT STUDENTS
SET RELATION TO SID INTO ENROLL
REL LIST

ECHO [REL-FOXPRO-CREATE-2]
SELECT ENROLL
SET RELATION TO CLS_ID INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-REMOVE-ONE]
SELECT ENROLL
SET RELATION OFF INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-RESTORE]
SELECT ENROLL
SET RELATION TO CLS_ID INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-OFF-ALL]
SELECT ENROLL
SET RELATION OFF ALL
REL LIST

ECHO [REL-DOTTALK-RESTORE]
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL ADD CLASSES TASSIGN ON CLS_ID
REL ADD TASSIGN TEACHERS ON TID
REL LIST ALL
REL REFRESH

ECHO [REL-LIVE-USAGE]
SELECT STUDENTS
LOCATE lname = Taylor
TUPLE *
REL ENUM LIMIT 5 ENROLL CLASSES TASSIGN TEACHERS TUPLE STUDENTS.SID,STUDENTS.LNAME,TEACHERS.LNAME

ECHO [REL-DIAGNOSTICS]
REL REFRESH
REL_LIST
REL_REFRESH
CMDREL
CMDREL LIST
CMDREL REFRESH

* ------------------------------------------------------------
* SECTION 8 - BETA-0 READINESS GATE
* ------------------------------------------------------------
ECHO ===== BETA-0 READINESS GATE =====
ECHO [BETA-0] Compact integrated release gate
ECHO [BETA-0] Pass criteria:
ECHO [BETA-0]   - public index workflow works
ECHO [BETA-0]   - public relation wiring works
ECHO [BETA-0]   - REL ENUM emits rows
ECHO [BETA-0]   - buffering + COMMIT works
ECHO [BETA-0]   - help surfaces are present

ECHO [BETA-0-1] STUDENTS INDEX / SEEK
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
TOP
LIST 5
SEEK Taylor
DISPLAY

ECHO [BETA-0-2] SMARTLIST FILTER
SMARTLIST 5 FOR GPA >= 3.5

ECHO [BETA-0-3] FOXPRO RELATION WIRING
SET RELATION OFF ALL
SET RELATION TO SID INTO ENROLL
REL LIST

ECHO [BETA-0-4] EXTENDED RELATION CHAIN
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL ADD CLASSES TASSIGN ON CLS_ID
REL ADD TASSIGN TEACHERS ON TID
REL LIST ALL

ECHO [BETA-0-5] REL ENUM LIVE PROOF
SELECT STUDENTS
LOCATE lname = Taylor
REL ENUM LIMIT 5 ENROLL CLASSES TASSIGN TEACHERS TUPLE STUDENTS.SID,STUDENTS.LNAME,TEACHERS.LNAME

ECHO [BETA-0-6] BUFFER / COMMIT PROOF
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
TABLE ON
REPLACE GPA WITH GPA + 0.01
TABLE STALE
COMMIT
REPLACE GPA WITH GPA - 0.01
COMMIT
TABLE OFF

ECHO [BETA-0-7] HELP INTEGRITY
HELP REL
HELP TUPLE
HELP /FOX SEEK
ECHO [BETA-0-NOTE] TABLE STALE may still under-report buffered state even when COMMIT succeeds.

* ------------------------------------------------------------
* SECTION 9 - TUPLE CROSS-AREA / TUPTALK
* ------------------------------------------------------------
ECHO ===== TUPLE CROSS-AREA =====
SELECT STUDENTS
LOCATE lname = Taylor
TUPLE *
TUPLE LNAME,FNAME
TUPLE #13.*
TUPLE #12.*,#14.LNAME
TUPTALK

ECHO ===== TABLE BUFFER CANARY =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
LIST 1
TUPLE *
TABLE ON
REPLACE FNAME WITH "DeraldNew"
ECHO [BUF-VIS-1] TUPLE should show buffered value immediately:
TUPLE *
ECHO [BUF-VIS-2] LIST should still show persisted/indexed value until COMMIT:
LIST 1
COMMIT
ECHO [BUF-VIS-3] After COMMIT, verify by SEEK:
SEEK Taylor
LIST 1
REPLACE FNAME WITH "Derald"
COMMIT
TABLE OFF
SEEK Taylor
LIST 1

ECHO ===== CALCWRITE REVERSIBLE WRITE (GPA +/- 0.01) =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
SEEK Taylor
LIST 1
CALC GPA = GPA - 0.01
COMMIT
SEEK Taylor
LIST 1
TABLE OFF
SET ORDER TO 0

* ------------------------------------------------------------
* SECTION 10 - FILE OPS / SQLITE / DOTSCRIPT / CONTROL FLOW
* ------------------------------------------------------------
ECHO ===== FILE OPS SAFE =====
ECHO [NOTE] Use explicit dottalkpp\data\tmp paths for shell-created files.
! cmd /c "if not exist dottalkpp\data\tmp mkdir dottalkpp\data\tmp"
! cmd /c "echo DotTalkTmpProbe>dottalkpp\data\tmp\dt_probe.txt"
! cmd /c "echo DotTalkTmpProbe2>dottalkpp\data\tmp\dt_probe2.txt"
DIR dottalkpp\data\tmp\dt_probe.txt
DIR dottalkpp\data\tmp\dt_probe2.txt
ERASE dottalkpp\data\tmp\dt_probe.txt
ERASE dottalkpp\data\tmp\dt_probe2.txt
DIR dottalkpp\data\tmp

ECHO ===== SQLITE =====
SQLITE OPEN "dottalkpp\data\tmp\sql_regression.sqlite"
SQLITE EXEC CREATE TABLE IF NOT EXISTS t(x INT);
SQLITE EXEC DELETE FROM t;
SQLITE EXEC INSERT INTO t(x) VALUES (1);
SQLITE EXEC INSERT INTO t(x) VALUES (2);
SQLITE SELECT SELECT * FROM t;
SQLITE CLOSE

ECHO ===== DOTSCRIPT / GO =====
! cmd /c "echo SET ECHO ON>dottalkpp\data\tmp\mini_regression.dts"
! cmd /c "echo ECHO MINI_DOTSCRIPT_OK>>dottalkpp\data\tmp\mini_regression.dts"
DOTSCRIPT dottalkpp\data\tmp\mini_regression.dts
ECHO GO_OK
GO TOP

ECHO ===== SCRIPTING BLOCKS SAFE NON-LOOPING =====
IF .F.
    ECHO IF_BRANCH_RAN_UNEXPECTED
ELSE
    ECHO ELSE_BRANCH_RAN_OK
ENDIF

WHILE .F.
    ECHO WHILE_BODY_RAN_UNEXPECTED
ENDWHILE

UNTIL .T.
    ECHO UNTIL_BODY_RAN_UNEXPECTED
ENDUNTIL

ECHO ===== TUPTALK MINI =====
SELECT STUDENTS
TUPTALK RESET
TUPTALK PUSH ALL
TUPTALK PUSH FILTER CND
TUPTALK PUSH 3
TUPTALK PUSH ROW
TUPTALK LIST
TUPTALK NORMALIZE
TUPTALK DUMP
TUPTALK EXPORT CSV dottalkpp\data\tmp\students_norm.csv
TUPTALK EXPORT TSV dottalkpp\data\tmp\students_norm.tsv

ECHO ===== SQLITE SMOKE INLINE =====
SQLITE VERSION
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, n INTEGER);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('alpha', 10);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('bravo', 20);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('charlie', 30);
SQLITE SELECT SELECT id, name, n FROM t ORDER BY id;
SQLITE CLOSE

* ------------------------------------------------------------
* SECTION 11 - KNOWN-FAIL / OBSERVATION CANARIES
* ------------------------------------------------------------
ECHO ===== SECTION 11: KNOWN-FAIL / OBSERVATION CANARIES =====
ECHO ===== DATE COMPARISON CANARIES =====
CALC ((DATE() + 2) > DATE())
CALC ((DATE() - 2) < DATE())
CALC (CTOD("2000-01-01") + 1 = CTOD("2000-01-02"))
CALC (CTOD("2000-01-01") - 1 = CTOD("1999-12-31"))
SELECT STUDENTS
LOCATE lname = Taylor
CALC (DATEDIFF(DOB, DATE()) = -(DATE() - DOB))

ECHO ===== WHERE / SHOW FILTER OBSERVATION =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
WHERE GPA >= 3.5
SHOW TABLE
SHOW INDEX
COUNT

ECHO ===== SET FILTER UNDER ORDER OBSERVATION =====
SET FILTER TO LNAME = "TAYLOR"
COUNT
LIST 20
SET FILTER TO
SET FILTER TO LNAME = "ANDERSON"
COUNT
LIST 20
SET FILTER TO
SET FILTER TO FNAME = "AVA"
COUNT
LIST 20
SET FILTER TO
SET ORDER TO 0

ECHO ===== INDEXSEEK OBSERVATION =====
SELECT TEACHERS
SET INDEX TO teachers.cdx
SET ORDER TO TAG LNAME
FIND WILSON
SEEK WILSON
INDEXSEEK "WILSON"
SET ORDER TO 0

ECHO ===== DEV LMDB UTILITY PROBES =====
LMDB
LMDB OPEN students.cdx
LMDB USE LNAME
LMDB INFO
LMDB SEEK WILSON
LMDB SCAN A D
LMDB CLOSE

* ------------------------------------------------------------
* SECTION 12 - MANUAL / INTERACTIVE / DESTRUCTIVE NOTES ONLY
* ------------------------------------------------------------
ECHO ===== SECTION 12: MANUAL / INTERACTIVE / DESTRUCTIVE =====
ECHO [MANUAL] Interactive / hang-risk:
ECHO   WORKSPACE / SIMPLEBROWSER / SB
ECHO   SMARTBROWSER / SMART / SM
ECHO   BROWSE / BROWSER / BROWSETUI / BROWSETV
ECHO   FOXTALK / FOXPRO / TVISION / TURBOPACK
ECHO [MANUAL] Public BUILDLMDB workflow:
ECHO   SELECT STUDENTS
ECHO   SET INDEX TO students.cdx
ECHO   SET ORDER TO TAG LNAME
ECHO   BUILDLMDB
ECHO   SHOW INDEX
ECHO [MANUAL] Destructive ops not run here:
ECHO   DELETE / RECALL / UNDELETE / PACK / ZAP
ECHO [MANUAL] Unsupported or not yet public string commands observed:
ECHO   PROPER / ATC / PADC / PADL / PADR / STUFF / LIKE / CONCAT / STRCAT

* ------------------------------------------------------------
* CLEAN SHUTDOWN
* ------------------------------------------------------------
ECHO ===== CLEAN SHUTDOWN =====
SET ORDER TO 0
SCHEMAS
SCHEMAS CLOSE
ECHO ===== X64 REGRESSION VB_10_2_FIXED END =====
QUIT
