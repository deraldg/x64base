* ============================================================
* MCC_EXHAUSTIVE_FULL_X64_REGRESSION_CANARIES_SETMODERN_VB_10_2_FIXED.DTS
*
* TARGET: X64
*
* Purpose:
*   Public-surface regression harness for DotTalk++ current build.
*
* Primary fix from VB_10_1:
*   - Do not let SET PATH RESET leave the script on default DBF/index roots.
*   - Re-apply DBF/X64 and INDEXES/X64 after every reset and after INIT.
*   - Re-open SCHEMAS after memo/create sections before table/index tests.
*   - Replace semicolon comments with DotScript-safe star comments.
*   - Remove captured output/prompt lines from the executable script.
*
* Important:
*   BUILDLMDB is interactive/destructive and is NOT run in the automated core.
*   REINDEX is left as observation only and is not required to pass this script.
*  
* Passed 04/28/2026
* ============================================================

SET ECHO OFF
COLOR DEFAULT
ECHO ===== X64 REGRESSION VB_10_2_FIXED START =====
VERSION

* ------------------------------------------------------------
* SECTION 0 - CANONICAL X64 PATH SETUP
* ------------------------------------------------------------
ECHO ===== X64 PATH SETUP =====
DO X64
SET PATH

* Avoid SET PATH RESET unless immediately followed by X64 re-application.
ECHO ===== PATH RESET CANARY WITH X64 RESTORE =====
SET PATH RESET
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64
SET PATH

* INIT can reload ini state. Re-assert X64 after INIT.
ECHO ===== INIT / DIAGNOSTICS =====
INIT
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64
SET PATH
STATUS
WSREPORT
SHOW TABLE
SHOW COLUMNS
SHOW INDEX

* ------------------------------------------------------------
* SECTION 1 - SCHEMAS BRING-UP
* ------------------------------------------------------------
ECHO ===== SCHEMAS BRING-UP X64 =====
SCHEMAS CLOSE
REL CLEAR ALL
SCHEMAS OPEN DBF
SCHEMAS

ECHO ===== VERIFY NAMED SELECT WORKS =====
SELECT STUDENTS
AREA
STRUCT
COUNT
SELECT TEACHERS
AREA
STRUCT
COUNT
SELECT BUILDING
AREA
STRUCT
COUNT

* ------------------------------------------------------------
* SECTION 2 - BASELINE CLOCK / DATE-TIME
* ------------------------------------------------------------
ECHO ===== BASELINE CLOCK / DATE-TIME =====
DATE
TODAY
TIME
NOW
DATETIME
CALC DATE()
CALC TODAY()
CALC TIME()
CALC NOW()
CALC DATETIME()
CALC (DATE() = TODAY())
CALC (NOW() = DATETIME())

ECHO ===== DATE ALGEBRA / FUNCTION BASELINE =====
CALC DATE() + 2
CALC DATE() - 2
CTOD 2000-01-01
CTOD "2000-01-01"
CTOD "2000/01/01"
CTOD 20000101
CALC CTOD("2000-01-01")
CALC DTOC(CTOD("2000-01-01"))
DATEADD 20000101, 30
DATEADD 20000101, -30
DATEDIFF 20000101, 20000103
CALC DATEADD(DATE(), 30)
CALC DATEDIFF(CTOD("2000-01-01"), DATE())

ECHO ===== RHS EXPRESSION SANITY =====
CALC (3 = 1 + 2)
CALC ((1 + 2) = (6 / 2))
CALC ((1 + 2 * 3) = (1 + (2 * 3)))

* ------------------------------------------------------------
* SECTION 3 - STRING / CHAR COMMANDS
* Only public commands known to exist are active.
* Unsupported candidates are documented at the bottom as manual notes.
* ------------------------------------------------------------
ECHO ===== STRING / CHAR COMMANDS =====
ALLTRIM "  hi  "
LTRIM "  hi"
RTRIM "hi  "
TRIM "hi  "
UPPER "aBc"
LOWER "aBc"
LEN "ABCDE"
LEFT "ABCDE", 3
RIGHT "ABCDE", 2
SUBSTR "ABCDE", 2, 3
AT "CD", "ABCDE"
CHR 65
ASC "A"
SPACE 3
REPLICATE "x", 5
STR 123
VAL "123.45"
TRANSFORM 123

ECHO ===== NORMALIZE COMMAND =====
NORMALIZE C 10 "  a  b  "
NORMALIZE N 10 2 "1,234.50"
NORMALIZE D 8 2000-01-01
NORMALIZE L 1 T

* ------------------------------------------------------------
* SECTION 4 - MEMO SMOKE
* This section intentionally closes schemas. After it, schemas are reopened.
* ------------------------------------------------------------
ECHO ===== MEMO64 =====
SET TALK ON
CLOSE ALL
SCHEMAS CLOSE

ERASE MEMO_MSDOS CONFIRM
ERASE MEMO_FOX26 CONFIRM
ERASE MEMO_VFP CONFIRM
ERASE MEMO_X64 CONFIRM

ECHO Creating MSDOS memo table...
CREATE MSDOS MEMO_MSDOS (ID N(4,0), TITLE C(20), NOTES M)
APPEND
REPLACE ID WITH 1
REPLACE TITLE WITH MSDOS1
REPLACE NOTES WITH "msdos memo one"
TUP
CLOSE
USE MEMO_MSDOS
TUP
STRUCT
FIELDS
CLOSE

ECHO Creating FOX26 memo table...
CREATE FOX26 MEMO_FOX26 (ID N(4,0), TITLE C(20), NOTES M)
APPEND
REPLACE ID WITH 1
REPLACE TITLE WITH FOX261
REPLACE NOTES WITH "fox26 memo one"
TUP
CLOSE
USE MEMO_FOX26
TUP
STRUCT
FIELDS
CLOSE

ECHO Creating VFP memo table...
CREATE VFP MEMO_VFP (ID N(4,0), TITLE C(20), NOTES M)
APPEND
REPLACE ID WITH 1
REPLACE TITLE WITH VFP1
REPLACE NOTES WITH "vfp memo one"
TUP
CLOSE
USE MEMO_VFP
TUP
STRUCT
FIELDS
CLOSE

ECHO Creating X64 memo table...
CREATE X64 MEMO_X64 (ID N(8,0), TITLE C(20), NOTES M)
APPEND
REPLACE ID WITH 1
REPLACE TITLE WITH X641
REPLACE NOTES WITH "first x64 memo"
TUP
CLOSE
USE MEMO_X64
TUP
STRUCT
FIELDS

ECHO Updating X64 memo record...
REPLACE NOTES WITH "second x64 memo"
TUP
CLOSE
USE MEMO_X64
TUP

ECHO Clearing X64 memo record...
REPLACE NOTES WITH ""
TUP
CLOSE
USE MEMO_X64
TUP

ECHO Replacing cleared X64 memo...
REPLACE NOTES WITH "third x64 memo after clear"
TUP
CLOSE
USE MEMO_X64
TUP
CLOSE
ECHO ===== END MEMO =====

* Reopen all X64 tables. This is the important repair.
ECHO ===== REOPEN SCHEMAS AFTER MEMO SECTION =====
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64
SCHEMAS CLOSE
REL CLEAR ALL
SCHEMAS OPEN DBF
SCHEMAS

