* ============================================================
* MCC_TIER1_CORE_SURFACE_AND_INDEX_SAFE_V1.DTS
*
* Purpose:
*   Canonical safe Tier-1 regression for DotTalk++ MCC data.
*
* Scope:
*   - Non-destructive core surface checks on v32 tables
*   - Non-destructive CDX/LMDB public index checks on v64 tables
*   - SMARTLIST/tuple/seek/locate/count/reporting proof surface
*
* Safety contract:
*   - No APPEND / REPLACE / DELETE / RECALL / PACK / ZAP
*   - No CREATE / ERASE / IMPORT / EXPORT to canonical data
*   - No REINDEX / BUILDLMDB
*   - No intentional mutation of refreshed test data
*
* Path contract:
*   - Use explicit DBF/X32 and DBF/X64 roots.
*   - Do not rely on SCHEMAS OPEN DBF for cross-flavor behavior.
*
* Display contract:
*   - LIST is avoided as proof surface.
*   - SMARTLIST / SL, TUPLE/TUP, AREA, STATUS, SHOW INDEX are preferred.
* ============================================================

SET ECHO OFF
COLOR DEFAULT
ECHO ===== MCC TIER-1 CORE SURFACE AND INDEX SAFE V1 START =====

* ------------------------------------------------------------
* PHASE 0 - INIT / PROCESS SANITY
* ------------------------------------------------------------
ECHO ===== PHASE 0 INIT / STATUS =====
INIT
VERSION
STATUS
WSREPORT

* ------------------------------------------------------------
* PHASE 1 - CORE SURFACE, V32, READ-ONLY
* ------------------------------------------------------------
ECHO ===== PHASE 1 CORE SURFACE V32 READ-ONLY =====
SCHEMAS CLOSE
REL CLEAR ALL
SET FILTER TO

SETPATH DBF DBF/X32
SETPATH INDEXES INDEXES/X32
SCHEMAS OPEN DBF/X32
SCHEMAS

ECHO ===== V32 BUILDING =====
SELECT BUILDING
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
RECNO
SKIP 1
RECNO
BOTTOM
RECNO
TOP
RECNO

ECHO ===== V32 ROOMS =====
SELECT ROOMS
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 DEPT =====
SELECT DEPT
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 MAJORS =====
SELECT MAJORS
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 TERMS =====
SELECT TERMS
AREA
STRUCT
COUNT
SL 10
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 COURSES =====
SELECT COURSES
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 TEACHERS =====
SELECT TEACHERS
AREA
STRUCT
COUNT
SL 3
TUPLE *
LOCATE LNAME = "Wilson"
RECNO
TUPLE *
TOP

ECHO ===== V32 CLASSES =====
SELECT CLASSES
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

ECHO ===== V32 STUDENTS BASELINE =====
SELECT STUDENTS
AREA
STRUCT
COUNT
SL 3
TUPLE *
TOP
RECNO

ECHO ===== V32 STUDENTS FILTER / COUNT =====
SET FILTER TO
COUNT
COUNT DELETED
COUNT NOT DELETED
COUNT !DELETED
COUNT FOR LNAME = "ANDERSON"
COUNT WHERE GPA > 3.5
COUNT GPA > 3.5

SET FILTER TO FNAME = "AVA"
COUNT
COUNT FOR GPA > 2.5
COUNT FOR LNAME = "WHITE"
TOP
SL 10
SET FILTER TO

ECHO ===== V32 STUDENTS LOCATE / CONTINUE =====
LOCATE LNAME = "ANDERSON"
RECNO
TUP
CONTINUE
RECNO
TUP
CONTINUE
RECNO
TUP
TOP

ECHO ===== V32 BOOLEAN / SMARTLIST =====
LOCATE LNAME = "Taylor"
RECNO
TUPLE *
BOOLEAN (GPA > 3)
BOOLEAN (GPA < 3)
BOOLEAN (GPA >= 2 AND GPA <= 4)
SMARTLIST 5 FOR GPA >= 3.5
RECNO

ECHO ===== V32 AGGREGATES =====
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA

SET FILTER TO FNAME = "AVA"
COUNT
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA
SET FILTER TO

ECHO ===== V32 DATE / TIME / EXPRESSION =====
DATE
TODAY
TIME
NOW
DATETIME
CALC DATE()
CALC TODAY()
CALC TIME()
CALC NOW()
CALC DATETIME()
CALC (DATE() = TODAY())
CALC (NOW() = DATETIME())
CALC DATE() + 2
CALC DATE() - 2
CTOD 2000-01-01
CTOD "2000-01-01"
CTOD "2000/01/01"
CTOD 20000101
CALC CTOD("2000-01-01")
CALC DTOC(CTOD("2000-01-01"))
DATEADD 20000101, 30
DATEADD 20000101, -30
DATEDIFF 20000101, 20000103
CALC DATEADD(DATE(), 30)
CALC DATEDIFF(CTOD("2000-01-01"), DATE())

ECHO ===== V32 RELATIONS READ-ONLY =====
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL LIST
REL REFRESH
REL_LIST
REL_REFRESH

ECHO ===== V32 SQLITE MEMORY SMOKE =====
SQLITE VERSION
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, n INTEGER);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('alpha', 10);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('bravo', 20);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('charlie', 30);
SQLITE SELECT SELECT id, name, n FROM t ORDER BY id;
SQLITE CLOSE

ECHO ===== V32 SCRIPTING BLOCKS READ-ONLY =====
IF .F.
    ECHO IF_BRANCH_RAN_UNEXPECTED
ELSE
    ECHO ELSE_BRANCH_RAN_OK
ENDIF

WHILE .F.
    ECHO WHILE_BODY_RAN_UNEXPECTED
ENDWHILE

UNTIL .T.
    ECHO UNTIL_BODY_RAN_UNEXPECTED
ENDUNTIL

SELECT BUILDING
TOP
SCAN
    TUPLE *
ENDSCAN

SCHEMAS CLOSE
REL CLEAR ALL
SET FILTER TO

* ------------------------------------------------------------
* PHASE 2 - CDX / LMDB PUBLIC INDEX SURFACE, V64, READ-ONLY
* ------------------------------------------------------------
ECHO ===== PHASE 2 CDX / LMDB V64 READ-ONLY =====
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64

ECHO ===== V64 STUDENTS ATTACH / ORDER LNAME =====
USE STUDENTS
AREA
STATUS
SET INDEX TO STUDENTS
SET ORDER TO TAG LNAME
AREA
STATUS
SHOW INDEX
TOP
RECNO
SMARTLIST 10
TUP

ECHO ===== V64 STUDENTS SEEK / FIND / LOCATE LNAME =====
SEEK Taylor
RECNO
TUPLE *
TOP
FIND White
RECNO
TUPLE *
TOP
LOCATE LNAME = "ANDERSON"
RECNO
TUPLE *
CONTINUE
RECNO
TUPLE *
TOP

ECHO ===== V64 STUDENTS SECONDARY TAG FNAME =====
SET ORDER TO TAG FNAME
AREA
TOP
RECNO
SMARTLIST 10
SEEK Ava
RECNO
TUPLE *
LOCATE FNAME = "AVA"
RECNO
TUPLE *

ECHO ===== V64 STUDENTS SECONDARY TAG DOB =====
SET ORDER TO TAG DOB
AREA
TOP
RECNO
SMARTLIST 10

ECHO ===== V64 STUDENTS ORDER OFF =====
SET ORDER TO 0
AREA
TOP
RECNO
SMARTLIST 10
CLOSE

ECHO ===== V64 TEACHERS INDEX SURFACE =====
USE TEACHERS
AREA
SET INDEX TO TEACHERS
SET ORDER TO TAG LNAME
AREA
STATUS
SHOW INDEX
TOP
RECNO
SMARTLIST 10
SEEK Wilson
RECNO
TUPLE *
INDEXSEEK "WILSON"
SET ORDER TO 0
CLOSE

ECHO ===== V64 BUILDING INDEX SURFACE =====
USE BUILDING
AREA
SET INDEX TO BUILDING
SET ORDER TO TAG BLDG
AREA
STATUS
SHOW INDEX
TOP
RECNO
SMARTLIST 10
SET ORDER TO 0
CLOSE

SCHEMAS CLOSE
REL CLEAR ALL
SET FILTER TO

ECHO ===== MCC TIER-1 CORE SURFACE AND INDEX SAFE V1 END =====
QUIT
