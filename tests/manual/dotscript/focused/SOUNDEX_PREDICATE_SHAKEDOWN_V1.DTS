* ============================================================
* SOUNDEX_PREDICATE_SHAKEDOWN_V1.DTS
*
* Purpose:
*   Verify that FOR predicates use the full expression evaluator.
*
* Safety:
*   Read-only.
* ============================================================

SET ECHO OFF
COLOR DEFAULT
ECHO ===== SOUNDEX PREDICATE SHAKEDOWN V1 START =====

DO X64
USE STUDENTS

ECHO ===== BASELINE FIELD / CALC CHECK =====
LOCATE FOR LNAME = "WHITE"
RECNO
TUPLE *
CALC SOUNDEX(LNAME)
CALC SOUNDEX("WHITE")
CALC (SOUNDEX(LNAME) = SOUNDEX("WHITE"))

ECHO ===== FUNCTION IN LOCATE FOR =====
TOP
LOCATE FOR SOUNDEX(LNAME) = SOUNDEX("WHITE")
RECNO
TUPLE *

ECHO ===== FUNCTION IN COUNT FOR =====
COUNT FOR SOUNDEX(LNAME) = SOUNDEX("WHITE")

ECHO ===== FUNCTION IN SMARTLIST FOR =====
SMARTLIST FOR SOUNDEX(LNAME) = SOUNDEX("WHITE")

ECHO ===== OTHER FUNCTION PREDICATE CHECKS =====
TOP
LOCATE FOR UPPER(LNAME) = "WHITE"
RECNO
TUPLE *

COUNT FOR LEFT(LNAME,1) = "W"
SMARTLIST 10 FOR LEFT(LNAME,1) = "W"

ECHO ===== CLEAN SHUTDOWN =====
CLOSE
ECHO ===== SOUNDEX PREDICATE SHAKEDOWN V1 END =====
QUIT
