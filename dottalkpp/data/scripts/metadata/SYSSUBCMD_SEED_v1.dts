SELECT 0

CREATE X64 SYSSUBCMD ( SUB_ID C(32), PARENT C(80), SUB_NAME C(80), QUAL_NAME C(140), DISP_STYL C(32), IMPL_STAT C(32), VIS_TIER C(32), OWNER C(64), REG_RING C(64), LIFE_PH C(48), SRC_AUTH C(64), SRC_FILE C(180), HANDLER C(96), PUB_SURF L, DISP_REACH L, OUT_ROUTE L, MSG_CAT L, ACTIVE L, VER_AT C(24), NOTES M )

USE SYSSUBCMD
