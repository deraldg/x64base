ECHO ===== RELATIONS ENGINE =====

ECHO [REL-BASELINE]
REL LIST
SELECT STUDENTS
SET RELATION OFF ALL
SELECT ENROLL
SET RELATION OFF ALL
REL CLEAR ALL
REL LIST

ECHO [REL-FOXPRO-CREATE-1]
SELECT STUDENTS
SET RELATION TO SID INTO ENROLL
REL LIST

ECHO [REL-FOXPRO-CREATE-2]
SELECT ENROLL
SET RELATION TO CLS_ID INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-REMOVE-ONE]
SELECT ENROLL
SET RELATION OFF INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-RESTORE]
SELECT ENROLL
SET RELATION TO CLS_ID INTO CLASSES
REL LIST

ECHO [REL-FOXPRO-OFF-ALL]
SELECT ENROLL
SET RELATION OFF ALL
REL LIST

ECHO [REL-DOTTALK-RESTORE]
REL ADD ENROLL CLASSES ON CLS_ID
REL LIST

ECHO [REL-FOXPRO-MULTI-INTO]
SELECT STUDENTS
SET RELATION OFF ALL
SET RELATION TO SID INTO ENROLL, SID INTO STUD_MAJ
REL LIST

ECHO [REL-FOXPRO-ADDITIVE]
SELECT STUDENTS
SET RELATION OFF ALL
SET RELATION TO SID INTO ENROLL
SET RELATION ADDITIVE TO SID INTO STUD_MAJ
REL LIST

ECHO [REL-DOTTALK-LEGACY-COMPAT]
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL LIST

ECHO [REL-LIVE-USAGE]
SELECT STUDENTS
LOCATE lname = Taylor
TUPLE *

ECHO [REL-DIAGNOSTICS]
REL REFRESH
REL_LIST
REL_REFRESH
CMDREL
CMDREL LIST
CMDREL REFRESH

ECHO ===== REASSERT X64 WORKSPACE BEFORE BETA-0 GATE =====
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64
SCHEMAS OPEN DBF
SELECT STUDENTS
AREA

ECHO ===== BETA-0 READINESS GATE =====
ECHO [BETA-0] Compact integrated release gate
ECHO [BETA-0] Pass criteria:
ECHO [BETA-0]   - public index workflow works
ECHO [BETA-0]   - public relation wiring works
ECHO [BETA-0]   - REL ENUM emits rows
ECHO [BETA-0]   - buffering + COMMIT works
ECHO [BETA-0]   - help surfaces are present

ECHO [BETA-0-1] STUDENTS INDEX / SEEK
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
TOP
LIST 5
SEEK Taylor
DISPLAY

ECHO [BETA-0-2] SMARTLIST FILTER
SMARTLIST 5 FOR GPA >= 3.5

ECHO [BETA-0-3] FOXPRO RELATION WIRING
SET RELATION OFF ALL
SET RELATION TO SID INTO ENROLL
REL LIST

ECHO [BETA-0-4] EXTENDED RELATION CHAIN
REL ADD ENROLL CLASSES ON CLS_ID
REL ADD CLASSES TASSIGN ON CLS_ID
REL ADD TASSIGN TEACHERS ON TID
REL LIST ALL

ECHO [BETA-0-5] REL ENUM LIVE PROOF
LOCATE lname = Taylor
REL ENUM LIMIT 5 ENROLL CLASSES TASSIGN TEACHERS TUPLE STUDENTS.SID,STUDENTS.LNAME,TEACHERS.LNAME

ECHO [BETA-0-6] BUFFER / COMMIT PROOF
LOCATE lname = Taylor
TABLE ON
REPLACE GPA WITH GPA + 0.01
TABLE STALE
COMMIT
REPLACE GPA WITH GPA - 0.01
COMMIT
TABLE OFF

ECHO [BETA-0-7] HELP INTEGRITY
HELP REL
HELP TUPLE
HELP /FOX SEEK

ECHO [BETA-0-NOTE] TABLE STALE may still under-report buffered state even when COMMIT succeeds.

ECHO ===== TUPLE CROSS-AREA =====
SELECT STUDENTS
LOCATE lname = Taylor
TUPLE *
TUPLE LNAME,FNAME
TUPLE #11.*
TUPLE #9.*,#11.LNAME
TUPTALK

ECHO ===== TABLE BUFFER CANARY =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
LIST 1
TUPLE *
TABLE ON
REPLACE FNAME WITH "DeraldNew"
ECHO [BUF-VIS-1] TUPLE should show buffered value immediately:
TUPLE *
ECHO [BUF-VIS-2] LIST should still show persisted/indexed value until COMMIT:
LIST 1
COMMIT
ECHO [BUF-VIS-3] After COMMIT, verify by SEEK:
SEEK Taylor
LIST 1
REPLACE FNAME WITH "Derald"
COMMIT
TABLE OFF
SEEK Taylor
LIST 1

ECHO ===== CALCWRITE REVERSIBLE WRITE (GPA +/- 0.01) =====
SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
SEEK Taylor
LIST 1
CALC GPA = GPA - 0.01
COMMIT
SEEK Taylor
LIST 1
TABLE OFF

ECHO ===== LEGACY / TRANSITIONAL REINDEX CANARIES =====
SELECT BUILDING
SET INDEX TO building.cdx
SET ORDER TO TAG BLDG
ECHO [SKIP] REINDEX is interactive/destructive in this build; use manual section if needed.
SHOW INDEX

SELECT STUDENTS
SET INDEX TO students.cdx
SET ORDER TO TAG LNAME
ECHO [SKIP] REINDEX is interactive/destructive in this build; use manual section if needed.
SHOW INDEX
INDEXSEEK "DAVIS"

ECHO ===== FILE OPS (SAFE, under tmp\) =====
ECHO [NOTE] Keep explicit filenames; avoid wildcard DIR / ERASE in DotTalk.
! cmd /c "echo DotTalkTmpProbe>tmp\dt_probe.txt"
! cmd /c "echo DotTalkTmpProbe2>tmp\dt_probe2.txt"
DIR tmp\dt_probe.txt
DIR tmp\dt_probe2.txt
ERASE tmp\dt_probe.txt
ERASE tmp\dt_probe2.txt
DIR tmp

ECHO ===== SQLITE =====
SQLITE OPEN "tmp\sql_regression.sqlite"
SQLITE EXEC CREATE TABLE IF NOT EXISTS t(x INT);
SQLITE EXEC DELETE FROM t;
SQLITE EXEC INSERT INTO t(x) VALUES (1);
SQLITE EXEC INSERT INTO t(x) VALUES (2);
SQLITE SELECT SELECT * FROM t;
SQLITE CLOSE

ECHO ===== DOTSCRIPT / GO (REAL, NOT USAGE) =====
! cmd /c "echo SET ECHO ON>tmp\mini_regression.dts"
! cmd /c "echo ECHO MINI_DOTSCRIPT_OK>>tmp\mini_regression.dts"
DOTSCRIPT tmp\mini_regression.dts
ECHO GO_OK
GO TOP

ECHO ===== SCRIPTING BLOCKS (SAFE NON-LOOPING) =====
IF .F.
    ECHO IF_BRANCH_RAN_UNEXPECTED
ELSE
    ECHO ELSE_BRANCH_RAN_OK
ENDIF

WHILE .F.
    ECHO WHILE_BODY_RAN_UNEXPECTED
ENDWHILE

UNTIL .T.
    ECHO UNTIL_BODY_RAN_UNEXPECTED
ENDUNTIL

SELECT BUILDING
SET INDEX TO building.cdx
SET ORDER TO TAG BLDG
TOP
SCAN
    TUPLE *
ENDSCAN
SET ORDER TO 0

ECHO ===== TUPTALK MINI =====
SELECT STUDENTS
TUPTALK RESET
TUPTALK PUSH ALL
TUPTALK PUSH FILTER CND
TUPTALK PUSH 3
TUPTALK PUSH ROW
TUPTALK LIST
TUPTALK NORMALIZE
TUPTALK DUMP
TUPTALK EXPORT CSV students_norm.csv
TUPTALK EXPORT TSV students_norm.tsv

ECHO ===== SQLITE SMOKE (INLINE) =====
SQLITE VERSION
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, n INTEGER);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('alpha', 10);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('bravo', 20);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('charlie', 30);
SQLITE SELECT SELECT id, name, n FROM t ORDER BY id;
SQLITE CLOSE

