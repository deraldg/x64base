SET ECHO OFF
ECHO ===== V7A X64 LMDB INDEX START =====
COLOR DEFAULT
VERSION

ECHO ===== INIT / X64 PATH =====
INIT
SET PATH
SETPATH DBF XDBF
SET PATH

SCHEMAS CLOSE
REL CLEAR ALL

ECHO ===== OPEN X64 TABLE =====
USE X64SAMPLE
AREA
STRUCT
COUNT
TOP
LIST 5

ECHO ===== ATTACH INDEX =====
SET INDEX TO X64SAMPLE.cdx
AREA
SHOW INDEX

ECHO ===== ORDER ATTACH =====
* adjust tag names based on your CDX
SET ORDER TO TAG ID
AREA
SHOW INDEX

TOP
RECNO
LIST 5

ECHO ===== INDEX SEEK =====
INDEXSEEK "1"
INDEXSEEK "5"

ECHO ===== ORDER SWITCH =====
SET ORDER TO TAG NAME
AREA
SHOW INDEX
TOP
LIST 5

SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== TABLE BUFFER + INDEX UPDATE =====
LOCATE
TUPLE *

TABLE ON
REPLACE NAME WITH "TESTX64"
TUPLE *
LIST 1

COMMIT
TOP
LIST 5

REPLACE NAME WITH "RESET"
COMMIT
TABLE OFF

ECHO ===== LMDB DIRECT =====
LMDB
LMDB OPEN X64SAMPLE.cdx.d
LMDB INFO

LMDB USE ID
LMDB SEEK 1
LMDB SCAN 1 10

LMDB USE NAME
LMDB SEEK TESTX64
LMDB CLOSE

ECHO ===== REINDEX =====
SET INDEX TO X64SAMPLE.cdx
SET ORDER TO TAG ID
REINDEX
SHOW INDEX

ECHO ===== CLEAN =====
SET ORDER TO 0
ECHO ===== V7A X64 LMDB INDEX END =====
QUIT