; ============================================================================
; AIF-074 P4.3 -- SQLsel LEFT JOIN, produced absence, and oracle gate G4c
;
; Status: CANDIDATE / explicit-run pending this widened oracle gate
; Safety: MUTATING (SANDBOX only; two fixtures and sidecars self-erase)
;
; Proves:
;   LJ1 duplicate matches multiply without suppressing unmatched outer rows.
;   LJ2 a genuine blank right value remains blank while an unmatched right
;       value renders as the one TupleRow marker, <UNMATCHED>.
;   LJ3 genuine stored text equal to the marker remains a matched row; the
;       left-extended count is the independent evidence that separates it.
;   LJ4 a deleted outer row is absent and a deleted-only inner match extends.
;   LJ5 CDX seek and nested-loop scan return the same rows and counts.
;   LJ6 both source cursors survive, and a caller-owned FLOCK is preserved.
;   LJ7 LEFT WHERE follows ON -> extension -> WHERE operator order.
;   LJ8 produced-absent comparisons yield UNKNOWN; WHERE keeps only TRUE.
;   ORACLE SQLite NULL is mapped explicitly to <UNMATCHED>.
;
; Read rule: REGRESSION SQLSEL_LEFT_JOIN must print
;   SQLSEL LEFT JOIN ORACLE: PASS.
; The validator compares seven row sets, requires seven exact left-extended
; reports, 3 seek + 4 scan paths, seven read fences, cursor/lock evidence, and
; explicit UNKNOWN truth-table behavior. A direct DOTSCRIPT run does not invoke it.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET DELETED OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-LJ-BEGIN"

ERASE TABLE SQLLJL CONFIRM
ERASE TABLE SQLLJR CONFIRM

CREATE X64 SQLLJL (ID N(6,0), LBL C(8))
APPEND
REPLACE ID WITH "1"
REPLACE LBL WITH "L1"
APPEND
REPLACE ID WITH "2"
REPLACE LBL WITH "L2"
APPEND
REPLACE ID WITH "3"
REPLACE LBL WITH "L3"
APPEND
REPLACE ID WITH "4"
REPLACE LBL WITH "GHOSTL"
APPEND
REPLACE ID WITH "5"
REPLACE LBL WITH "L5"
APPEND
REPLACE ID WITH "6"
REPLACE LBL WITH "L6"
CLOSE

CREATE X64 SQLLJR (ID N(6,0), PAYLOAD C(16))
APPEND
REPLACE ID WITH "1"
REPLACE PAYLOAD WITH "R1A"
APPEND
REPLACE ID WITH "1"
REPLACE PAYLOAD WITH "R1B"
APPEND
REPLACE ID WITH "2"
; PAYLOAD deliberately remains a genuine DBF blank.
APPEND
REPLACE ID WITH "3"
REPLACE PAYLOAD WITH "GHOSTR"
APPEND
REPLACE ID WITH "5"
REPLACE PAYLOAD WITH "<UNMATCHED>"
APPEND
REPLACE ID WITH "9"
REPLACE PAYLOAD WITH "ORPHAN"
CLOSE

SELECT 1
USE SQLLJL
GO 4
DELETE
GO 6

SELECT 2
USE SQLLJR
CDX CREATE
CDX ADDTAG ID
BUILDLMDB CLEAN YES
SET INDEX TO SQLLJR
SET ORDER TO TAG ID
GO 4
DELETE
GO 6

SELECT 1
LOCK TABLE
FORMULA "SQLSEL-LJ-SEEK-ROWS-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID ORDER BY L.ID
FORMULA "SQLSEL-LJ-SEEK-ROWS-END"

FORMULA "SQLSEL-LJ-SEEK-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID
FORMULA "SQLSEL-LJ-SEEK-COUNT-END"

FORMULA "SQLSEL-LJ-SEEK-WHERE-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID WHERE R.PAYLOAD = "R1A" ORDER BY L.ID
FORMULA "SQLSEL-LJ-SEEK-WHERE-END"

? "LJ_T1_caller_table_lock_preserved:" + FILE("DBF/SANDBOX/SQLLJL.dbf.lock")
UNLOCK TABLE

SELECT 2
SET ORDER TO 0
GO 6
SELECT 1

FORMULA "SQLSEL-LJ-SCAN-ROWS-BEGIN"
SQLSEL SELECT L.LBL,R.PAYLOAD FROM SQLLJL AS L LEFT JOIN SQLLJR AS R ON L.ID = R.ID ORDER BY L.ID
FORMULA "SQLSEL-LJ-SCAN-ROWS-END"

FORMULA "SQLSEL-LJ-SCAN-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID
FORMULA "SQLSEL-LJ-SCAN-COUNT-END"

FORMULA "SQLSEL-LJ-SCAN-WHERE-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID WHERE R.PAYLOAD = "R1A" ORDER BY L.ID
FORMULA "SQLSEL-LJ-SCAN-WHERE-END"

FORMULA "SQLSEL-LJ-UNKNOWN-OR-TRUE-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID = R.ID WHERE R.PAYLOAD = "NOPE" OR L.LBL = "L3" ORDER BY L.ID
FORMULA "SQLSEL-LJ-UNKNOWN-OR-TRUE-END"

SELECT 1
? "LJ_C1_left_cursor_restored:" + (ID = 6 AND ALLTRIM(LBL) = "L6")
SELECT 2
? "LJ_C2_right_cursor_restored:" + (ID = 9 AND ALLTRIM(PAYLOAD) = "ORPHAN")

FORMULA "SQLSEL-LJ-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLLJL (ID INTEGER, LBL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLLJR (ID INTEGER, PAYLOAD TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLLJL VALUES (1,'L1',0),(2,'L2',0),(3,'L3',0),(4,'GHOSTL',1),(5,'L5',0),(6,'L6',0);
SQLITE EXEC INSERT INTO SQLLJR VALUES (1,'R1A',0),(1,'R1B',0),(2,'',0),(3,'GHOSTR',1),(5,'<UNMATCHED>',0),(9,'ORPHAN',0);

FORMULA "SQLSEL-LJ-O1-BEGIN"
SQLITE SELECT SELECT L.LBL,COALESCE(R.PAYLOAD,'<UNMATCHED>') FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0 ORDER BY L.ID;
FORMULA "SQLSEL-LJ-O1-END"

FORMULA "SQLSEL-LJ-O2-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0;
FORMULA "SQLSEL-LJ-O2-END"

FORMULA "SQLSEL-LJ-O3-BEGIN"
SQLITE SELECT SELECT L.LBL,COALESCE(R.PAYLOAD,'<UNMATCHED>') FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0 ORDER BY L.ID;
FORMULA "SQLSEL-LJ-O3-END"

FORMULA "SQLSEL-LJ-O4-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0;
FORMULA "SQLSEL-LJ-O4-END"

FORMULA "SQLSEL-LJ-O5-BEGIN"
SQLITE SELECT SELECT L.LBL,COALESCE(R.PAYLOAD,'<UNMATCHED>') FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0 AND R.PAYLOAD='R1A' ORDER BY L.ID;
FORMULA "SQLSEL-LJ-O5-END"

FORMULA "SQLSEL-LJ-O6-BEGIN"
SQLITE SELECT SELECT L.LBL,COALESCE(R.PAYLOAD,'<UNMATCHED>') FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0 AND R.PAYLOAD='R1A' ORDER BY L.ID;
FORMULA "SQLSEL-LJ-O6-END"

FORMULA "SQLSEL-LJ-O7-BEGIN"
SQLITE SELECT SELECT L.LBL,COALESCE(R.PAYLOAD,'<UNMATCHED>') FROM SQLLJL L LEFT JOIN SQLLJR R ON L.ID=R.ID AND R.D=0 WHERE L.D=0 AND (R.PAYLOAD='NOPE' OR L.LBL='L3') ORDER BY L.ID;
FORMULA "SQLSEL-LJ-O7-END"

SQLITE CLOSE
FORMULA "SQLSEL-LJ-ORACLE-END"

SELECT 2
CLOSE
SELECT 1
CLOSE
ERASE TABLE SQLLJL CONFIRM
ERASE TABLE SQLLJR CONFIRM

SET DELETED ON
FORMULA "SQLSEL-LJ-END"
