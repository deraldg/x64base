* ============================================================
* SYSTEM_METADATA_SEED_v4_safe10_FIXED2.dts
*
* Purpose:
*   Seed first truth rows into the working x64 metadata catalog.
*
* Contract:
*   - Uses shortened working table names:
*       SYSCMD, SYSENTVAR, SYSSUBCMD, SYSFUNC, SYSMSG,
*       SYSHELP, SYSARGS, SYSFLDDIC
*   - Uses one physical command per line.
*   - Does not use MULTIREP or continuation syntax.
*   - Uses <=10-character field tokens.
*   - Writes real memo text.
* ============================================================

SET ECHO OFF
SET PAGING OFF

DO metadata

* ------------------------------------------------------------
* SYSCMD seed rows
* ------------------------------------------------------------
USE SYSCMD

APPEND
REPLACE CMD_ID WITH "CMD_SET"
REPLACE CAN_NAME WITH "SET"
REPLACE DISP_NAME WITH "SET"
REPLACE ENTRY_KIND WITH "command"
REPLACE IMPL_STAT WITH "partial"
REPLACE VIS_TIER WITH "core"
REPLACE OWNER WITH "command_router"
REPLACE REG_RING WITH "core_settings"
REPLACE LIFE_PH WITH "session"
REPLACE SRC_AUTH WITH "registry"
REPLACE SRC_HINT WITH "cmd"
REPLACE SRC_FILE WITH "shell_commands.cpp"
REPLACE HANDLER WITH "cmd_SET"
REPLACE HAS_HDLR WITH T
REPLACE DISP_REACH WITH T
REPLACE PUB_SURF WITH T
REPLACE SELF_REG WITH F
REPLACE TIMER WITH T
REPLACE OUT_ROUTE WITH T
REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "SET is a command family and router. SET PATH, SET INDEX, SET ORDER, and related forms should be modeled as subcommands or re-expressions, not independent flat commands."

APPEND
REPLACE CMD_ID WITH "CMD_REL"
REPLACE CAN_NAME WITH "REL"
REPLACE DISP_NAME WITH "REL"
REPLACE ENTRY_KIND WITH "command"
REPLACE IMPL_STAT WITH "implemented"
REPLACE VIS_TIER WITH "core"
REPLACE OWNER WITH "relation_engine"
REPLACE REG_RING WITH "relations"
REPLACE LIFE_PH WITH "session"
REPLACE SRC_AUTH WITH "registry"
REPLACE SRC_HINT WITH "cmd"
REPLACE SRC_FILE WITH "shell_commands.cpp"
REPLACE HANDLER WITH "cmd_REL"
REPLACE HAS_HDLR WITH T
REPLACE DISP_REACH WITH T
REPLACE PUB_SURF WITH T
REPLACE SELF_REG WITH F
REPLACE TIMER WITH T
REPLACE OUT_ROUTE WITH T
REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "REL owns relation commands and relational enumeration surfaces. REL ENUM belongs under REL as a subcommand-level surface."

APPEND
REPLACE CMD_ID WITH "CMD_HELP"
REPLACE CAN_NAME WITH "HELP"
REPLACE DISP_NAME WITH "HELP"
REPLACE ENTRY_KIND WITH "command"
REPLACE IMPL_STAT WITH "implemented"
REPLACE VIS_TIER WITH "core"
REPLACE OWNER WITH "help_system"
REPLACE REG_RING WITH "help_meta"
