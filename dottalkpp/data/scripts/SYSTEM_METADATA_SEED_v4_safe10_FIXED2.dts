REPLACE SRC_HINT WITH "cmd"
REPLACE SRC_FILE WITH "cmd_helpchk.cpp"
REPLACE HANDLER WITH "cmd_CMDHELPCHK"
REPLACE HAS_HDLR WITH T
REPLACE DISP_REACH WITH T
REPLACE PUB_SURF WITH T
REPLACE SELF_REG WITH F
REPLACE TIMER WITH F
REPLACE OUT_ROUTE WITH T
REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "CMDHELPCHK should evolve into the congruence validator across registry, ReferenceCollection, SYSTEM metadata, legacy help DBFs, functions, messages, and diagrams."
REPLACE ALL DEF_LOCALE WITH "en-US"
REPLACE ALL REGION_ID WITH "GLOBAL"

* ------------------------------------------------------------
* SYSSUBCMD seed rows
* ------------------------------------------------------------
USE SYSSUBCMD

APPEND
REPLACE SUB_ID WITH "SUB_SET_PATH"
REPLACE PARENT WITH "SET"
REPLACE SUB_NAME WITH "PATH"
REPLACE QUAL_NAME WITH "SET PATH"
REPLACE DISP_STYL WITH "routed"
REPLACE IMPL_STAT WITH "implemented"
REPLACE VIS_TIER WITH "core"
