REPLACE HAS_HDLR WITH T
REPLACE DISP_REACH WITH T
REPLACE PUB_SURF WITH T
REPLACE SELF_REG WITH F
REPLACE TIMER WITH F
REPLACE OUT_ROUTE WITH T
REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "HELP should render from reflected structures where available, then fall back to legacy help catalog sources."

APPEND
REPLACE CMD_ID WITH "CMD_CHK"
REPLACE CAN_NAME WITH "CMDHELPCHK"
REPLACE DISP_NAME WITH "CMDHELPCHK"
REPLACE ENTRY_KIND WITH "command"
REPLACE IMPL_STAT WITH "partial"
REPLACE VIS_TIER WITH "dev"
REPLACE OWNER WITH "help_validator"
REPLACE REG_RING WITH "help_meta"
REPLACE LIFE_PH WITH "diagnostics"
