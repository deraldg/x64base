REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "SET ORDER is a routed SET subcommand. It should not be flattened into an independent command in the semantic catalog."

APPEND
REPLACE SUB_ID WITH "SUB_REL_ENUM"
REPLACE PARENT WITH "REL"
REPLACE SUB_NAME WITH "ENUM"
REPLACE QUAL_NAME WITH "REL ENUM"
REPLACE DISP_STYL WITH "routed"
REPLACE IMPL_STAT WITH "implemented"
REPLACE VIS_TIER WITH "core"
REPLACE OWNER WITH "tuple_engine"
REPLACE REG_RING WITH "relations"
