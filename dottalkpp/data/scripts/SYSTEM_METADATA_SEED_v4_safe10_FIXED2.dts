REPLACE MSG_CAT WITH F
REPLACE ACTIVE WITH T
REPLACE VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "SET PATH is a routed SET subcommand. Re-expressions such as SETPATH should normalize to this qualified canonical target."

APPEND
REPLACE SUB_ID WITH "SUB_SET_ORDER"
REPLACE PARENT WITH "SET"
REPLACE SUB_NAME WITH "ORDER"
REPLACE QUAL_NAME WITH "SET ORDER"
REPLACE DISP_STYL WITH "routed"
REPLACE IMPL_STAT WITH "implemented"
REPLACE VIS_TIER WITH "core"
REPLACE OWNER WITH "order_state"
REPLACE REG_RING WITH "index_order"
REPLACE LIFE_PH WITH "session"
REPLACE SRC_AUTH WITH "router"
