* sqlsel_select_v1_regression.dts
* ============================================================================
* AIF-074 P3 slice 1 -- SQLSEL SELECT ... FROM, oracle-gated (gate G3)
*
* Status: CANDIDATE / explicit-run
* Safety: MUTATING (SANDBOX only: throwaway SQLSTU; erased at the end)
* Proves:
*   S1  SELECT <cols> FROM <table>            -- the corpus form, finally real
*   S2  SELECT * FROM <table>
*   S3  WHERE predicate filters
*   S4  LIMIT caps AND says so (honesty, P1.3 pattern)
*   S5  cursor neutrality: recno before == recno after (R16b)
*   S6  typed expression projection plus corrective errors
*   S7  legacy path preserved: SQLSEL USAGE still works
*   S13 tuple-evaluator migration: function predicate and fail-closed errors
*   S14 single-table alias + qualified projection/WHERE/ORDER BY
*   ORACLE  the same queries over the same data in SQLite, for row comparison
* Read rule: REGRESSION SQLSEL_SELECT_V1 machine-compares every marked SQLSEL
*   row set with its paired SQLite oracle, requires all three cursor guards,
*   all seven corrective refusals, both LIMIT reports, and all four sort-path
*   reports. Missing or empty evidence fails closed. Direct DOTSCRIPT execution
*   still prints the same evidence but does not invoke the REGRESSION validator.
* ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-G3-BEGIN"

ERASE TABLE SQLSTU CONFIRM

CREATE X64 SQLSTU (SID N(6,0), LNAME C(12), MAJOR C(4))
APPEND
REPLACE SID WITH "1"
REPLACE LNAME WITH "ADAMS"
REPLACE MAJOR WITH "CSCI"
APPEND
REPLACE SID WITH "2"
REPLACE LNAME WITH "BAKER"
REPLACE MAJOR WITH "MATH"
APPEND
REPLACE SID WITH "3"
REPLACE LNAME WITH "CARTER"
REPLACE MAJOR WITH "CSCI"
CLOSE

SELECT 1
USE SQLSTU

* --- park the cursor on record 2; S5 asserts statements do not move it ---
* Position is asserted through DATA (record 2 is BAKER): RECNO is a command,
* not an expression function, so a RECNO() marker would fail silently.
GO 2
? "S5A_cursor_parked_before:" + (ALLTRIM(LNAME) = "BAKER")

* --- S1: the corpus form ---
FORMULA "SQLSEL-S1-BEGIN"
SQLSEL SELECT SID,LNAME,MAJOR FROM SQLSTU
FORMULA "SQLSEL-S1-END"

* --- S2: star projection ---
FORMULA "SQLSEL-S2-BEGIN"
SQLSEL SELECT * FROM SQLSTU
FORMULA "SQLSEL-S2-END"

* --- S3: WHERE ---
FORMULA "SQLSEL-S3-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU WHERE MAJOR = "CSCI"
FORMULA "SQLSEL-S3-END"

* --- S4: LIMIT caps and reports ---
FORMULA "SQLSEL-S4-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU LIMIT 2
FORMULA "SQLSEL-S4-END"

* --- S5: cursor neutrality after all of the above ---
? "S5B_cursor_unmoved_after:" + (ALLTRIM(LNAME) = "BAKER")

* --- S6: typed expression projection, then corrective errors ---
FORMULA "SQLSEL-S6-BEGIN"
SQLSEL SELECT SID FROM NOSUCHTABLE
FORMULA "SQLSEL-S6Q-BEGIN"
SQLSEL SELECT ALLTRIM(LNAME) AS TRIMMED FROM SQLSTU
FORMULA "SQLSEL-S6Q-END"
SQLSEL SELECT SID,LNAME FROM SQLSTU LIMIT abc
FORMULA "SQLSEL-S6-END"

* --- S8 (slice 2): ORDER BY, both directions; sort is by VALUE not scan order ---
* Fixture insert order is ADAMS, BAKER, CARTER (SID 1,2,3).
* ORDER BY LNAME DESC must yield CARTER, BAKER, ADAMS.
FORMULA "SQLSEL-S8-BEGIN"
FORMULA "SQLSEL-S8A-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU ORDER BY LNAME
FORMULA "SQLSEL-S8A-END"
FORMULA "SQLSEL-S8D-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU ORDER BY LNAME DESC
FORMULA "SQLSEL-S8D-END"
FORMULA "SQLSEL-S8-END"

* --- S9: ORDER BY + LIMIT -- LIMIT must cut the SORTED set, not the scan ---
* Expect CARTER then BAKER (the two highest), NOT ADAMS/BAKER (first two scanned).
FORMULA "SQLSEL-S9-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU ORDER BY LNAME DESC LIMIT 2
FORMULA "SQLSEL-S9-END"

* --- S10: COUNT(*), with and without WHERE ---
FORMULA "SQLSEL-S10-BEGIN"
FORMULA "SQLSEL-S10A-BEGIN"
SQLSEL SELECT COUNT(*) FROM SQLSTU
FORMULA "SQLSEL-S10A-END"
FORMULA "SQLSEL-S10F-BEGIN"
SQLSEL SELECT COUNT(*) FROM SQLSTU WHERE MAJOR = "CSCI"
FORMULA "SQLSEL-S10F-END"
FORMULA "SQLSEL-S10-END"

* --- S11: slice-2 corrective errors ---
FORMULA "SQLSEL-S11-BEGIN"
SQLSEL SELECT SID FROM SQLSTU ORDER BY NOSUCHFIELD
SQLSEL SELECT SID FROM SQLSTU ORDER BY LNAME SIDEWAYS
SQLSEL SELECT COUNT(*) FROM SQLSTU ORDER BY LNAME
FORMULA "SQLSEL-S11-END"

* --- S12: cursor still unmoved after ORDER BY/COUNT work ---
? "S12_cursor_unmoved_after_slice2:" + (ALLTRIM(LNAME) = "BAKER")

* --- S13 (P4.0b): SQLSEL WHERE uses the repaired TupleRow evaluator ---
FORMULA "SQLSEL-S13-BEGIN"
FORMULA "SQLSEL-S13Q-BEGIN"
SQLSEL SELECT SID,LNAME FROM SQLSTU WHERE ALLTRIM(MAJOR) = "CSCI"
FORMULA "SQLSEL-S13Q-END"
SQLSEL SELECT SID FROM SQLSTU WHERE NOSUCH = "X"
SQLSEL SELECT SID FROM SQLSTU WHERE SID = "NOTNUM"
FORMULA "SQLSEL-S13-END"

FORMULA "SQLSEL-S14-BEGIN"
SQLSEL S.SID,S.LNAME FROM SQLSTU AS S WHERE S.MAJOR = 'CSCI' ORDER BY S.LNAME
FORMULA "SQLSEL-S14-END"

* --- S7: legacy path preserved ---
FORMULA "SQLSEL-S7-BEGIN"
SQLSEL USAGE
FORMULA "SQLSEL-S7-END"

* --- ORACLE: same data, real SQL ---
FORMULA "SQLSEL-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLSTU (SID INTEGER, LNAME TEXT, MAJOR TEXT);
SQLITE EXEC INSERT INTO SQLSTU VALUES (1,'ADAMS','CSCI');
SQLITE EXEC INSERT INTO SQLSTU VALUES (2,'BAKER','MATH');
SQLITE EXEC INSERT INTO SQLSTU VALUES (3,'CARTER','CSCI');
FORMULA "SQLSEL-O1-BEGIN"
SQLITE SELECT SELECT SID, LNAME, MAJOR FROM SQLSTU ORDER BY SID;
FORMULA "SQLSEL-O1-END"
FORMULA "SQLSEL-O2-BEGIN"
SQLITE SELECT SELECT SID, LNAME, MAJOR FROM SQLSTU ORDER BY SID;
FORMULA "SQLSEL-O2-END"
FORMULA "SQLSEL-O3-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU WHERE MAJOR = 'CSCI' ORDER BY SID;
FORMULA "SQLSEL-O3-END"
FORMULA "SQLSEL-O4-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU ORDER BY SID LIMIT 2;
FORMULA "SQLSEL-O4-END"
FORMULA "SQLSEL-O6-BEGIN"
SQLITE SELECT SELECT TRIM(LNAME) FROM SQLSTU ORDER BY SID;
FORMULA "SQLSEL-O6-END"
FORMULA "SQLSEL-O8A-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU ORDER BY LNAME ASC;
FORMULA "SQLSEL-O8A-END"
FORMULA "SQLSEL-O8D-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU ORDER BY LNAME DESC;
FORMULA "SQLSEL-O8D-END"
FORMULA "SQLSEL-O9-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU ORDER BY LNAME DESC LIMIT 2;
FORMULA "SQLSEL-O9-END"
FORMULA "SQLSEL-O10A-BEGIN"
SQLITE SELECT SELECT COUNT(*) AS TOTAL_ROWS FROM SQLSTU;
FORMULA "SQLSEL-O10A-END"
FORMULA "SQLSEL-O10F-BEGIN"
SQLITE SELECT SELECT COUNT(*) AS CSCI_ROWS FROM SQLSTU WHERE MAJOR = 'CSCI';
FORMULA "SQLSEL-O10F-END"
FORMULA "SQLSEL-O13-BEGIN"
SQLITE SELECT SELECT SID, LNAME FROM SQLSTU WHERE TRIM(MAJOR) = 'CSCI' ORDER BY SID;
FORMULA "SQLSEL-O13-END"
FORMULA "SQLSEL-O14-BEGIN"
SQLITE SELECT SELECT S.SID, S.LNAME FROM SQLSTU AS S WHERE S.MAJOR = 'CSCI' ORDER BY S.LNAME;
FORMULA "SQLSEL-O14-END"
SQLITE CLOSE
FORMULA "SQLSEL-ORACLE-END"

* --- cleanup ---
CLOSE
ERASE TABLE SQLSTU CONFIRM

FORMULA "SQLSEL-G3-END"
