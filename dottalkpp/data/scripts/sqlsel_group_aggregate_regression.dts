; ============================================================================
; AIF-074 P4.6 -- SQLsel GROUP BY, HAVING, and typed aggregates
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; two fixtures self-erase)
;
; Proves:
;   GA1 COUNT(*), COUNT(column), SUM, AVG, MIN, and MAX.
;   GA2 GROUP BY partitions typed TupleRows; aggregate/group aliases survive
;       typing and may drive ORDER BY; HAVING filters group rows.
;   GA3 WHERE filters source rows before grouping; ORDER BY follows HAVING.
;   GA4 numeric DBF blanks are skipped, never invented as zero, and reported.
;   GA5 MIN/MAX retain date typing and compare canonical date values.
;   GA6 aggregation consumes joined TupleRows as well as one-table rows.
;   GA7 deleted rows stay excluded and both source cursors are restored.
;   ORACLE seven marked SQLsel row sets equal SQLite with blanks mapped to NULL.
;
; Read rule: REGRESSION SQLSEL_AGGREGATES must print
;   SQLSEL AGGREGATE ORACLE: PASS.
; The validator fails closed on missing/empty blocks, row mismatch, missing
; R28 blank reports, cursor drift, or changed corrective refusals.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-GA-BEGIN"

ERASE TABLE SQLAGG CONFIRM
ERASE TABLE SQLDEPT CONFIRM

CREATE X64 SQLAGG (DEPT C(8), SALARY N(9,2), SCORE N(6,0), HIRED D)
APPEND
REPLACE DEPT WITH "ENG"
REPLACE SALARY WITH "100.00"
REPLACE SCORE WITH "1"
REPLACE HIRED WITH "20240101"
APPEND
REPLACE DEPT WITH "ENG"
REPLACE SALARY WITH "200.00"
REPLACE SCORE WITH "2"
REPLACE HIRED WITH "20240102"
APPEND
REPLACE DEPT WITH "ENG"
REPLACE SCORE WITH "3"
REPLACE HIRED WITH "20240103"
APPEND
REPLACE DEPT WITH "HR"
REPLACE SALARY WITH "50.00"
REPLACE SCORE WITH "4"
REPLACE HIRED WITH "20240201"
APPEND
REPLACE DEPT WITH "HR"
REPLACE SCORE WITH "5"
REPLACE HIRED WITH "20240202"
APPEND
REPLACE DEPT WITH "OPS"
REPLACE SCORE WITH "6"
REPLACE HIRED WITH "20240301"
APPEND
REPLACE DEPT WITH "ENG"
REPLACE SALARY WITH "999.00"
REPLACE SCORE WITH "99"
REPLACE HIRED WITH "20241231"
DELETE
CLOSE

CREATE X64 SQLDEPT (DEPT C(8), LABEL C(16))
APPEND
REPLACE DEPT WITH "ENG"
REPLACE LABEL WITH "ENGINEERING"
APPEND
REPLACE DEPT WITH "HR"
REPLACE LABEL WITH "PEOPLE"
APPEND
REPLACE DEPT WITH "OPS"
REPLACE LABEL WITH "OPERATIONS"
APPEND
REPLACE DEPT WITH "SALES"
REPLACE LABEL WITH "DELETED"
DELETE
CLOSE

SELECT 1
USE SQLAGG
GO 2
SELECT 2
USE SQLDEPT
GO 3

FORMULA "SQLSEL-GA-GLOBAL-BEGIN"
SQLSEL SELECT COUNT(*),COUNT(SALARY),SUM(SALARY),AVG(SALARY),MIN(SALARY),MAX(SALARY) FROM SQLAGG
FORMULA "SQLSEL-GA-GLOBAL-END"

FORMULA "SQLSEL-GA-GROUPED-BEGIN"
SQLSEL SELECT DEPT AS DEPARTMENT,COUNT(*) AS ROWS,COUNT(SALARY) AS PAID,SUM(SALARY) AS TOTAL_PAY,AVG(SALARY) AS MEAN_PAY,MIN(SALARY) AS LOW_PAY,MAX(SALARY) AS HIGH_PAY FROM SQLAGG GROUP BY DEPT ORDER BY DEPARTMENT
FORMULA "SQLSEL-GA-GROUPED-END"

FORMULA "SQLSEL-GA-HAVING-COUNT-BEGIN"
SQLSEL SELECT DEPT,COUNT(*) FROM SQLAGG GROUP BY DEPT HAVING COUNT(*) >= 2 ORDER BY DEPT
FORMULA "SQLSEL-GA-HAVING-COUNT-END"

FORMULA "SQLSEL-GA-HAVING-AVG-BEGIN"
SQLSEL SELECT DEPT,AVG(SALARY) FROM SQLAGG GROUP BY DEPT HAVING AVG(SALARY) >= 100 ORDER BY DEPT
FORMULA "SQLSEL-GA-HAVING-AVG-END"

FORMULA "SQLSEL-GA-WHERE-BEGIN"
SQLSEL SELECT DEPT,COUNT(SALARY),SUM(SALARY) FROM SQLAGG WHERE SCORE >= 2 GROUP BY DEPT HAVING COUNT(*) >= 1 ORDER BY DEPT
FORMULA "SQLSEL-GA-WHERE-END"

FORMULA "SQLSEL-GA-DATE-BEGIN"
SQLSEL SELECT MIN(HIRED),MAX(HIRED) FROM SQLAGG
FORMULA "SQLSEL-GA-DATE-END"

FORMULA "SQLSEL-GA-JOIN-BEGIN"
SQLSEL SELECT D.LABEL,COUNT(*),AVG(A.SALARY) FROM SQLAGG A JOIN SQLDEPT D ON A.DEPT = D.DEPT GROUP BY D.LABEL ORDER BY D.LABEL
FORMULA "SQLSEL-GA-JOIN-END"

SELECT 1
? "GA_C1_fact_cursor_restored:" + (DEPT = "ENG" AND SCORE = 2)
SELECT 2
? "GA_C2_dimension_cursor_restored:" + (DEPT = "OPS" AND ALLTRIM(LABEL) = "OPERATIONS")

FORMULA "SQLSEL-GA-REFUSALS-BEGIN"
SQLSEL SELECT SUM(DEPT) FROM SQLAGG
SQLSEL SELECT DEPT,SCORE,COUNT(*) FROM SQLAGG GROUP BY DEPT
SQLSEL SELECT DEPT,COUNT(*) FROM SQLAGG GROUP BY NOSUCH
SQLSEL SELECT SUM(SALARY+1) FROM SQLAGG
SQLSEL SELECT AVG(*) FROM SQLAGG
FORMULA "SQLSEL-GA-REFUSALS-END"

FORMULA "SQLSEL-GA-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLAGG (DEPT TEXT, SALARY REAL, SCORE INTEGER, HIRED TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLDEPT (DEPT TEXT, LABEL TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLAGG VALUES ('ENG',100.00,1,'20240101',0),('ENG',200.00,2,'20240102',0),('ENG',NULL,3,'20240103',0),('HR',50.00,4,'20240201',0),('HR',NULL,5,'20240202',0),('OPS',NULL,6,'20240301',0),('ENG',999.00,99,'20241231',1);
SQLITE EXEC INSERT INTO SQLDEPT VALUES ('ENG','ENGINEERING',0),('HR','PEOPLE',0),('OPS','OPERATIONS',0),('SALES','DELETED',1);

FORMULA "SQLSEL-GA-O1-BEGIN"
SQLITE SELECT SELECT COUNT(*),COUNT(SALARY),printf('%.2f',SUM(SALARY)),printf('%.2f',AVG(SALARY)),printf('%.2f',MIN(SALARY)),printf('%.2f',MAX(SALARY)) FROM SQLAGG WHERE D=0;
FORMULA "SQLSEL-GA-O1-END"

FORMULA "SQLSEL-GA-O2-BEGIN"
SQLITE SELECT SELECT DEPT,COUNT(*),COUNT(SALARY),CASE WHEN COUNT(SALARY)=0 THEN '' ELSE printf('%.2f',SUM(SALARY)) END,CASE WHEN COUNT(SALARY)=0 THEN '' ELSE printf('%.2f',AVG(SALARY)) END,CASE WHEN COUNT(SALARY)=0 THEN '' ELSE printf('%.2f',MIN(SALARY)) END,CASE WHEN COUNT(SALARY)=0 THEN '' ELSE printf('%.2f',MAX(SALARY)) END FROM SQLAGG WHERE D=0 GROUP BY DEPT ORDER BY DEPT;
FORMULA "SQLSEL-GA-O2-END"

FORMULA "SQLSEL-GA-O3-BEGIN"
SQLITE SELECT SELECT DEPT,COUNT(*) FROM SQLAGG WHERE D=0 GROUP BY DEPT HAVING COUNT(*)>=2 ORDER BY DEPT;
FORMULA "SQLSEL-GA-O3-END"

FORMULA "SQLSEL-GA-O4-BEGIN"
SQLITE SELECT SELECT DEPT,printf('%.2f',AVG(SALARY)) FROM SQLAGG WHERE D=0 GROUP BY DEPT HAVING AVG(SALARY)>=100 ORDER BY DEPT;
FORMULA "SQLSEL-GA-O4-END"

FORMULA "SQLSEL-GA-O5-BEGIN"
SQLITE SELECT SELECT DEPT,COUNT(SALARY),CASE WHEN COUNT(SALARY)=0 THEN '' ELSE printf('%.2f',SUM(SALARY)) END FROM SQLAGG WHERE D=0 AND SCORE>=2 GROUP BY DEPT HAVING COUNT(*)>=1 ORDER BY DEPT;
FORMULA "SQLSEL-GA-O5-END"

FORMULA "SQLSEL-GA-O6-BEGIN"
SQLITE SELECT SELECT MIN(HIRED),MAX(HIRED) FROM SQLAGG WHERE D=0;
FORMULA "SQLSEL-GA-O6-END"

FORMULA "SQLSEL-GA-O7-BEGIN"
SQLITE SELECT SELECT D.LABEL,COUNT(*),CASE WHEN COUNT(A.SALARY)=0 THEN '' ELSE printf('%.2f',AVG(A.SALARY)) END FROM SQLAGG A JOIN SQLDEPT D ON A.DEPT=D.DEPT AND D.D=0 WHERE A.D=0 GROUP BY D.LABEL ORDER BY D.LABEL;
FORMULA "SQLSEL-GA-O7-END"

SQLITE CLOSE
FORMULA "SQLSEL-GA-ORACLE-END"

CLOSE ALL
ERASE TABLE SQLAGG CONFIRM
ERASE TABLE SQLDEPT CONFIRM

FORMULA "SQLSEL-GA-END"
