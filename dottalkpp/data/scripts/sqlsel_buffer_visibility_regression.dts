SET ECHO OFF
STOP_ON_ERROR OFF
SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-BUFVIS-BEGIN"
ERASE TABLE SQLBUFVIS CONFIRM
CREATE X64 SQLBUFVIS (SID N(6,0), MAJOR C(4))
APPEND
REPLACE SID WITH "1"
REPLACE MAJOR WITH "CSCI"
APPEND
REPLACE SID WITH "2"
REPLACE MAJOR WITH "MATH"
CLOSE

SELECT 1
USE SQLBUFVIS
TABLE BUFFER ON
GO 1
REPLACE MAJOR WITH "MATH"

FORMULA "SQLSEL-BUFVIS-TUPLE-PREVIEW"
TUPLE SQLBUFVIS.SID,SQLBUFVIS.MAJOR

FORMULA "SQLSEL-BUFVIS-COMMITTED-SELECT"
SQLSEL SELECT SID,MAJOR FROM SQLBUFVIS WHERE MAJOR = "CSCI"
SQLSEL SELECT SID,MAJOR FROM SQLBUFVIS WHERE MAJOR = "MATH"
SQLSEL SELECT COUNT(*) FROM SQLBUFVIS WHERE MAJOR = "MATH"

ROLLBACK
TABLE BUFFER OFF
CLOSE
ERASE TABLE SQLBUFVIS CONFIRM
FORMULA "SQLSEL-BUFVIS-END"
