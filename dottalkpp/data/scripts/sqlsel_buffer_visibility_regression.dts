; ============================================================================
; AIF-074 -- SQLsel committed truth vs TUPLE buffer preview
;
; Status: PROMOTED / default suite (2026-09-03)
; Safety: MUTATING (SANDBOX only; fixture self-erases)
;
; Proves:
;   BV1 TUPLE sees the dirty current-row buffer.
;   BV2 SQLsel ignores that preview and reads committed table truth.
;   BV3 ROLLBACK preserves the original committed rows.
;   BV4 COMMIT moves the edit into SQLsel's committed truth.
;   BV5 SQLsel restores the source cursor in all three states.
;   ORACLE five marked SQLsel row sets equal SQLite.
;
; Read rule: REGRESSION SQLSEL_BUFFER_VIS must print
;   SQLSEL BUFFER ORACLE: PASS.
; Missing markers, empty output, a dirty preview mismatch, cursor drift, or a
; row mismatch fails closed. A direct DOTSCRIPT run prints evidence but does
; not invoke the validator.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-BV-BEGIN"

ERASE TABLE SQLBUFVIS CONFIRM
CREATE X64 SQLBUFVIS (SID N(6,0), MAJOR C(4))
APPEND
REPLACE SID WITH "1"
REPLACE MAJOR WITH "CSCI"
APPEND
REPLACE SID WITH "2"
REPLACE MAJOR WITH "MATH"
CLOSE

SELECT 1
USE SQLBUFVIS
TABLE BUFFER ON
GO 1
REPLACE MAJOR WITH "MATH"

FORMULA "SQLSEL-BV-DIRTY-TUPLE-BEGIN"
TUPLE SQLBUFVIS.SID,SQLBUFVIS.MAJOR
FORMULA "SQLSEL-BV-DIRTY-TUPLE-END"

FORMULA "SQLSEL-BV-S1-BEGIN"
SQLSEL SID,MAJOR FROM SQLBUFVIS ORDER BY SID
FORMULA "SQLSEL-BV-S1-END"

FORMULA "SQLSEL-BV-S2-BEGIN"
SQLSEL COUNT(*) FROM SQLBUFVIS WHERE MAJOR = "MATH"
FORMULA "SQLSEL-BV-S2-END"

? "BV_C1_dirty_query_cursor_restored:" + (SID = 1)

; Re-read through the ONLY preview authority. A field marker reads committed
; values and cannot prove that the table-buffer overlay survived SQLsel.
FORMULA "SQLSEL-BV-DIRTY-TUPLE-AFTER-BEGIN"
TUPLE SQLBUFVIS.SID,SQLBUFVIS.MAJOR
FORMULA "SQLSEL-BV-DIRTY-TUPLE-AFTER-END"

ROLLBACK

FORMULA "SQLSEL-BV-S3-BEGIN"
SQLSEL SID,MAJOR FROM SQLBUFVIS ORDER BY SID
FORMULA "SQLSEL-BV-S3-END"

? "BV_C2_rollback_query_cursor_restored:" + (SID = 1 AND ALLTRIM(MAJOR) = "CSCI")

REPLACE MAJOR WITH "MATH"
COMMIT

FORMULA "SQLSEL-BV-S4-BEGIN"
SQLSEL SID,MAJOR FROM SQLBUFVIS ORDER BY SID
FORMULA "SQLSEL-BV-S4-END"

FORMULA "SQLSEL-BV-S5-BEGIN"
SQLSEL COUNT(*) FROM SQLBUFVIS WHERE MAJOR = "MATH"
FORMULA "SQLSEL-BV-S5-END"

? "BV_C3_commit_query_cursor_restored:" + (SID = 1 AND ALLTRIM(MAJOR) = "MATH")

FORMULA "SQLSEL-BV-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLBUFVIS (SID INTEGER, MAJOR TEXT);
SQLITE EXEC INSERT INTO SQLBUFVIS VALUES (1,'CSCI'),(2,'MATH');

FORMULA "SQLSEL-BV-O1-BEGIN"
SQLITE SELECT SELECT SID,MAJOR FROM SQLBUFVIS ORDER BY SID;
FORMULA "SQLSEL-BV-O1-END"

FORMULA "SQLSEL-BV-O2-BEGIN"
SQLITE SELECT SELECT COUNT(*) AS MATCHES FROM SQLBUFVIS WHERE MAJOR='MATH';
FORMULA "SQLSEL-BV-O2-END"

FORMULA "SQLSEL-BV-O3-BEGIN"
SQLITE SELECT SELECT SID,MAJOR FROM SQLBUFVIS ORDER BY SID;
FORMULA "SQLSEL-BV-O3-END"

SQLITE EXEC UPDATE SQLBUFVIS SET MAJOR='MATH' WHERE SID=1;

FORMULA "SQLSEL-BV-O4-BEGIN"
SQLITE SELECT SELECT SID,MAJOR FROM SQLBUFVIS ORDER BY SID;
FORMULA "SQLSEL-BV-O4-END"

FORMULA "SQLSEL-BV-O5-BEGIN"
SQLITE SELECT SELECT COUNT(*) AS MATCHES FROM SQLBUFVIS WHERE MAJOR='MATH';
FORMULA "SQLSEL-BV-O5-END"

SQLITE CLOSE
FORMULA "SQLSEL-BV-ORACLE-END"

TABLE BUFFER OFF
CLOSE
ERASE TABLE SQLBUFVIS CONFIRM

FORMULA "SQLSEL-BV-END"
