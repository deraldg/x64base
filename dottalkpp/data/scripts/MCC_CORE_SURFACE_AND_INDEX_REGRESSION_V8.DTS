* ============================================================
* MCC_CORE_SURFACE_AND_INDEX_REGRESSION_V8.DTS
*
* Purpose:
*   Stable split regression for:
*     1) core surface / non-LMDB behavior on v32 DBF
*     2) LMDB/CDX indexed behavior on v64 XDBF
*
* Rule:
*   Do NOT mix v32 and v64 indexed rebuild/attach work in the same phase.
* ============================================================

SET ECHO OFF
COLOR DEFAULT
ECHO ===== V8 START =====

* ------------------------------------------------------------
* PHASE 0 - INIT / SANITY
* ------------------------------------------------------------
ECHO ===== PHASE 0 INIT =====
INIT
VERSION
STATUS
WSREPORT

* ------------------------------------------------------------
* PHASE 1 - CORE SURFACE (v32 only, no CDX/LMDB attach)
* ------------------------------------------------------------
ECHO ===== PHASE 1 CORE SURFACE V32 =====
SCHEMAS CLOSE
REL CLEAR ALL
SETPATH DBF DBF/X32
SETPATH INDEXES INDEXES/32
SCHEMAS OPEN DBF/X32

SELECT BUILDING
COUNT
LIST 3
DISPLAY
TOP
SKIP 1
BOTTOM
TOP

SELECT ROOMS
COUNT
LIST 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT DEPT
COUNT
LIST 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT MAJORS
COUNT
LIST 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT TERMS
COUNT
LIST ALL
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT COURSES
COUNT
LIST 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT TEACHERS
COUNT
LIST 3
TUPLE *
LOCATE LNAME = "Wilson"
TUPLE *
TOP

SELECT CLASSES
COUNT
LIST 3
TUPLE *
TOP
SKIP 1
BOTTOM
TOP

SELECT STUDENTS
COUNT
LIST 3
TUPLE *
TOP
RECNO

ECHO ===== PHASE 1 FILTER / LOCATE / COUNT =====
SET FILTER TO
COUNT
COUNT DELETED
COUNT NOT DELETED
COUNT !DELETED
COUNT FOR LNAME = "ANDERSON"
COUNT WHERE GPA > 3.5
COUNT GPA > 3.5

SET FILTER TO FNAME = "AVA"
COUNT
COUNT FOR GPA > 2.5
COUNT FOR LNAME = "WHITE"
TOP
LIST 10
SET FILTER TO

LOCATE LNAME = "ANDERSON"
TUP
CONTINUE
TUP
CONTINUE
TUP
TOP

ECHO ===== PHASE 1 BOOLEAN / SMARTLIST =====
LOCATE LNAME = "Taylor"
LIST 1
BOOLEAN (GPA > 3)
BOOLEAN (GPA < 3)
BOOLEAN (GPA >= 2 AND GPA <= 4)
SMARTLIST 5 FOR GPA >= 3.5
RECNO

ECHO ===== PHASE 1 AGGREGATES =====
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA

SET FILTER TO FNAME = "AVA"
COUNT
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA
SET FILTER TO

ECHO ===== PHASE 1 DATE/TIME =====
DATE
TODAY
TIME
NOW
DATETIME
CALC DATE()
CALC TODAY()
CALC TIME()
CALC NOW()
CALC DATETIME()
CALC (DATE() = TODAY())
CALC (NOW() = DATETIME())
CALC DATE() + 2
CALC DATE() - 2
CTOD 2000-01-01
CTOD "2000-01-01"
CTOD "2000/01/01"
CTOD 20000101
CALC CTOD("2000-01-01")
CALC DTOC(CTOD("2000-01-01"))
DATEADD 20000101, 30
DATEADD 20000101, -30
DATEDIFF 20000101, 20000103
CALC DATEADD(DATE(), 30)
CALC DATEDIFF(CTOD("2000-01-01"), DATE())

ECHO ===== PHASE 1 TABLE BUFFER =====
SELECT STUDENTS
LOCATE LNAME = "Taylor"
TABLE ON
REPLACE FNAME WITH "DeraldNew"
TUPLE *
LIST 1
COMMIT
LIST 1
REPLACE FNAME WITH "Derald"
COMMIT
TABLE OFF
LIST 1

ECHO ===== PHASE 1 CALCWRITE =====
SELECT STUDENTS
LOCATE LNAME = "Taylor"
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
LIST 1
CALC GPA = GPA - 0.01
COMMIT
LIST 1
TABLE OFF

ECHO ===== PHASE 1 RELATIONS =====
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL LIST
REL REFRESH
REL_LIST
REL_REFRESH

ECHO ===== PHASE 1 SQLITE =====
SQLITE VERSION
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, n INTEGER);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('alpha', 10);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('bravo', 20);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('charlie', 30);
SQLITE SELECT SELECT id, name, n FROM t ORDER BY id;
SQLITE CLOSE

ECHO ===== PHASE 1 DOTSCRIPT / BLOCKS =====
! echo SET ECHO ON>tmp/mini_regression_v8.dts
! echo ECHO MINI_DOTSCRIPT_V8_OK>>tmp/mini_regression_v8.dts
DOTSCRIPT tmp/mini_regression_v8.dts
SET ECHO OFF
GO TOP

IF .F.
    ECHO IF_BRANCH_RAN_UNEXPECTED
ELSE
    ECHO ELSE_BRANCH_RAN_OK
ENDIF

WHILE .F.
    ECHO WHILE_BODY_RAN_UNEXPECTED
ENDWHILE

UNTIL .T.
    ECHO UNTIL_BODY_RAN_UNEXPECTED
ENDUNTIL

SELECT BUILDING
TOP
SCAN
    TUPLE *
ENDSCAN

ECHO ===== PHASE 1 TUPTALK =====
SELECT STUDENTS
TUPTALK RESET
TUPTALK PUSH ALL
TUPTALK PUSH FILTER CND
TUPTALK PUSH 3
TUPTALK PUSH ROW
TUPTALK LIST
TUPTALK NORMALIZE
TUPTALK EXPORT CSV students_norm_v8.csv
TUPTALK EXPORT TSV students_norm_v8.tsv

SCHEMAS CLOSE
REL CLEAR ALL

* ------------------------------------------------------------
* PHASE 2 - INDEX / LMDB / CDX (v64 only)
* ------------------------------------------------------------
ECHO ===== PHASE 2 INDEXED V64 =====
SETPATH DBF DBF/X64
SETPATH INDEXES INDEXES/X64
* -- LMDB never changes -- *
USE STUDENTS
AREA
STATUS

ECHO ===== PHASE 2 ATTACH / ORDER =====
SET INDEX TO STUDENTS
SET ORDER TO TAG LNAME
AREA
STATUS
TOP
SMARTLIST 10
DISPLAY
TUP

SET ORDER TO TAG DOB
AREA
LIST 20

ECHO ===== PHASE 2 SEEK / LOCATE UNDER ORDER =====
SET ORDER TO TAG LNAME
TOP
LOCATE LNAME = "ANDERSON"
TUP
CONTINUE
TUP
CONTINUE
TUP

ECHO ===== PHASE 2 REPORTING =====
DBAREA
STATUS
WSREPORT
WSREPORT ALL VERBOSE
SHOW TABLE
SHOW COLUMNS
SHOW INDEX
FIELDS
DISPLAY
TUP

ECHO ===== PHASE 2 KNOWN-SAFE REBUILD (V64 ONLY) =====
BUILDLMDB YES

ECHO ===== PHASE 2 POST-REBUILD VERIFY =====
SET INDEX TO STUDENTS
SET ORDER TO TAG LNAME
TOP
SMARTLIST 10
STATUS
AREA

CLOSE
SCHEMAS CLOSE
REL CLEAR ALL

* ------------------------------------------------------------
* PHASE 3 - KNOWN OBSERVATIONS
* ------------------------------------------------------------
ECHO ===== PHASE 3 KNOWN OBSERVATIONS =====
CALC ((DATE() + 2) > DATE())
CALC ((DATE() - 2) < DATE())
CALC (CTOD("2000-01-01") + 1 = CTOD("2000-01-02"))
CALC (CTOD("2000-01-01") - 1 = CTOD("1999-12-31"))
SELECT BUILDING
CALC (DATEDIFF(DATE(), DATE()) = 0)

* ------------------------------------------------------------
* END
* ------------------------------------------------------------
ECHO ===== V8 END =====
QUIT