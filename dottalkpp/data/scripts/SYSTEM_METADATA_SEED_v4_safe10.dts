    SRC_FILE WITH "shell_commands.cpp", ;
    HANDLER WITH "cmd_HELP", ;
    HAS_HDLR WITH T, ;
    DISP_REACH WITH T, ;
    PUB_SURF WITH T, ;
    SELF_REG WITH F, ;
    TIMER WITH F, ;
    OUT_ROUTE WITH T, ;
    MSG_CAT WITH F, ;
    ACTIVE WITH T, ;
    VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "HELP should render from reflected structures where available, then fall back to legacy/help catalog sources."

APPEND
MULTIREP ;
    CMD_ID WITH "CMD_CHELPCHK", ;
    CAN_NAME WITH "CMDHELPCHK", ;
    DISP_NAME WITH "CMDHELPCHK", ;
    ENTRY_KIND WITH "command", ;
    IMPL_STAT WITH "partial", ;
    VIS_TIER WITH "dev", ;
    OWNER WITH "help_validator", ;
    REG_RING WITH "help_meta", ;
    LIFE_PH WITH "diagnostics", ;
    SRC_AUTH WITH "registry", ;
    SRC_HINT WITH "cmd", ;
