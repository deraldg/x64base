    HANDLER WITH "cmd_CMDHELPCHK", ;
    HAS_HDLR WITH T, ;
    DISP_REACH WITH T, ;
    PUB_SURF WITH T, ;
    SELF_REG WITH F, ;
    TIMER WITH F, ;
    OUT_ROUTE WITH T, ;
    MSG_CAT WITH F, ;
    ACTIVE WITH T, ;
    VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "CMDHELPCHK should evolve into the congruence validator across registry, ReferenceCollection, SYSTEM_* metadata, legacy help DBFs, functions, messages, and diagrams."

