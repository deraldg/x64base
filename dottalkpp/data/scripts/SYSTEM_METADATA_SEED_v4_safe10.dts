    ENTRY_KIND WITH "command", ;
    IMPL_STAT WITH "implemented", ;
    VIS_TIER WITH "core", ;
    OWNER WITH "relation_engine", ;
    REG_RING WITH "relations", ;
    LIFE_PH WITH "session", ;
    SRC_AUTH WITH "registry", ;
    SRC_HINT WITH "cmd", ;
    SRC_FILE WITH "shell_commands.cpp", ;
    HANDLER WITH "cmd_REL", ;
    HAS_HDLR WITH T, ;
    DISP_REACH WITH T, ;
    PUB_SURF WITH T, ;
    SELF_REG WITH F, ;
    TIMER WITH T, ;
    OUT_ROUTE WITH T, ;
    MSG_CAT WITH F, ;
    ACTIVE WITH T, ;
    VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "REL owns relation commands and relational enumeration surfaces. REL ENUM belongs under REL as a subcommand-level surface."

APPEND
MULTIREP ;
    CMD_ID WITH "CMD_HELP", ;
    CAN_NAME WITH "HELP", ;
    DISP_NAME WITH "HELP", ;
    ENTRY_KIND WITH "command", ;
    IMPL_STAT WITH "implemented", ;
    VIS_TIER WITH "core", ;
    OWNER WITH "help_system", ;
