* ============================================================
* SYSTEM_METADATA_SEED_v4_safe10.dts
*
* Purpose:
*   Seed the first truth rows into the x64 metadata catalog.
*
* Proof goals:
*   - Use safe <=10-character field tokens.
*   - Write real memo content into SYSTEM_HELP_TEXT and NOTES.
*   - Exercise CDX/LMDB lookup after seeded rows exist.
* ============================================================

SET ECHO OFF
SET PAGING OFF

DO metadata

* ------------------------------------------------------------
* Seed SYSTEM_COMMANDS
* ------------------------------------------------------------
USE SYSTEM_COMMANDS

APPEND
MULTIREP ;
    CMD_ID WITH "CMD_SET", ;
    CAN_NAME WITH "SET", ;
    DISP_NAME WITH "SET", ;
    ENTRY_KIND WITH "command", ;
    IMPL_STAT WITH "partial", ;
    VIS_TIER WITH "core", ;
    OWNER WITH "command_router", ;
    REG_RING WITH "core_settings", ;
    LIFE_PH WITH "session", ;
    SRC_AUTH WITH "registry", ;
    SRC_HINT WITH "cmd", ;
    SRC_FILE WITH "shell_commands.cpp", ;
    HANDLER WITH "cmd_SET", ;
    HAS_HDLR WITH T, ;
    DISP_REACH WITH T, ;
    PUB_SURF WITH T, ;
    SELF_REG WITH F, ;
    TIMER WITH T, ;
    OUT_ROUTE WITH T, ;
    MSG_CAT WITH F, ;
    ACTIVE WITH T, ;
    VER_AT WITH "2026-05-04"
REPLACE NOTES WITH "SET is a command family and router. SET PATH, SET INDEX, SET ORDER, and related forms should be modeled as subcommands or re-expressions, not as independent flat commands."

APPEND
MULTIREP ;
    CMD_ID WITH "CMD_REL", ;
    CAN_NAME WITH "REL", ;
