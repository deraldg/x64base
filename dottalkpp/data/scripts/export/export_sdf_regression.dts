* EXPORT SDF regression
* Explicit-run smoke; creates a throwaway table in SANDBOX and exports fixed-width rows.

SET ECHO OFF
STOP_ON_ERROR OFF
SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "EXPORT-SDF-BEGIN"

ERASE TABLE EXPSDF CONFIRM
CREATE X64 EXPSDF (CODE C(4), QTY N(3), PRICE N(6,2), FLAG L)
APPEND
REPLACE CODE WITH "AB"
REPLACE QTY WITH 7
REPLACE PRICE WITH 12.3
REPLACE FLAG WITH T
APPEND
REPLACE CODE WITH "WXYZ"
REPLACE QTY WITH 123
REPLACE PRICE WITH -4.5
REPLACE FLAG WITH F

EXPORT TO tmp\export_sdf_regression SDF
FORMULA "EXPORT_SDF_EXPECT_FILE:tmp/export_sdf_regression.sdf"
FORMULA "EXPORT_SDF_EXPECT_ROW1:AB    7  12.3T"
FORMULA "EXPORT_SDF_EXPECT_ROW2:WXYZ123  -4.5F"

CLOSE
ERASE TABLE EXPSDF CONFIRM

FORMULA "EXPORT-SDF-END"
