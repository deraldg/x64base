; ============================================================================
; AIF-074 P4.7 -- SQLsel scalar, IN, EXISTS, and correlated subqueries
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; three fixtures self-erase)
;
; Proves:
;   SQ1 uncorrelated IN, NOT IN, scalar, and scalar-aggregate subqueries.
;   SQ2 correlated EXISTS and NOT EXISTS over typed TupleRow scopes.
;   SQ3 double NOT EXISTS expresses relational division.
;   SQ4 uncorrelated results evaluate/cache once; correlated work reports cost.
;   SQ5 scalar cardinality and typed-family errors refuse explicitly.
;   SQ6 deleted rows stay excluded and all three cursors are restored.
;   ORACLE seven marked SQLsel row sets equal SQLite.
;
; Read rule: REGRESSION SQLSEL_SUBQUERIES must print
;   SQLSEL SUBQUERY ORACLE: PASS.
; Missing/empty blocks, row mismatch, evaluation-count drift, cursor drift, or
; changed corrective refusals fails closed.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-SQ-BEGIN"

ERASE TABLE SQLSQS CONFIRM
ERASE TABLE SQLSQE CONFIRM
ERASE TABLE SQLSQR CONFIRM

CREATE X64 SQLSQS (SID N(6,0), NAME C(12), MAJOR C(8))
APPEND
REPLACE SID WITH "1"
REPLACE NAME WITH "ALICE"
REPLACE MAJOR WITH "CSCI"
APPEND
REPLACE SID WITH "2"
REPLACE NAME WITH "BOB"
REPLACE MAJOR WITH "MATH"
APPEND
REPLACE SID WITH "3"
REPLACE NAME WITH "CARA"
REPLACE MAJOR WITH "CSCI"
APPEND
REPLACE SID WITH "4"
REPLACE NAME WITH "DAN"
REPLACE MAJOR WITH "HIST"
APPEND
REPLACE SID WITH "9"
REPLACE NAME WITH "DELETED"
DELETE
CLOSE

CREATE X64 SQLSQE (SID N(6,0), COURSE C(8))
APPEND
REPLACE SID WITH "1"
REPLACE COURSE WITH "DB"
APPEND
REPLACE SID WITH "1"
REPLACE COURSE WITH "OS"
APPEND
REPLACE SID WITH "2"
REPLACE COURSE WITH "ALG"
APPEND
REPLACE SID WITH "3"
REPLACE COURSE WITH "DB"
APPEND
REPLACE SID WITH "5"
REPLACE COURSE WITH "ORPH"
APPEND
REPLACE SID WITH "3"
REPLACE COURSE WITH "OS"
DELETE
CLOSE

CREATE X64 SQLSQR (COURSE C(8))
APPEND
REPLACE COURSE WITH "DB"
APPEND
REPLACE COURSE WITH "OS"
CLOSE

SELECT 1
USE SQLSQS
GO 2
SELECT 2
USE SQLSQE
GO 3
SELECT 3
USE SQLSQR
GO 2

FORMULA "SQLSEL-SQ-IN-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE S.SID IN (SELECT E.SID FROM SQLSQE E) ORDER BY SID
FORMULA "SQLSEL-SQ-IN-END"

FORMULA "SQLSEL-SQ-NOT-IN-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE S.SID NOT IN (SELECT E.SID FROM SQLSQE E) ORDER BY SID
FORMULA "SQLSEL-SQ-NOT-IN-END"

FORMULA "SQLSEL-SQ-SCALAR-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE S.SID = (SELECT E.SID FROM SQLSQE E WHERE E.COURSE = "ALG") ORDER BY SID
FORMULA "SQLSEL-SQ-SCALAR-END"

FORMULA "SQLSEL-SQ-EXISTS-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE EXISTS (SELECT E.SID FROM SQLSQE E WHERE E.SID = S.SID) ORDER BY SID
FORMULA "SQLSEL-SQ-EXISTS-END"

FORMULA "SQLSEL-SQ-NOT-EXISTS-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE NOT EXISTS (SELECT E.SID FROM SQLSQE E WHERE E.SID = S.SID) ORDER BY SID
FORMULA "SQLSEL-SQ-NOT-EXISTS-END"

FORMULA "SQLSEL-SQ-DIVISION-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE NOT EXISTS (SELECT R.COURSE FROM SQLSQR R WHERE NOT EXISTS (SELECT E.COURSE FROM SQLSQE E WHERE E.SID = S.SID AND E.COURSE = R.COURSE)) ORDER BY SID
FORMULA "SQLSEL-SQ-DIVISION-END"

FORMULA "SQLSEL-SQ-SCALAR-AGG-BEGIN"
SQLSEL SELECT SID,NAME FROM SQLSQS S WHERE S.SID = (SELECT MAX(SID) FROM SQLSQS WHERE SID < 4) ORDER BY SID
FORMULA "SQLSEL-SQ-SCALAR-AGG-END"

SELECT 1
? "SQ_C1_student_cursor_restored:" + (SID = 2 AND ALLTRIM(NAME) = "BOB")
SELECT 2
? "SQ_C2_enrollment_cursor_restored:" + (SID = 2 AND ALLTRIM(COURSE) = "ALG")
SELECT 3
? "SQ_C3_requirement_cursor_restored:" + (ALLTRIM(COURSE) = "OS")

FORMULA "SQLSEL-SQ-REFUSALS-BEGIN"
SQLSEL SELECT SID FROM SQLSQS S WHERE S.SID IN (SELECT E.COURSE FROM SQLSQE E)
SQLSEL SELECT SID FROM SQLSQS S WHERE S.SID = (SELECT E.SID FROM SQLSQE E)
SQLSEL SELECT S.SID FROM SQLSQS S JOIN SQLSQE E ON S.SID = E.SID WHERE EXISTS (SELECT R.COURSE FROM SQLSQR R)
FORMULA "SQLSEL-SQ-REFUSALS-END"

FORMULA "SQLSEL-SQ-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLSQS (SID INTEGER, NAME TEXT, MAJOR TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLSQE (SID INTEGER, COURSE TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLSQR (COURSE TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLSQS VALUES (1,'ALICE','CSCI',0),(2,'BOB','MATH',0),(3,'CARA','CSCI',0),(4,'DAN','HIST',0),(9,'DELETED','',1);
SQLITE EXEC INSERT INTO SQLSQE VALUES (1,'DB',0),(1,'OS',0),(2,'ALG',0),(3,'DB',0),(5,'ORPH',0),(3,'OS',1);
SQLITE EXEC INSERT INTO SQLSQR VALUES ('DB',0),('OS',0);

FORMULA "SQLSEL-SQ-O1-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND S.SID IN (SELECT E.SID FROM SQLSQE E WHERE E.D=0) ORDER BY SID;
FORMULA "SQLSEL-SQ-O1-END"

FORMULA "SQLSEL-SQ-O2-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND S.SID NOT IN (SELECT E.SID FROM SQLSQE E WHERE E.D=0) ORDER BY SID;
FORMULA "SQLSEL-SQ-O2-END"

FORMULA "SQLSEL-SQ-O3-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND S.SID=(SELECT E.SID FROM SQLSQE E WHERE E.D=0 AND E.COURSE='ALG') ORDER BY SID;
FORMULA "SQLSEL-SQ-O3-END"

FORMULA "SQLSEL-SQ-O4-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND EXISTS (SELECT 1 FROM SQLSQE E WHERE E.D=0 AND E.SID=S.SID) ORDER BY SID;
FORMULA "SQLSEL-SQ-O4-END"

FORMULA "SQLSEL-SQ-O5-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND NOT EXISTS (SELECT 1 FROM SQLSQE E WHERE E.D=0 AND E.SID=S.SID) ORDER BY SID;
FORMULA "SQLSEL-SQ-O5-END"

FORMULA "SQLSEL-SQ-O6-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND NOT EXISTS (SELECT 1 FROM SQLSQR R WHERE R.D=0 AND NOT EXISTS (SELECT 1 FROM SQLSQE E WHERE E.D=0 AND E.SID=S.SID AND E.COURSE=R.COURSE)) ORDER BY SID;
FORMULA "SQLSEL-SQ-O6-END"

FORMULA "SQLSEL-SQ-O7-BEGIN"
SQLITE SELECT SELECT SID,NAME FROM SQLSQS S WHERE S.D=0 AND S.SID=(SELECT MAX(SID) FROM SQLSQS WHERE D=0 AND SID<4) ORDER BY SID;
FORMULA "SQLSEL-SQ-O7-END"

SQLITE CLOSE
FORMULA "SQLSEL-SQ-ORACLE-END"

CLOSE ALL
ERASE TABLE SQLSQS CONFIRM
ERASE TABLE SQLSQE CONFIRM
ERASE TABLE SQLSQR CONFIRM

FORMULA "SQLSEL-SQ-END"
