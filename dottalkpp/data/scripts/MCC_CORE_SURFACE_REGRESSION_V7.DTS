ECHO ===== LOCATE / CONTINUE / FILTER / COUNT =====
SET FILTER TO
COUNT
COUNT DELETED
COUNT NOT DELETED
COUNT !DELETED
COUNT FOR LNAME = "ANDERSON"
COUNT WHERE GPA > 3.5
COUNT GPA > 3.5

SET FILTER TO FNAME = "AVA"
COUNT
COUNT FOR GPA > 2.5
COUNT FOR LNAME = "WHITE"
TOP
LIST 10
SET FILTER TO

COUNT FOR LNAME = "ANDERSON"
DELETE FOR LNAME = "ANDERSON"
COUNT FOR LNAME = "ANDERSON"
COUNT DELETED
RECALL FOR LNAME = "ANDERSON"
COUNT FOR LNAME = "ANDERSON"
COUNT DELETED

SET FILTER TO FNAME = "AVA"
COUNT
DELETE ALL
COUNT
COUNT DELETED
RECALL ALL
COUNT
COUNT DELETED
SET FILTER TO

TOP
COUNT DELETED
DELETE NEXT 3
COUNT DELETED
RECALL NEXT 3
COUNT DELETED

SET FILTER TO FNAME = "AVA"
LOCATE FOR LNAME = "WHITE"
TUP
CONTINUE
TUP
SET FILTER TO

LOCATE LNAME = "ANDERSON"
TUP
CONTINUE
TUP
CONTINUE
TUP

ECHO ===== BOOLEAN / PREDICATE GRAMMAR =====
TOP
LOCATE lname = Taylor
LIST 1
BOOLEAN (GPA > 3)
BOOLEAN (GPA < 3)
BOOLEAN (GPA >= 2 AND GPA <= 4)

ECHO ===== SMARTLIST =====
RECNO
SMARTLIST 5 FOR GPA >= 3.5
RECNO

SET FILTER TO FNAME = "AVA"
COUNT
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA
SET FILTER TO

SET FILTER TO FNAME = "AVA"
COUNT FOR GPA > 2.5
SUM GPA FOR GPA > 2.5
AVG GPA FOR GPA > 2.5
MIN GPA FOR GPA > 2.5
MAX GPA FOR GPA > 2.5
SET FILTER TO

ECHO ===== AGGREGATES =====
SUM GPA
AVERAGE GPA
AVG GPA
MIN GPA
MAX GPA

ECHO ===== STUDENTS DATE FIELDS + DATE ALGEBRA =====
LOCATE lname = Taylor
TUPLE DOB
TUPLE ENROLL_D
CALC DOB
CALC DOB + 1
CALC DOB - 1
CALC DATEADD(DOB, 30)
CALC DATEDIFF(DOB, DATE())
CALC DATE() - DOB

ECHO ===== RELATIONS ENGINE =====
REL LIST
REL CLEAR ALL
REL ADD STUDENTS ENROLL ON SID
REL ADD ENROLL CLASSES ON CLS_ID
REL LIST
REL REFRESH
REL_LIST
REL_REFRESH
CMDREL
CMDREL LIST
CMDREL REFRESH

ECHO ===== TABLE BUFFER CANARY =====
SELECT STUDENTS
LOCATE lname = Taylor
LIST 1
TUPLE *
TABLE ON
REPLACE FNAME WITH "DeraldNew"
ECHO [BUF-VIS-1] TUPLE should show buffered value immediately:
TUPLE *
ECHO [BUF-VIS-2] LIST should still show persisted value until COMMIT:
LIST 1
COMMIT
LIST 1
REPLACE FNAME WITH "Derald"
COMMIT
TABLE OFF
LIST 1

ECHO ===== CALCWRITE REVERSIBLE WRITE (GPA +/- 0.01) =====
SELECT STUDENTS
LOCATE lname = Taylor
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
LIST 1
CALC GPA = GPA - 0.01
COMMIT
LIST 1
TABLE OFF

ECHO ===== FILE OPS (SAFE, under tmp/) =====
! echo DotTalkTmpProbe>tmp/dt_probe.txt
! echo DotTalkTmpProbe2>tmp/dt_probe2.txt
DIR tmp/dt_probe.txt
DIR tmp/dt_probe2.txt
ERASE tmp/dt_probe.txt
ERASE tmp/dt_probe2.txt
DIR tmp

ECHO ===== SQLITE =====
SQLITE OPEN "tmp/sql_regression.sqlite"
SQLITE EXEC CREATE TABLE IF NOT EXISTS t(x INT);
SQLITE EXEC DELETE FROM t;
SQLITE EXEC INSERT INTO t(x) VALUES (1);
SQLITE EXEC INSERT INTO t(x) VALUES (2);
SQLITE SELECT SELECT * FROM t;
SQLITE CLOSE

ECHO ===== DOTSCRIPT / GO =====
! echo SET ECHO ON>tmp/mini_regression.dts
! echo ECHO MINI_DOTSCRIPT_OK>>tmp/mini_regression.dts
DOTSCRIPT tmp/mini_regression.dts
SET ECHO OFF
ECHO GO_OK
GO TOP

ECHO ===== SCRIPTING BLOCKS =====
IF .F.
    ECHO IF_BRANCH_RAN_UNEXPECTED
ELSE
    ECHO ELSE_BRANCH_RAN_OK
ENDIF

WHILE .F.
    ECHO WHILE_BODY_RAN_UNEXPECTED
ENDWHILE

UNTIL .T.
    ECHO UNTIL_BODY_RAN_UNEXPECTED
ENDUNTIL

SELECT BUILDING
TOP
SCAN
    TUPLE *
ENDSCAN

ECHO ===== TUPTALK MINI =====
SELECT STUDENTS
TUPTALK RESET
TUPTALK PUSH ALL
TUPTALK PUSH FILTER CND
TUPTALK PUSH 3
TUPTALK PUSH ROW
TUPTALK LIST
TUPTALK NORMALIZE
TUPTALK DUMP
TUPTALK EXPORT CSV students_norm.csv
TUPTALK EXPORT TSV students_norm.tsv

ECHO ===== SQLITE SMOKE (INLINE) =====
SQLITE VERSION
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, n INTEGER);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('alpha', 10);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('bravo', 20);
SQLITE EXEC INSERT INTO t (name, n) VALUES ('charlie', 30);
SQLITE SELECT SELECT id, name, n FROM t ORDER BY id;
SQLITE CLOSE

ECHO ===== KNOWN-FAIL / OBSERVATION CANARIES =====
ECHO [KNOWN-FAIL] CURRENT EXPECT .F.:
CALC ((DATE() + 2) > DATE())
ECHO [KNOWN-FAIL] CURRENT EXPECT .F.:
CALC ((DATE() - 2) < DATE())
ECHO [KNOWN-FAIL] CURRENT EXPECT .F.:
CALC (CTOD("2000-01-01") + 1 = CTOD("2000-01-02"))
ECHO [KNOWN-FAIL] CURRENT EXPECT .F.:
CALC (CTOD("2000-01-01") - 1 = CTOD("1999-12-31"))
ECHO [KNOWN-FAIL] CURRENT EXPECT .F.:
CALC (DATEDIFF(DOB, DATE()) = -(DATE() - DOB))

ECHO ===== CLEAN SHUTDOWN =====
SCHEMAS
SCHEMAS CLOSE
ECHO ===== V7 CORE SURFACE END =====
QUIT