SET ECHO OFF
* ============================================================
* MCC_CORE_SURFACE_REGRESSION_V7.DTS
*
* Purpose:
*   Core surface regression for stable commands and behaviors
*   that should remain valid independent of LMDB/x64 indexing.
*
* Scope:
*   - HELP / PATH / INIT / diagnostics
*   - SCHEMAS OPEN DBF
*   - date/time / string / calc
*   - LIST / DISPLAY / TUPLE / TOP / SKIP / BOTTOM
*   - FILTER / COUNT / LOCATE / CONTINUE
*   - relations
*   - table buffer visibility
*   - SQLite
*   - DotScript
*   - scripting blocks
*   - TUPTALK
*
* Excludes:
*   - LMDB utility probes
*   - x64-only index expectations
*   - SET ORDER/SEEK canaries that require valid LMDB/CDX attach
* ============================================================

ECHO ===== V7 CORE SURFACE START =====
COLOR DEFAULT
VERSION

ECHO ===== HELP / CATALOG SANITY =====
* HELP
* CMDHELP
* FOXHELP
* PREDHELP

ECHO ===== PATHS / ROOTS =====
SET PATH
SET PATH RESET
SET PATH
DIR
DIR dbf
DIR indexes
DIR tmp

ECHO ===== STARTUP / DIAGNOSTICS =====
INIT
DBAREA
AREA
STATUS
WSREPORT

ECHO [NOTE] SHOW currently supports TABLE / COLUMNS / INDEX in this build:
SHOW TABLE
SHOW COLUMNS
SHOW INDEX

ECHO ===== SCHEMAS BRING-UP =====
SCHEMAS
SCHEMAS CLOSE
REL CLEAR ALL
SCHEMAS OPEN DBF
SCHEMAS

ECHO ===== BASELINE CLOCK / DATE-TIME =====
DATE
TODAY
TIME
NOW
DATETIME
CALC DATE()
CALC TODAY()
CALC TIME()
CALC NOW()
CALC DATETIME()
CALC (DATE() = TODAY())
CALC (NOW() = DATETIME())

ECHO ===== DATE ALGEBRA / FUNCTION BASELINE =====
CALC DATE() + 2
CALC DATE() - 2
CTOD 2000-01-01
CTOD "2000-01-01"
CTOD "2000/01/01"
CTOD 20000101
CALC CTOD("2000-01-01")
CALC DTOC(CTOD("2000-01-01"))
DATEADD 20000101, 30
DATEADD 20000101, -30
DATEDIFF 20000101, 20000103
CALC DATEADD(DATE(), 30)
CALC DATEDIFF(CTOD("2000-01-01"), DATE())

ECHO ===== RHS EXPRESSION SANITY =====
CALC (3 = 1 + 2)
CALC ((1 + 2) = (6 / 2))
CALC ((1 + 2 * 3) = (1 + (2 * 3)))

ECHO ===== STRING / CHAR COMMANDS =====
ALLTRIM "  hi  "
LTRIM "  hi"
RTRIM "hi  "
TRIM "hi  "
UPPER "aBc"
LOWER "aBc"
PROPER "joHN"
LEN "ABCDE"
LEFT "ABCDE", 3
RIGHT "ABCDE", 2
SUBSTR "ABCDE", 2, 3
AT "CD", "ABCDE"
ATC "cd", "ABCDE"
CHR 65
ASC "A"
SPACE 3
REPLICATE "x", 5
PADC "hi", 6
PADL "hi", 6
PADR "hi", 6
STUFF "ABCDE", 2, 2, "ZZ"
STR 123
VAL "123.45"
LIKE "SMITH", "SMI%"

ECHO ===== EXPECTED-USAGE / ERROR CANARIES (NON-FATAL) =====
TRANSFORM 123
NORMALIZE "  a  b  "
MULTIREP "banana", "a", "A", "n", "N"

ECHO ===== CONCAT / STRCAT =====
CONCAT "A", "B"
CALC CONCAT("A","B")
STRCAT "A", "B"

ECHO ===== BUILDING =====
SELECT BUILDING
AREA
STRUCT
FIELDS
COUNT
RECNO
LIST 3
RECNO
DISPLAY
RECORDVIEW
TOP
RECNO
SKIP 1
RECNO
BOTTOM
RECNO
TOP
RECNO
LIST 3

ECHO ===== ROOMS =====
SELECT ROOMS
STRUCT
COUNT
RECNO
LIST 3
RECNO
TUPLE *
TOP
SKIP 1
BOTTOM
TOP
LIST 3

