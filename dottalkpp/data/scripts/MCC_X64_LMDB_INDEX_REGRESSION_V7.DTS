SET ECHO OFF
* ============================================================
* MCC_X64_LMDB_INDEX_REGRESSION_V7.DTS
*
* Purpose:
*   X64/XDBF + LMDB/CDX regression for ordered attach, navigation,
*   ordered listing, seek-like behavior, and LMDB utility probes.
*
* Contract:
*   - Run only against XDBF/x64 tables
*   - LMDB is x64-only
*   - CDX container/meta and LMDB env must match the x64 table
*
* Scope:
*   - SET PATH DBF = XDBF
*   - open x64 tables only
*   - SET INDEX TO / SET ORDER TO TAG
*   - ordered TOP/LIST probes
*   - SEEK / INDEXSEEK where valid
*   - LMDB OPEN / USE / INFO / SEEK / SCAN / CLOSE
*
* Excludes:
*   - v32 DBF assumptions
*   - legacy INX/CNX transitional checks
* ============================================================

ECHO ===== V7 X64 LMDB INDEX START =====
COLOR DEFAULT
VERSION

ECHO ===== INIT / X64 PATHS =====
INIT
SET PATH
SETPATH DBF XDBF
SET PATH

SCHEMAS CLOSE
REL CLEAR ALL

ECHO ===== OPEN X64 TABLE(S) =====
* Replace these with the x64 tables you intend to validate first.
* If SCHEMAS OPEN XDBF is supported, use it. Otherwise USE individual tables.

* Example broad open:
SCHEMAS OPEN XDBF
SCHEMAS

ECHO ===== X64 BUILDING =====
SELECT BUILDING
AREA
SHOW INDEX
SET INDEX TO BUILDING.cdx
AREA
SHOW INDEX
SET ORDER TO TAG BLDG
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 ROOMS =====
SELECT ROOMS
AREA
SHOW INDEX
SET INDEX TO ROOMS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG ROOM
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 DEPT =====
SELECT DEPT
AREA
SHOW INDEX
SET INDEX TO DEPT.cdx
AREA
SHOW INDEX
SET ORDER TO TAG DEPT_ID
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 MAJORS =====
SELECT MAJORS
AREA
SHOW INDEX
SET INDEX TO MAJORS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG MAJOR
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 COURSES =====
SELECT COURSES
AREA
SHOW INDEX
SET INDEX TO COURSES.cdx
AREA
SHOW INDEX
SET ORDER TO TAG CID
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 CLASSES =====
SELECT CLASSES
AREA
SHOW INDEX
SET INDEX TO CLASSES.cdx
AREA
SHOW INDEX
SET ORDER TO TAG CLS_ID
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== X64 TEACHERS =====
SELECT TEACHERS
AREA
SHOW INDEX
SET INDEX TO TEACHERS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG LNAME
AREA
SHOW INDEX
TOP
RECNO
LIST 3
RECNO
INDEXSEEK "WILSON"

ECHO ===== X64 STUDENTS / PUBLIC INDEX WORKFLOW =====
SELECT STUDENTS
AREA
SHOW INDEX
SET INDEX TO STUDENTS.cdx
AREA
SHOW INDEX

SET ORDER TO TAG LNAME
AREA
SHOW INDEX
ECHO [ORDER ENTRY] TOP after LNAME order attach
TOP
RECNO
LIST 5
RECNO
INDEXSEEK "DAVIS"

SET ORDER TO TAG FNAME
AREA
SHOW INDEX
ECHO [ORDER ENTRY] TOP after FNAME order attach
TOP
RECNO
LIST 5
RECNO
INDEXSEEK "AVA"

SET ORDER TO TAG SID
AREA
SHOW INDEX
TOP
RECNO
LIST 5
RECNO

SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== ORDERED CURSOR CANARIES =====
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
TOP
RECNO
LIST 1
RECNO

SET ORDER TO TAG FNAME
TOP
RECNO
LIST 1
RECNO

SET ORDER TO TAG SID
TOP
RECNO
LIST 1
RECNO

SET ORDER TO 0
TOP
RECNO

ECHO ===== ORDERED LOCATE / SEEK / INDEXSEEK =====
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
TOP
INDEXSEEK "TAYLOR"
LIST 1

SET ORDER TO TAG FNAME
TOP
INDEXSEEK "AVA"
LIST 1

SET ORDER TO TAG SID
TOP
INDEXSEEK "50000020"
LIST 1

SET ORDER TO 0

ECHO ===== X64 TABLE BUFFER + INDEX UPDATE (CREATE/MODIFY ONLY) =====
SELECT STUDENTS
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
LIST 1
TUPLE *

TABLE ON
REPLACE FNAME WITH "DeraldNew"
ECHO [BUF-VIS-1] TUPLE should show buffered value immediately:
TUPLE *
ECHO [BUF-VIS-2] LIST may show persisted/indexed value until COMMIT:
LIST 1
COMMIT
ECHO [BUF-VIS-3] After COMMIT, verify ordered/listed state:
TOP
LIST 3
INDEXSEEK "TAYLOR"

REPLACE FNAME WITH "Derald"
COMMIT
TOP
LIST 3
TABLE OFF

ECHO ===== X64 CALCWRITE REVERSIBLE WRITE =====
SELECT STUDENTS
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
LOCATE lname = Taylor
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
LIST 1
CALC GPA = GPA - 0.01
COMMIT
LIST 1
TABLE OFF

ECHO ===== LMDB UTILITY PROBES =====
LMDB
LMDB OPEN STUDENTS.cdx.d
LMDB USE LNAME
LMDB INFO
LMDB SEEK WILSON
LMDB SCAN A D
LMDB CLOSE

LMDB OPEN STUDENTS.cdx.d
LMDB USE FNAME
LMDB INFO
LMDB SEEK AVA
LMDB SCAN M Z
LMDB CLOSE

ECHO ===== LMDB UTILITY PROBES (TEACHERS) =====
SELECT TEACHERS
SET INDEX TO TEACHERS.cdx
SET ORDER TO TAG LNAME
LMDB OPEN TEACHERS.cdx.d
LMDB USE LNAME
LMDB INFO
LMDB SEEK WILSON
LMDB SCAN A Z
LMDB CLOSE

ECHO ===== X64 REINDEX / REBUILD OBSERVATION =====
SELECT STUDENTS
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
SHOW INDEX
REINDEX
SHOW INDEX
INDEXSEEK "DAVIS"

ECHO ===== CLEAN SHUTDOWN =====
SET ORDER TO 0
SCHEMAS
SCHEMAS CLOSE
ECHO ===== V7 X64 LMDB INDEX END =====
QUIT