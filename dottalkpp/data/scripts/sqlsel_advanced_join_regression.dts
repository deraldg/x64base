; ============================================================================
; AIF-074 SQLsel generalized JOIN -- self, composite, chains, expressions
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; four fixtures self-erase)
;
; Proves:
;   AJ1 self-join uses distinct aliases over one physical typed table.
;   AJ2 composite boolean ON is evaluated over the combined TupleRow.
;   AJ3 three-table INNER and LEFT chains preserve multiplicity/absence.
;   AJ4 expression projection uses the shared AST over TupleRows.
;   AJ5 multi-column ORDER BY applies independent directions.
;   AJ6 multi-join takes one canonical fence over distinct physical tables.
;   AJ7 an empty right source still contributes its typed TupleRow schema, so a
;       chained LEFT JOIN carries numeric/date absence rather than losing columns.
;   ORACLE eight marked SQLsel row sets equal SQLite.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-AJ-BEGIN"
ERASE TABLE SQLADV CONFIRM
ERASE TABLE SQLBON CONFIRM
ERASE TABLE SQLCAT CONFIRM
ERASE TABLE SQLEMPTY CONFIRM

CREATE X64 SQLADV (ID N(6,0), MGR N(6,0), NAME C(12), DEPT C(4), PAY N(9,2))
APPEND
REPLACE ID WITH "1"
REPLACE MGR WITH "0"
REPLACE NAME WITH "ALPHA"
REPLACE DEPT WITH "A"
REPLACE PAY WITH "100.00"
APPEND
REPLACE ID WITH "2"
REPLACE MGR WITH "1"
REPLACE NAME WITH "BETA"
REPLACE DEPT WITH "A"
REPLACE PAY WITH "50.00"
APPEND
REPLACE ID WITH "3"
REPLACE MGR WITH "1"
REPLACE NAME WITH "GAMMA"
REPLACE DEPT WITH "B"
REPLACE PAY WITH "70.00"
APPEND
REPLACE ID WITH "4"
REPLACE MGR WITH "2"
REPLACE NAME WITH "DELTA"
REPLACE DEPT WITH "A"
REPLACE PAY WITH "40.00"
APPEND
REPLACE ID WITH "5"
REPLACE MGR WITH "1"
REPLACE NAME WITH "DELETED"
DELETE
CLOSE

CREATE X64 SQLBON (ID N(6,0), DEPT C(4), KIND C(4), AMT N(7,2))
APPEND
REPLACE ID WITH "2"
REPLACE DEPT WITH "A"
REPLACE KIND WITH "K1"
REPLACE AMT WITH "5.00"
APPEND
REPLACE ID WITH "2"
REPLACE DEPT WITH "B"
REPLACE KIND WITH "K2"
REPLACE AMT WITH "8.00"
APPEND
REPLACE ID WITH "3"
REPLACE DEPT WITH "B"
REPLACE KIND WITH "K1"
REPLACE AMT WITH "7.00"
APPEND
REPLACE ID WITH "4"
REPLACE DEPT WITH "A"
REPLACE KIND WITH "K2"
REPLACE AMT WITH "3.00"
APPEND
REPLACE ID WITH "9"
REPLACE DEPT WITH "A"
REPLACE KIND WITH "K1"
REPLACE AMT WITH "99.00"
DELETE
CLOSE

CREATE X64 SQLCAT (KIND C(4), LABEL C(12))
APPEND
REPLACE KIND WITH "K1"
REPLACE LABEL WITH "CORE"
APPEND
REPLACE KIND WITH "K2"
REPLACE LABEL WITH "EXTRA"
CLOSE

CREATE X64 SQLEMPTY (ID N(6,0), KIND C(4), SCORE N(7,2), STAMP D)
CLOSE

SELECT 1
USE SQLADV
GO 2
SELECT 2
USE SQLBON
GO 3
SELECT 3
USE SQLCAT
GO 2
SELECT 4
USE SQLEMPTY

FORMULA "SQLSEL-AJ-SELF-BEGIN"
SQLSEL SELECT E.NAME,M.NAME FROM SQLADV E JOIN SQLADV M ON E.MGR = M.ID ORDER BY E.NAME
FORMULA "SQLSEL-AJ-SELF-END"

FORMULA "SQLSEL-AJ-COMPOSITE-BEGIN"
SQLSEL SELECT E.NAME,B.AMT FROM SQLADV E JOIN SQLBON B ON E.ID = B.ID AND E.DEPT = B.DEPT ORDER BY E.NAME
FORMULA "SQLSEL-AJ-COMPOSITE-END"

FORMULA "SQLSEL-AJ-CHAIN-BEGIN"
SQLSEL SELECT E.NAME,B.KIND,C.LABEL FROM SQLADV E JOIN SQLBON B ON E.ID = B.ID JOIN SQLCAT C ON B.KIND = C.KIND ORDER BY E.NAME
FORMULA "SQLSEL-AJ-CHAIN-END"

FORMULA "SQLSEL-AJ-LEFT-CHAIN-BEGIN"
SQLSEL SELECT E.NAME,B.AMT,C.LABEL FROM SQLADV E LEFT JOIN SQLBON B ON E.ID = B.ID AND E.DEPT = B.DEPT LEFT JOIN SQLCAT C ON B.KIND = C.KIND ORDER BY E.NAME
FORMULA "SQLSEL-AJ-LEFT-CHAIN-END"

FORMULA "SQLSEL-AJ-EXPRESSION-BEGIN"
SQLSEL SELECT UPPER(E.NAME) AS EMPLOYEE,M.NAME AS MANAGER,E.PAY + 10 AS ADJUSTED FROM SQLADV E JOIN SQLADV M ON E.MGR = M.ID ORDER BY MANAGER ASC,EMPLOYEE DESC
FORMULA "SQLSEL-AJ-EXPRESSION-END"

FORMULA "SQLSEL-AJ-MULTIORDER-BEGIN"
SQLSEL SELECT E.DEPT,E.NAME FROM SQLADV E JOIN SQLADV M ON E.MGR = M.ID ORDER BY E.DEPT ASC,E.NAME DESC
FORMULA "SQLSEL-AJ-MULTIORDER-END"

FORMULA "SQLSEL-AJ-COUNT-BEGIN"
SQLSEL SELECT COUNT(*) FROM SQLADV E JOIN SQLBON B ON E.ID = B.ID JOIN SQLCAT C ON B.KIND = C.KIND
FORMULA "SQLSEL-AJ-COUNT-END"

FORMULA "SQLSEL-AJ-EMPTY-RIGHT-BEGIN"
SQLSEL SELECT E.NAME,Z.SCORE,Z.STAMP,C.LABEL FROM SQLADV E LEFT JOIN SQLEMPTY Z ON E.ID = Z.ID LEFT JOIN SQLCAT C ON Z.KIND = C.KIND WHERE E.ID = 1
FORMULA "SQLSEL-AJ-EMPTY-RIGHT-END"

SELECT 1
? "AJ_C1_employee_cursor_restored:" + (ID = 2 AND ALLTRIM(NAME) = "BETA")
SELECT 2
? "AJ_C2_bonus_cursor_restored:" + (ID = 3 AND ALLTRIM(KIND) = "K1")
SELECT 3
? "AJ_C3_category_cursor_restored:" + (ALLTRIM(KIND) = "K2")

FORMULA "SQLSEL-AJ-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLADV (ID INTEGER,MGR INTEGER,NAME TEXT,DEPT TEXT,PAY REAL,D INTEGER);
SQLITE EXEC CREATE TABLE SQLBON (ID INTEGER,DEPT TEXT,KIND TEXT,AMT REAL,D INTEGER);
SQLITE EXEC CREATE TABLE SQLCAT (KIND TEXT,LABEL TEXT,D INTEGER);
SQLITE EXEC CREATE TABLE SQLEMPTY (ID INTEGER,KIND TEXT,SCORE REAL,STAMP TEXT,D INTEGER);
SQLITE EXEC INSERT INTO SQLADV VALUES (1,0,'ALPHA','A',100,0),(2,1,'BETA','A',50,0),(3,1,'GAMMA','B',70,0),(4,2,'DELTA','A',40,0),(5,1,'DELETED','A',0,1);
SQLITE EXEC INSERT INTO SQLBON VALUES (2,'A','K1',5,0),(2,'B','K2',8,0),(3,'B','K1',7,0),(4,'A','K2',3,0),(9,'A','K1',99,1);
SQLITE EXEC INSERT INTO SQLCAT VALUES ('K1','CORE',0),('K2','EXTRA',0);

FORMULA "SQLSEL-AJ-O1-BEGIN"
SQLITE SELECT SELECT E.NAME,M.NAME FROM SQLADV E JOIN SQLADV M ON E.MGR=M.ID AND M.D=0 WHERE E.D=0 ORDER BY E.NAME;
FORMULA "SQLSEL-AJ-O1-END"
FORMULA "SQLSEL-AJ-O2-BEGIN"
SQLITE SELECT SELECT E.NAME,printf('%.2f',B.AMT) FROM SQLADV E JOIN SQLBON B ON E.ID=B.ID AND E.DEPT=B.DEPT AND B.D=0 WHERE E.D=0 ORDER BY E.NAME;
FORMULA "SQLSEL-AJ-O2-END"
FORMULA "SQLSEL-AJ-O3-BEGIN"
SQLITE SELECT SELECT E.NAME,B.KIND,C.LABEL FROM SQLADV E JOIN SQLBON B ON E.ID=B.ID AND B.D=0 JOIN SQLCAT C ON B.KIND=C.KIND AND C.D=0 WHERE E.D=0 ORDER BY E.NAME;
FORMULA "SQLSEL-AJ-O3-END"
FORMULA "SQLSEL-AJ-O4-BEGIN"
SQLITE SELECT SELECT E.NAME,CASE WHEN B.ID IS NULL THEN '<UNMATCHED>' ELSE printf('%.2f',B.AMT) END,COALESCE(C.LABEL,'<UNMATCHED>') FROM SQLADV E LEFT JOIN SQLBON B ON E.ID=B.ID AND E.DEPT=B.DEPT AND B.D=0 LEFT JOIN SQLCAT C ON B.KIND=C.KIND AND C.D=0 WHERE E.D=0 ORDER BY E.NAME;
FORMULA "SQLSEL-AJ-O4-END"
FORMULA "SQLSEL-AJ-O5-BEGIN"
SQLITE SELECT SELECT UPPER(E.NAME),M.NAME,printf('%.6f',E.PAY+10) FROM SQLADV E JOIN SQLADV M ON E.MGR=M.ID AND M.D=0 WHERE E.D=0 ORDER BY M.NAME ASC,UPPER(E.NAME) DESC;
FORMULA "SQLSEL-AJ-O5-END"
FORMULA "SQLSEL-AJ-O6-BEGIN"
SQLITE SELECT SELECT E.DEPT,E.NAME FROM SQLADV E JOIN SQLADV M ON E.MGR=M.ID AND M.D=0 WHERE E.D=0 ORDER BY E.DEPT ASC,E.NAME DESC;
FORMULA "SQLSEL-AJ-O6-END"
FORMULA "SQLSEL-AJ-O7-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM SQLADV E JOIN SQLBON B ON E.ID=B.ID AND B.D=0 JOIN SQLCAT C ON B.KIND=C.KIND AND C.D=0 WHERE E.D=0;
FORMULA "SQLSEL-AJ-O7-END"
FORMULA "SQLSEL-AJ-O8-BEGIN"
SQLITE SELECT SELECT E.NAME,CASE WHEN Z.ID IS NULL THEN '<UNMATCHED>' ELSE printf('%.2f',Z.SCORE) END,COALESCE(Z.STAMP,'<UNMATCHED>'),COALESCE(C.LABEL,'<UNMATCHED>') FROM SQLADV E LEFT JOIN SQLEMPTY Z ON E.ID=Z.ID AND Z.D=0 LEFT JOIN SQLCAT C ON Z.KIND=C.KIND AND C.D=0 WHERE E.D=0 AND E.ID=1;
FORMULA "SQLSEL-AJ-O8-END"
SQLITE CLOSE
FORMULA "SQLSEL-AJ-ORACLE-END"

CLOSE ALL
ERASE TABLE SQLADV CONFIRM
ERASE TABLE SQLBON CONFIRM
ERASE TABLE SQLCAT CONFIRM
ERASE TABLE SQLEMPTY CONFIRM
FORMULA "SQLSEL-AJ-END"
