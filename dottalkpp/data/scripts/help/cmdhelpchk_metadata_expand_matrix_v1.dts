* CMDHELPCHK v2 Phase 2 metadata expansion matrix v1
* Compact locate-only probe.
* Use this by running: DO help\cmdhelpchk_metadata_expand_matrix_v1
* Do not paste this line-by-line from the prompt, because relative DO paths differ.

SET PAGING OFF
SET TALK OFF
SET ECHO ON

DO ..\..\metadata
WORKSPACE OPEN DBF

* SYSCMD command rows by canonical command name
SELECT SYSCMD
LOCATE FOR CAN_NAME = "HELP"
LOCATE FOR CAN_NAME = "CMDHELPCHK"
LOCATE FOR CAN_NAME = "DRAWIO"
LOCATE FOR CAN_NAME = "TUPLE"
LOCATE FOR CAN_NAME = "TUPLEDELTA"
LOCATE FOR CAN_NAME = "LIST"
LOCATE FOR CAN_NAME = "SMARTLIST"
LOCATE FOR CAN_NAME = "WORKSPACE"
LOCATE FOR CAN_NAME = "SETINDEX"
LOCATE FOR CAN_NAME = "SETORDER"
LOCATE FOR CAN_NAME = "SET"
LOCATE FOR CAN_NAME = "REL"

* SYSCMD command rows by command id variants
SELECT SYSCMD
LOCATE FOR CMD_ID = "CMD_HELP"
LOCATE FOR CMD_ID = "CMD_CHELPCHK"
LOCATE FOR CMD_ID = "CMD_CMDHELPCHK"
LOCATE FOR CMD_ID = "CMD_DRAWIO"
LOCATE FOR CMD_ID = "CMD_TUPLE"
LOCATE FOR CMD_ID = "CMD_TUPLEDELTA"
LOCATE FOR CMD_ID = "CMD_LIST"
LOCATE FOR CMD_ID = "CMD_SMARTLIST"
LOCATE FOR CMD_ID = "CMD_WORKSPACE"
LOCATE FOR CMD_ID = "CMD_SETINDEX"
LOCATE FOR CMD_ID = "CMD_SETORDER"

* SYSCMD command rows by handler
SELECT SYSCMD
LOCATE FOR HANDLER = "cmd_HELP"
LOCATE FOR HANDLER = "cmd_CMDHELPCHK"
LOCATE FOR HANDLER = "cmd_DRAWIO"
LOCATE FOR HANDLER = "cmd_TUPLE"
LOCATE FOR HANDLER = "cmd_TUPLEDELTA"
LOCATE FOR HANDLER = "cmd_LIST"
LOCATE FOR HANDLER = "cmd_SMARTLIST"
LOCATE FOR HANDLER = "cmd_WORKSPACE"
LOCATE FOR HANDLER = "cmd_SETINDEX"
LOCATE FOR HANDLER = "cmd_SETORDER"

* SYSSUBCMD routed forms
SELECT SYSSUBCMD
LOCATE FOR QUAL_NAME = "SET INDEX"
LOCATE FOR QUAL_NAME = "SET ORDER"
LOCATE FOR QUAL_NAME = "REL ENUM"
LOCATE FOR SUB_ID = "SUB_SET_INDEX"
LOCATE FOR SUB_ID = "SUB_SET_ORDER"
LOCATE FOR HANDLER = "cmd_SETINDEX"
LOCATE FOR HANDLER = "cmd_SETORDER"

* SYSENTVAR aliases and shortcuts
SELECT SYSENTVAR
LOCATE FOR TOKEN = "SL"
LOCATE FOR CAN_TARG = "SMARTLIST"
LOCATE FOR HELP_OWNR = "SMARTLIST"
LOCATE FOR TOKEN = "SETPATH"
LOCATE FOR CAN_TARG = "SET PATH"
LOCATE FOR TOKEN = "DDL"
LOCATE FOR CAN_TARG = "SCHEMA"
LOCATE FOR TOKEN = "FH"
LOCATE FOR CAN_TARG = "FOXHELP"

* SYSHELP owners
SELECT SYSHELP
LOCATE FOR OWNER_NAM = "HELP"
LOCATE FOR OWNER_NAM = "CMDHELPCHK"
LOCATE FOR OWNER_NAM = "DRAWIO"
LOCATE FOR OWNER_NAM = "TUPLE"
LOCATE FOR OWNER_NAM = "TUPLEDELTA"
LOCATE FOR OWNER_NAM = "LIST"
LOCATE FOR OWNER_NAM = "SMARTLIST"
LOCATE FOR OWNER_NAM = "WORKSPACE"
LOCATE FOR OWNER_NAM = "SET INDEX"
LOCATE FOR OWNER_NAM = "SET ORDER"
LOCATE FOR OWNER_NAM = "SET"
LOCATE FOR OWNER_NAM = "REL ENUM"
LOCATE FOR HLP_TXT_ID = "HT_SET_SUMMARY"
LOCATE FOR HLP_TXT_ID = "HT_REL_ENUM"

* SYSARGS owners
SELECT SYSARGS
LOCATE FOR OWNER_NAM = "HELP"
LOCATE FOR OWNER_NAM = "CMDHELPCHK"
LOCATE FOR OWNER_NAM = "DRAWIO"
LOCATE FOR OWNER_NAM = "TUPLE"
LOCATE FOR OWNER_NAM = "TUPLEDELTA"
LOCATE FOR OWNER_NAM = "LIST"
LOCATE FOR OWNER_NAM = "SMARTLIST"
LOCATE FOR OWNER_NAM = "WORKSPACE"
LOCATE FOR OWNER_NAM = "SET INDEX"
LOCATE FOR OWNER_NAM = "SET ORDER"
LOCATE FOR OWNER_NAM = "SET"
