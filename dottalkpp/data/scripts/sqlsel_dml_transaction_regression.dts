; ============================================================================
; AIF-074 P5 -- typed SQLsel DML and single-table transactions
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; fixtures self-erase)
;
; Proves:
;   D1 INSERT/UPDATE/DELETE route through table buffer + TBJ1 WAL.
;   D2 values retain DBF/tuple types; incompatible logical, NULL, width,
;      unknown-column, and unsafe DELETE forms refuse before storage.
;   D3 BEGIN/ROLLBACK and BEGIN/COMMIT differ; DML reads its own buffered
;      INSERT/UPDATE state while SELECT continues to report committed truth.
;   D4 one transaction modifies one table; a second-table enlistment refuses
;      because x64base has no cross-table atomic commit protocol.
;   D5 caller-owned FLOCK and every open cursor are preserved.
;   ORACLE six marked committed row sets equal SQLite.
;
; Read rule: REGRESSION SQLSEL_DML must print SQLSEL DML ORACLE: PASS.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-DML-BEGIN"
ERASE TABLE SQLDML CONFIRM
ERASE TABLE SQLDML2 CONFIRM

CREATE X64 SQLDML (ID N(6,0), NAME C(12), AMT N(9,2), ACTIVE L, STAMP D)
APPEND
REPLACE ID WITH "1"
REPLACE NAME WITH "ALPHA"
REPLACE AMT WITH "10.00"
REPLACE ACTIVE WITH "T"
REPLACE STAMP WITH "20240101"
APPEND
REPLACE ID WITH "2"
REPLACE NAME WITH "BETA"
REPLACE AMT WITH "20.00"
REPLACE ACTIVE WITH "T"
REPLACE STAMP WITH "20240102"
CLOSE

CREATE X64 SQLDML2 (ID N(6,0), NAME C(12))
APPEND
REPLACE ID WITH "1"
REPLACE NAME WITH "OTHER"
CLOSE

SELECT 1
USE SQLDML
GO 2
SELECT 2
USE SQLDML2
GO 1
SELECT 1

; D1 -- all three autocommit verbs, including multi-row VALUES parsing.
SQLSEL INSERT INTO SQLDML (ID,NAME,AMT,ACTIVE,STAMP) VALUES (3,'GAMMA',30.00,.T.,'20240103')
SQLSEL UPDATE SQLDML SET NAME = UPPER('alpha2'), AMT = AMT + 2.5, ACTIVE = .F. WHERE ID = 1
SQLSEL DELETE FROM SQLDML WHERE ID = 2
FORMULA "SQLSEL-DML-S1-BEGIN"
SQLSEL SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S1-END"
? "DML_C1_autocommit_cursor_restored:" + (ID = 2 AND ALLTRIM(NAME) = "BETA")
? "DML_W1_autocommit_wal_closed:" + NOT FILE("DBF/SANDBOX/SQLDML.dbf.tbj")

; D2 -- rollback and committed-view SELECT while writes are pending.
SET MODE SQL
BEGIN
UPDATE SQLDML SET NAME = 'ROLLED' WHERE ID = 1
INSERT INTO SQLDML (ID,NAME,AMT,ACTIVE,STAMP) VALUES (4,'TEMP',40.00,.T.,'20240104')
DELETE FROM SQLDML WHERE ID = 3
FORMULA "SQLSEL-DML-S2-BEGIN"
SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S2-END"
ROLLBACK
FORMULA "SQLSEL-DML-S3-BEGIN"
SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S3-END"
? "DML_W2_rollback_wal_closed:" + NOT FILE("DBF/SANDBOX/SQLDML.dbf.tbj")

; D3 -- INSERT becomes visible to later DML; repeated arithmetic reads its own
; buffered predecessor before one WAL-backed commit.
BEGIN TRANSACTION
UPDATE SQLDML SET NAME = 'COMMITTED', AMT = AMT + 5 WHERE ID = 1
UPDATE SQLDML SET AMT = AMT + 5 WHERE ID = 1
INSERT INTO SQLDML (ID,NAME,AMT,ACTIVE,STAMP) VALUES (4,'DELTA',40.00,.T.,'20240104')
UPDATE SQLDML SET AMT = AMT + 1 WHERE ID = 4
DELETE FROM SQLDML WHERE ID = 3
COMMIT
FORMULA "SQLSEL-DML-S4-BEGIN"
SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S4-END"
? "DML_W3_commit_wal_closed:" + NOT FILE("DBF/SANDBOX/SQLDML.dbf.tbj")

; D4 -- SQLsel borrows, but never releases, a caller-owned table lock.
LOCK TABLE
UPDATE SQLDML SET NAME = 'LOCKED' WHERE ID = 4
? "DML_L1_caller_table_lock_preserved:" + FILE("DBF/SANDBOX/SQLDML.dbf.lock")
UNLOCK TABLE
FORMULA "SQLSEL-DML-S5-BEGIN"
SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S5-END"

; D5 -- one-table atomicity is real; cross-table atomicity is not claimed.
BEGIN
UPDATE SQLDML SET NAME = 'PENDING' WHERE ID = 4
UPDATE SQLDML2 SET NAME = 'BLOCKED' WHERE ID = 1
SET MODE NATIVE
ROLLBACK
FORMULA "SQLSEL-DML-S6-BEGIN"
SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID
FORMULA "SQLSEL-DML-S6-END"

; D6 -- typed/fail-closed controls. None may mutate SQLDML.
UPDATE SQLDML SET ACTIVE = 'NOTBOOL' WHERE ID = 1
INSERT INTO SQLDML (ID,NAME,AMT,ACTIVE,STAMP) VALUES (9,NULL,9.00,.T.,'20240109')
UPDATE SQLDML SET NAME = 'THIS VALUE IS TOO LONG' WHERE ID = 1
UPDATE SQLDML SET NOSUCH = 'X' WHERE ID = 1
DELETE FROM SQLDML
? "DML_C2_final_cursor_restored:" + (ID = 2 AND ALLTRIM(NAME) = "BETA")

; SQLite oracle follows only committed effects. Its transaction S2 is rolled
; back; S3 deliberately models SQLsel's committed-view SELECT during that span.
FORMULA "SQLSEL-DML-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLDML (ID INTEGER,NAME TEXT,AMT NUMERIC,ACTIVE TEXT,STAMP TEXT);
SQLITE EXEC INSERT INTO SQLDML VALUES (1,'ALPHA',10.00,'T','20240101'),(2,'BETA',20.00,'T','20240102');
SQLITE EXEC INSERT INTO SQLDML VALUES (3,'GAMMA',30.00,'T','20240103');
SQLITE EXEC UPDATE SQLDML SET NAME='ALPHA2',AMT=AMT+2.5,ACTIVE='F' WHERE ID=1;
SQLITE EXEC DELETE FROM SQLDML WHERE ID=2;
FORMULA "SQLSEL-DML-O1-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O1-END"
FORMULA "SQLSEL-DML-O2-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O2-END"
FORMULA "SQLSEL-DML-O3-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O3-END"
SQLITE EXEC UPDATE SQLDML SET NAME='COMMITTED',AMT=AMT+10 WHERE ID=1;
SQLITE EXEC INSERT INTO SQLDML VALUES (4,'DELTA',41.00,'T','20240104');
SQLITE EXEC DELETE FROM SQLDML WHERE ID=3;
FORMULA "SQLSEL-DML-O4-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O4-END"
SQLITE EXEC UPDATE SQLDML SET NAME='LOCKED' WHERE ID=4;
FORMULA "SQLSEL-DML-O5-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O5-END"
FORMULA "SQLSEL-DML-O6-BEGIN"
SQLITE SELECT SELECT ID,NAME,AMT,ACTIVE,STAMP FROM SQLDML ORDER BY ID;
FORMULA "SQLSEL-DML-O6-END"
SQLITE CLOSE
FORMULA "SQLSEL-DML-ORACLE-END"

SET MODE NATIVE
CLOSE ALL
ERASE TABLE SQLDML CONFIRM
ERASE TABLE SQLDML2 CONFIRM
FORMULA "SQLSEL-DML-END"
