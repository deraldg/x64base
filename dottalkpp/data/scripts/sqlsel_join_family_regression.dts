; ============================================================================
; AIF-074 P4.4 -- SQLsel RIGHT, FULL, and CROSS JOIN oracle gate G4d
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; two fixtures and sidecars self-erase)
; Purpose: Prove the remaining two-table JOIN family against SQLite.
; Inputs: none; creates SQLJFL and SQLJFR in DBF/SANDBOX.
; Outputs: transcript only; fixture DBF/CDX/LMDB artifacts are erased.
; Mutation: disposable DBF/CDX/LMDB fixtures under SANDBOX.
; Gate: REGRESSION SQLSEL_JOIN_FAMILY must print SQLSEL JOIN FAMILY ORACLE: PASS.
;
; Proves:
;   JF1 RIGHT preserves duplicate matches and extends unmatched right rows.
;   JF2 FULL emits unmatched rows from both inputs exactly once.
;   JF3 CROSS forms the Cartesian product and permits WHERE over present cells.
;   JF4 deleted rows never match and a deleted-only key remains unmatched.
;   JF5 genuine blanks and stored <UNMATCHED> text remain present values.
;   JF6 RIGHT/FULL return equal multisets through CDX seek and scan paths.
;   JF7 both cursors and a caller-owned table lock survive every statement.
;   JF8 RIGHT/FULL WHERE follows ON -> extension -> WHERE and SQL UNKNOWN.
;   JF9 malformed ON forms refuse explicitly.
;   ORACLE SQLite NULL is mapped explicitly to <UNMATCHED>.
;
; Read rule: REGRESSION SQLSEL_JOIN_FAMILY invokes the machine validator.
; A direct DOTSCRIPT run does not validate the paired blocks.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET DELETED OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-JF-BEGIN"

ERASE TABLE SQLJFL CONFIRM
ERASE TABLE SQLJFR CONFIRM

CREATE X64 SQLJFL (ID N(6,0), LVAL C(16))
APPEND
REPLACE ID WITH "1"
REPLACE LVAL WITH "L1A"
APPEND
REPLACE ID WITH "1"
REPLACE LVAL WITH "L1B"
APPEND
REPLACE ID WITH "2"
; LVAL deliberately remains a genuine DBF blank.
APPEND
REPLACE ID WITH "3"
REPLACE LVAL WITH "<UNMATCHED>"
APPEND
REPLACE ID WITH "4"
REPLACE LVAL WITH "GHOSTL"
APPEND
REPLACE ID WITH "6"
REPLACE LVAL WITH "L6_ONLY"
CLOSE

CREATE X64 SQLJFR (ID N(6,0), RVAL C(16))
APPEND
REPLACE ID WITH "1"
REPLACE RVAL WITH "R1A"
APPEND
REPLACE ID WITH "1"
REPLACE RVAL WITH "R1B"
APPEND
REPLACE ID WITH "2"
REPLACE RVAL WITH "R2"
APPEND
REPLACE ID WITH "3"
REPLACE RVAL WITH "GHOSTR"
APPEND
REPLACE ID WITH "4"
REPLACE RVAL WITH "R4_ONLY"
APPEND
REPLACE ID WITH "5"
REPLACE RVAL WITH "R5_ONLY"
APPEND
REPLACE ID WITH "7"
; RVAL deliberately remains a genuine DBF blank.
CLOSE

SELECT 1
USE SQLJFL
GO 5
DELETE
GO 6

SELECT 2
USE SQLJFR
CDX CREATE
CDX ADDTAG ID
BUILDLMDB CLEAN YES
SET INDEX TO SQLJFR
SET ORDER TO TAG ID
GO 4
DELETE
GO 7

SELECT 1
LOCK TABLE
FORMULA "SQLSEL-JF-RIGHT-SEEK-ROWS-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-RIGHT-SEEK-ROWS-END"

FORMULA "SQLSEL-JF-RIGHT-SEEK-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-RIGHT-SEEK-COUNT-END"

? "JF_T1_caller_table_lock_preserved:" + FILE("DBF/SANDBOX/SQLJFL.dbf.lock")
UNLOCK TABLE

FORMULA "SQLSEL-JF-FULL-SEEK-ROWS-BEGIN"
SQLSEL SELECT L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL AS L FULL JOIN SQLJFR AS R ON L.ID = R.ID
FORMULA "SQLSEL-JF-FULL-SEEK-ROWS-END"

FORMULA "SQLSEL-JF-FULL-SEEK-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLJFL L FULL JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-FULL-SEEK-COUNT-END"

FORMULA "SQLSEL-JF-RIGHT-SEEK-WHERE-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID WHERE L.LVAL = "L1A"
FORMULA "SQLSEL-JF-RIGHT-SEEK-WHERE-END"

FORMULA "SQLSEL-JF-FULL-SEEK-WHERE-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L FULL JOIN SQLJFR R ON L.ID = R.ID WHERE L.ID = 6 OR R.ID = 5
FORMULA "SQLSEL-JF-FULL-SEEK-WHERE-END"

SELECT 2
SET ORDER TO 0
GO 7
SELECT 1

FORMULA "SQLSEL-JF-RIGHT-SCAN-ROWS-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-RIGHT-SCAN-ROWS-END"

FORMULA "SQLSEL-JF-RIGHT-SCAN-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-RIGHT-SCAN-COUNT-END"

FORMULA "SQLSEL-JF-FULL-SCAN-ROWS-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L FULL JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-FULL-SCAN-ROWS-END"

FORMULA "SQLSEL-JF-FULL-SCAN-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLJFL L FULL JOIN SQLJFR R ON L.ID = R.ID
FORMULA "SQLSEL-JF-FULL-SCAN-COUNT-END"

FORMULA "SQLSEL-JF-RIGHT-SCAN-WHERE-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L RIGHT JOIN SQLJFR R ON L.ID = R.ID WHERE L.LVAL = "L1A"
FORMULA "SQLSEL-JF-RIGHT-SCAN-WHERE-END"

FORMULA "SQLSEL-JF-FULL-SCAN-WHERE-BEGIN"
SQLSEL L.ID,L.LVAL,R.ID,R.RVAL FROM SQLJFL L FULL JOIN SQLJFR R ON L.ID = R.ID WHERE L.ID = 6 OR R.ID = 5
FORMULA "SQLSEL-JF-FULL-SCAN-WHERE-END"

FORMULA "SQLSEL-JF-CROSS-ROWS-BEGIN"
SQLSEL L.LVAL,R.RVAL FROM SQLJFL L CROSS JOIN SQLJFR R WHERE L.ID = 1 AND R.ID = 1
FORMULA "SQLSEL-JF-CROSS-ROWS-END"

FORMULA "SQLSEL-JF-CROSS-COUNT-BEGIN"
SQLSEL COUNT(*) FROM SQLJFL L CROSS JOIN SQLJFR R
FORMULA "SQLSEL-JF-CROSS-COUNT-END"

SELECT 1
? "JF_C1_left_cursor_restored:" + (ID = 6 AND ALLTRIM(LVAL) = "L6_ONLY")
SELECT 2
? "JF_C2_right_cursor_restored:" + (ID = 7 AND EMPTY(RVAL))

FORMULA "SQLSEL-JF-REFUSALS-BEGIN"
SQLSEL L.LVAL,R.RVAL FROM SQLJFL L CROSS JOIN SQLJFR R ON L.ID = R.ID
SQLSEL L.LVAL,R.RVAL FROM SQLJFL L RIGHT JOIN SQLJFR R
SQLSEL L.LVAL,R.RVAL FROM SQLJFL L FULL JOIN SQLJFR R
FORMULA "SQLSEL-JF-REFUSALS-END"

FORMULA "SQLSEL-JF-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLJFL (ID INTEGER, LVAL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLJFR (ID INTEGER, RVAL TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLJFL VALUES (1,'L1A',0),(1,'L1B',0),(2,'',0),(3,'<UNMATCHED>',0),(4,'GHOSTL',1),(6,'L6_ONLY',0);
SQLITE EXEC INSERT INTO SQLJFR VALUES (1,'R1A',0),(1,'R1B',0),(2,'R2',0),(3,'GHOSTR',1),(4,'R4_ONLY',0),(5,'R5_ONLY',0),(7,'',0);

FORMULA "SQLSEL-JF-O1-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),R.ID,R.RVAL FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O1-END"

FORMULA "SQLSEL-JF-O2-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O2-END"

FORMULA "SQLSEL-JF-O3-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),COALESCE(R.ID,'<UNMATCHED>'),COALESCE(R.RVAL,'<UNMATCHED>') FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O3-END"

FORMULA "SQLSEL-JF-O4-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O4-END"

FORMULA "SQLSEL-JF-O5-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),R.ID,R.RVAL FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O5-END"

FORMULA "SQLSEL-JF-O6-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O6-END"

FORMULA "SQLSEL-JF-O7-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),COALESCE(R.ID,'<UNMATCHED>'),COALESCE(R.RVAL,'<UNMATCHED>') FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O7-END"

FORMULA "SQLSEL-JF-O8-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID;
FORMULA "SQLSEL-JF-O8-END"

FORMULA "SQLSEL-JF-O9-BEGIN"
SQLITE SELECT SELECT L.LVAL,R.RVAL FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L CROSS JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R WHERE L.ID=1 AND R.ID=1;
FORMULA "SQLSEL-JF-O9-END"

FORMULA "SQLSEL-JF-O10-BEGIN"
SQLITE SELECT SELECT COUNT(*) FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L CROSS JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R;
FORMULA "SQLSEL-JF-O10-END"

FORMULA "SQLSEL-JF-O11-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),R.ID,R.RVAL FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID WHERE L.LVAL='L1A';
FORMULA "SQLSEL-JF-O11-END"

FORMULA "SQLSEL-JF-O12-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),COALESCE(R.ID,'<UNMATCHED>'),COALESCE(R.RVAL,'<UNMATCHED>') FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID WHERE L.ID=6 OR R.ID=5;
FORMULA "SQLSEL-JF-O12-END"

FORMULA "SQLSEL-JF-O13-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),R.ID,R.RVAL FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L RIGHT JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID WHERE L.LVAL='L1A';
FORMULA "SQLSEL-JF-O13-END"

FORMULA "SQLSEL-JF-O14-BEGIN"
SQLITE SELECT SELECT COALESCE(L.ID,'<UNMATCHED>'),COALESCE(L.LVAL,'<UNMATCHED>'),COALESCE(R.ID,'<UNMATCHED>'),COALESCE(R.RVAL,'<UNMATCHED>') FROM (SELECT ID,LVAL FROM SQLJFL WHERE D=0) L FULL JOIN (SELECT ID,RVAL FROM SQLJFR WHERE D=0) R ON L.ID=R.ID WHERE L.ID=6 OR R.ID=5;
FORMULA "SQLSEL-JF-O14-END"

SQLITE CLOSE
FORMULA "SQLSEL-JF-ORACLE-END"

SELECT 2
CLOSE
SELECT 1
CLOSE
ERASE TABLE SQLJFL CONFIRM
ERASE TABLE SQLJFR CONFIRM

SET DELETED ON
FORMULA "SQLSEL-JF-END"
