; ============================================================================
; AIF-074 P4.5 -- SQLsel DISTINCT and typed set operations
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; three fixtures self-erase)
;
; Proves:
;   SO1 SELECT DISTINCT removes live duplicate TupleRows.
;   SO2 UNION removes duplicates; UNION ALL preserves them.
;   SO3 INTERSECT and EXCEPT use SQL distinct-set semantics.
;   SO4 INTERSECT binds more tightly than UNION and EXCEPT.
;   SO5 date-valued operands stay typed and compare as dates.
;   SO6 column-count and typed-family mismatches refuse explicitly.
;   SO7 deleted rows stay excluded and all three cursors are restored.
;   ORACLE seven marked SQLsel row multisets equal SQLite.
;
; Read rule: REGRESSION SQLSEL_SET_OPS must print
;   SQLSEL SET OPERATIONS ORACLE: PASS.
; Missing or empty blocks, row mismatch, a changed operation count, missing
; refusal, or cursor drift fails closed. Direct DOTSCRIPT execution prints the
; evidence but does not invoke the REGRESSION validator.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-SO-BEGIN"

ERASE TABLE SQLSETA CONFIRM
ERASE TABLE SQLSETB CONFIRM
ERASE TABLE SQLSETC CONFIRM

CREATE X64 SQLSETA (ID N(6,0), TXT C(12), DVAL D)
APPEND
REPLACE ID WITH "1"
REPLACE TXT WITH "ALPHA"
REPLACE DVAL WITH "20240101"
APPEND
REPLACE ID WITH "1"
REPLACE TXT WITH "ALPHA"
REPLACE DVAL WITH "20240101"
APPEND
REPLACE ID WITH "2"
REPLACE TXT WITH "BETA"
REPLACE DVAL WITH "20240102"
APPEND
REPLACE ID WITH "3"
REPLACE TXT WITH "GAMMA"
REPLACE DVAL WITH "20240103"
APPEND
REPLACE ID WITH "4"
APPEND
REPLACE ID WITH "8"
REPLACE TXT WITH "DELETED_A"
REPLACE DVAL WITH "20240108"
DELETE
CLOSE

CREATE X64 SQLSETB (ID N(6,0), TXT C(12), DVAL D)
APPEND
REPLACE ID WITH "2"
REPLACE TXT WITH "BETA"
REPLACE DVAL WITH "20240102"
APPEND
REPLACE ID WITH "3"
REPLACE TXT WITH "GAMMA"
REPLACE DVAL WITH "20240103"
APPEND
REPLACE ID WITH "3"
REPLACE TXT WITH "GAMMA"
REPLACE DVAL WITH "20240103"
APPEND
REPLACE ID WITH "4"
REPLACE TXT WITH "DELTA"
REPLACE DVAL WITH "20240104"
APPEND
REPLACE ID WITH "5"
APPEND
REPLACE ID WITH "9"
REPLACE TXT WITH "DELETED_B"
REPLACE DVAL WITH "20240109"
DELETE
CLOSE

CREATE X64 SQLSETC (ID N(6,0), TXT C(12), DVAL D)
APPEND
REPLACE ID WITH "4"
REPLACE TXT WITH "DELTA"
REPLACE DVAL WITH "20240104"
CLOSE

SELECT 1
USE SQLSETA
GO 3
SELECT 2
USE SQLSETB
GO 4
SELECT 3
USE SQLSETC
GO 1

FORMULA "SQLSEL-SO-DISTINCT-BEGIN"
SQLSEL SELECT DISTINCT ID,TXT FROM SQLSETA
FORMULA "SQLSEL-SO-DISTINCT-END"

FORMULA "SQLSEL-SO-UNION-BEGIN"
SQLSEL SELECT ID,TXT FROM SQLSETA UNION SELECT ID,TXT FROM SQLSETB
FORMULA "SQLSEL-SO-UNION-END"

FORMULA "SQLSEL-SO-UNION-ALL-BEGIN"
SQLSEL SELECT ID,TXT FROM SQLSETA UNION ALL SELECT ID,TXT FROM SQLSETB
FORMULA "SQLSEL-SO-UNION-ALL-END"

FORMULA "SQLSEL-SO-INTERSECT-BEGIN"
SQLSEL SELECT ID,TXT FROM SQLSETA INTERSECT SELECT ID,TXT FROM SQLSETB
FORMULA "SQLSEL-SO-INTERSECT-END"

FORMULA "SQLSEL-SO-EXCEPT-BEGIN"
SQLSEL SELECT ID,TXT FROM SQLSETA EXCEPT SELECT ID,TXT FROM SQLSETB
FORMULA "SQLSEL-SO-EXCEPT-END"

FORMULA "SQLSEL-SO-PRECEDENCE-BEGIN"
SQLSEL SELECT ID,TXT FROM SQLSETA UNION SELECT ID,TXT FROM SQLSETB INTERSECT SELECT ID,TXT FROM SQLSETC
FORMULA "SQLSEL-SO-PRECEDENCE-END"

FORMULA "SQLSEL-SO-DATE-BEGIN"
SQLSEL SELECT DVAL FROM SQLSETA WHERE ID < 4 UNION SELECT DVAL FROM SQLSETB WHERE ID < 4
FORMULA "SQLSEL-SO-DATE-END"

SELECT 1
? "SO_C1_left_cursor_restored:" + (ID = 2 AND ALLTRIM(TXT) = "BETA")
SELECT 2
? "SO_C2_right_cursor_restored:" + (ID = 4 AND ALLTRIM(TXT) = "DELTA")
SELECT 3
? "SO_C3_third_cursor_restored:" + (ID = 4 AND ALLTRIM(TXT) = "DELTA")

FORMULA "SQLSEL-SO-REFUSALS-BEGIN"
SQLSEL SELECT ID FROM SQLSETA UNION SELECT ID,TXT FROM SQLSETB
SQLSEL SELECT ID FROM SQLSETA UNION SELECT TXT FROM SQLSETB
SQLSEL SELECT DVAL FROM SQLSETA UNION SELECT TXT FROM SQLSETB
SQLSEL SELECT ID FROM SQLSETA INTERSECT ALL SELECT ID FROM SQLSETB
SQLSEL SELECT ID FROM SQLSETA UNION
SQLSEL SELECT ID FROM SQLSETA UNION SELECT ID FROM SQLSETB ORDER BY ID
FORMULA "SQLSEL-SO-REFUSALS-END"

FORMULA "SQLSEL-SO-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLSETA (ID INTEGER, TXT TEXT, DVAL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLSETB (ID INTEGER, TXT TEXT, DVAL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLSETC (ID INTEGER, TXT TEXT, DVAL TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLSETA VALUES (1,'ALPHA','20240101',0),(1,'ALPHA','20240101',0),(2,'BETA','20240102',0),(3,'GAMMA','20240103',0),(4,'','',0),(8,'DELETED_A','20240108',1);
SQLITE EXEC INSERT INTO SQLSETB VALUES (2,'BETA','20240102',0),(3,'GAMMA','20240103',0),(3,'GAMMA','20240103',0),(4,'DELTA','20240104',0),(5,'','',0),(9,'DELETED_B','20240109',1);
SQLITE EXEC INSERT INTO SQLSETC VALUES (4,'DELTA','20240104',0);

FORMULA "SQLSEL-SO-O1-BEGIN"
SQLITE SELECT SELECT DISTINCT ID,TXT FROM SQLSETA WHERE D=0;
FORMULA "SQLSEL-SO-O1-END"

FORMULA "SQLSEL-SO-O2-BEGIN"
SQLITE SELECT SELECT ID,TXT FROM SQLSETA WHERE D=0 UNION SELECT ID,TXT FROM SQLSETB WHERE D=0;
FORMULA "SQLSEL-SO-O2-END"

FORMULA "SQLSEL-SO-O3-BEGIN"
SQLITE SELECT SELECT ID,TXT FROM SQLSETA WHERE D=0 UNION ALL SELECT ID,TXT FROM SQLSETB WHERE D=0;
FORMULA "SQLSEL-SO-O3-END"

FORMULA "SQLSEL-SO-O4-BEGIN"
SQLITE SELECT SELECT ID,TXT FROM SQLSETA WHERE D=0 INTERSECT SELECT ID,TXT FROM SQLSETB WHERE D=0;
FORMULA "SQLSEL-SO-O4-END"

FORMULA "SQLSEL-SO-O5-BEGIN"
SQLITE SELECT SELECT ID,TXT FROM SQLSETA WHERE D=0 EXCEPT SELECT ID,TXT FROM SQLSETB WHERE D=0;
FORMULA "SQLSEL-SO-O5-END"

FORMULA "SQLSEL-SO-O6-BEGIN"
SQLITE SELECT SELECT ID,TXT FROM SQLSETA WHERE D=0 UNION SELECT ID,TXT FROM (SELECT ID,TXT FROM SQLSETB WHERE D=0 INTERSECT SELECT ID,TXT FROM SQLSETC WHERE D=0);
FORMULA "SQLSEL-SO-O6-END"

FORMULA "SQLSEL-SO-O7-BEGIN"
SQLITE SELECT SELECT DVAL FROM SQLSETA WHERE D=0 AND ID<4 UNION SELECT DVAL FROM SQLSETB WHERE D=0 AND ID<4;
FORMULA "SQLSEL-SO-O7-END"

SQLITE CLOSE
FORMULA "SQLSEL-SO-ORACLE-END"

CLOSE ALL
ERASE TABLE SQLSETA CONFIRM
ERASE TABLE SQLSETB CONFIRM
ERASE TABLE SQLSETC CONFIRM

FORMULA "SQLSEL-SO-END"
