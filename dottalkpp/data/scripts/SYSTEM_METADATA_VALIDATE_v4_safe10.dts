* ============================================================
* SYSTEM_METADATA_VALIDATE_v4_safe10.dts
*
* Purpose:
*   Read back seeded metadata rows through indexed x64/CDX/LMDB paths.
* ============================================================

SET ECHO OFF
SET PAGING OFF

DO metadata

? "===== VALIDATE SYSTEM_COMMANDS ====="
USE SYSTEM_COMMANDS
SET INDEX TO SYSTEM_COMMANDS
SET ORDER TO CAN_NAME
LIST

? "===== VALIDATE SYSTEM_SUBCOMMANDS ====="
USE SYSTEM_SUBCOMMANDS
SET INDEX TO SYSTEM_SUBCOMMANDS
SET ORDER TO QUAL_NAME
LIST

? "===== VALIDATE SYSTEM_ENTRY_VARIANTS ====="
USE SYSTEM_ENTRY_VARIANTS
SET INDEX TO SYSTEM_ENTRY_VARIANTS
SET ORDER TO TOKEN
LIST

? "===== VALIDATE SYSTEM_HELP_TEXT MEMOS ====="
USE SYSTEM_HELP_TEXT
SET INDEX TO SYSTEM_HELP_TEXT
SET ORDER TO OWNER_NAM
DISPLAY

? "===== VALIDATE SYSTEM_FIELD_DICT MEMOS ====="
USE SYSTEM_FIELD_DICT
SET INDEX TO SYSTEM_FIELD_DICT
SET ORDER TO LOG_NAME
DISPLAY

? "===== SYSTEM METADATA VALIDATE V4 SAFE10 COMPLETE ====="
