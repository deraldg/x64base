; ============================================================================
; AIF-074 G2 -- SQLsel library + session mode router
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; two fixtures self-erase)
;
; Proves:
;   M1 process startup defaults to NATIVE and mode changes are session-only.
;   M2 SELECT is the SQLSEL alias only in SQL mode; SQLSEL stays canonical.
;   M3 OTHER and NATIVE preserve native SELECT work-area behavior.
;   M4 SQL mode blocks REL and SET RELATION through one corrective message.
;   M5 statement evaluation preserves the current work area and cursor.
;   ORACLE two ordered row sets equal SQLite.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET PATH DBF DBF/SANDBOX

FORMULA "SQLMODE-BEGIN"
SET MODE
ERASE TABLE SQLMODEA CONFIRM
ERASE TABLE SQLMODEB CONFIRM

CREATE X64 SQLMODEA (ID N(6,0), NAME C(12))
APPEND
REPLACE ID WITH "1"
REPLACE NAME WITH "ALPHA"
APPEND
REPLACE ID WITH "2"
REPLACE NAME WITH "BETA"
CLOSE

CREATE X64 SQLMODEB (ID N(6,0), NAME C(12))
APPEND
REPLACE ID WITH "99"
REPLACE NAME WITH "OTHER"
CLOSE

SELECT 1
USE SQLMODEA
GO 1
SELECT 2
USE SQLMODEB
GO 1
SELECT 1
? "SQLMODE_C0_native_default_select:" + (ID = 1 AND ALLTRIM(NAME) = "ALPHA")

SET MODE SQL
FORMULA "SQLMODE-SELECT-ALIAS-BEGIN"
SELECT ID,NAME FROM SQLMODEA WHERE ID = 2 ORDER BY ID
FORMULA "SQLMODE-SELECT-ALIAS-END"
FORMULA "SQLMODE-CANONICAL-BEGIN"
SQLSEL ID,NAME FROM SQLMODEA WHERE ID = 2 ORDER BY ID
FORMULA "SQLMODE-CANONICAL-END"
? "SQLMODE_C1_sql_query_cursor_restored:" + (ID = 1 AND ALLTRIM(NAME) = "ALPHA")

FORMULA "SQLMODE-REFUSALS-BEGIN"
REL LIST
SET RELATION OFF ALL
FORMULA "SQLMODE-REFUSALS-END"

FORMULA "SQLMODE-EXPR-REFUSAL-BEGIN"
1+1
FORMULA "SQLMODE-EXPR-REFUSAL-END"

SET MODE OTHER
SELECT 2
? "SQLMODE_C2_other_keeps_native_select:" + (ID = 99 AND ALLTRIM(NAME) = "OTHER")
SET MODE NATIVE
SELECT 1
? "SQLMODE_C3_native_select_restored:" + (ID = 1 AND ALLTRIM(NAME) = "ALPHA")

FORMULA "SQLMODE-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLMODEA (ID INTEGER,NAME TEXT);
SQLITE EXEC INSERT INTO SQLMODEA VALUES (1,'ALPHA'),(2,'BETA');
FORMULA "SQLMODE-O1-BEGIN"
SQLITE SELECT SELECT ID,NAME FROM SQLMODEA WHERE ID=2 ORDER BY ID;
FORMULA "SQLMODE-O1-END"
FORMULA "SQLMODE-O2-BEGIN"
SQLITE SELECT SELECT ID,NAME FROM SQLMODEA WHERE ID=2 ORDER BY ID;
FORMULA "SQLMODE-O2-END"
SQLITE CLOSE
FORMULA "SQLMODE-ORACLE-END"

CLOSE ALL
ERASE TABLE SQLMODEA CONFIRM
ERASE TABLE SQLMODEB CONFIRM
FORMULA "SQLMODE-END"
