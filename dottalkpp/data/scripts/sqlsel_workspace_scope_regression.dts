; ============================================================================
; AIF-074 -- SQLsel table names are scoped to the current workspace
;
; Status: CANDIDATE / explicit-run / mints_catalog
; Safety: MUTATING (isolated workspace catalog + SANDBOX fixtures; self-erases)
;
; Two simultaneously open workspaces contain the same table names and different
; typed values. SELECT, JOIN, and UPDATE must resolve only inside the workspace
; carried by the current area. Lowest-engine-slot first-wins would make the B
; queries and B UPDATE hit A, so all four oracle blocks are discriminators.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
WORKSPACE CLOSE ALL
WORKSPACE DESTROY SQLWSA
WORKSPACE DESTROY SQLWSB

SET PATH DBF DBF/SANDBOX/SQLWSA
ERASE SQLWSP CONFIRM
ERASE SQLWSC CONFIRM
SELECT 0
CREATE X64 SQLWSP (ID N(6,0), MARK C(12))
APPEND
REPLACE ID WITH 1
REPLACE MARK WITH 'A_PARENT'
APPEND
REPLACE ID WITH 2
REPLACE MARK WITH 'A_PARK'
SELECT 1
CREATE X64 SQLWSC (ID N(6,0), DETAIL C(12))
APPEND
REPLACE ID WITH 1
REPLACE DETAIL WITH 'A_CHILD'
APPEND
REPLACE ID WITH 2
REPLACE DETAIL WITH 'A_C_PARK'
CLOSE ALL

SET PATH DBF DBF/SANDBOX/SQLWSB
SELECT 0
CREATE X64 SQLWSP (ID N(6,0), MARK C(12))
APPEND
REPLACE ID WITH 1
REPLACE MARK WITH 'B_PARENT'
APPEND
REPLACE ID WITH 2
REPLACE MARK WITH 'B_PARK'
SELECT 1
CREATE X64 SQLWSC (ID N(6,0), DETAIL C(12))
APPEND
REPLACE ID WITH 1
REPLACE DETAIL WITH 'B_CHILD'
APPEND
REPLACE ID WITH 2
REPLACE DETAIL WITH 'B_C_PARK'
WORKSPACE CLOSE ALL

SET PATH DBF DBF
WORKSPACE OPEN DBF/SANDBOX/SQLWSA AS SQLWSA
WORKSPACE OPEN DBF/SANDBOX/SQLWSB AS SQLWSB

; Alphabetical: SQLWSC then SQLWSP in each workspace.
SELECT 0
GO 2
SELECT 1
GO 2
FORMULA "SQLSEL-WS-S1-BEGIN"
SQLSEL SELECT P.ID,P.MARK,C.DETAIL FROM SQLWSP P JOIN SQLWSC C ON P.ID = C.ID WHERE P.ID = 1
FORMULA "SQLSEL-WS-S1-END"
? "SQLWS_C1_A_parent_cursor_restored:" + (ID = 2 AND ALLTRIM(MARK) = 'A_PARK')
SELECT 0
? "SQLWS_C2_A_child_cursor_restored:" + (ID = 2 AND ALLTRIM(DETAIL) = 'A_C_PARK')

SELECT 2
GO 2
SELECT 3
GO 2
SELECT 2
FORMULA "SQLSEL-WS-S2-BEGIN"
SQLSEL SELECT P.ID,P.MARK,C.DETAIL FROM SQLWSP P JOIN SQLWSC C ON P.ID = C.ID WHERE P.ID = 1
FORMULA "SQLSEL-WS-S2-END"
? "SQLWS_C3_B_child_cursor_restored:" + (ID = 2 AND ALLTRIM(DETAIL) = 'B_C_PARK')
SELECT 3
? "SQLWS_C4_B_parent_cursor_restored:" + (ID = 2 AND ALLTRIM(MARK) = 'B_PARK')

; The current area belongs to B, so this must modify B despite A owning the
; lower engine slots with the same logical table name.
SQLSEL UPDATE SQLWSP SET MARK = 'B_DONE' WHERE ID = 1
SELECT 0
FORMULA "SQLSEL-WS-S3-BEGIN"
SQLSEL SELECT ID,MARK FROM SQLWSP WHERE ID = 1
FORMULA "SQLSEL-WS-S3-END"
SELECT 2
FORMULA "SQLSEL-WS-S4-BEGIN"
SQLSEL SELECT ID,MARK FROM SQLWSP WHERE ID = 1
FORMULA "SQLSEL-WS-S4-END"

FORMULA "SQLSEL-WS-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE AP (ID INTEGER,MARK TEXT);
SQLITE EXEC CREATE TABLE AC (ID INTEGER,DETAIL TEXT);
SQLITE EXEC CREATE TABLE BP (ID INTEGER,MARK TEXT);
SQLITE EXEC CREATE TABLE BC (ID INTEGER,DETAIL TEXT);
SQLITE EXEC INSERT INTO AP VALUES (1,'A_PARENT'),(2,'A_PARK');
SQLITE EXEC INSERT INTO AC VALUES (1,'A_CHILD'),(2,'A_C_PARK');
SQLITE EXEC INSERT INTO BP VALUES (1,'B_PARENT'),(2,'B_PARK');
SQLITE EXEC INSERT INTO BC VALUES (1,'B_CHILD'),(2,'B_C_PARK');
FORMULA "SQLSEL-WS-O1-BEGIN"
SQLITE SELECT SELECT P.ID,P.MARK,C.DETAIL FROM AP P JOIN AC C ON P.ID=C.ID WHERE P.ID=1;
FORMULA "SQLSEL-WS-O1-END"
FORMULA "SQLSEL-WS-O2-BEGIN"
SQLITE SELECT SELECT P.ID,P.MARK,C.DETAIL FROM BP P JOIN BC C ON P.ID=C.ID WHERE P.ID=1;
FORMULA "SQLSEL-WS-O2-END"
FORMULA "SQLSEL-WS-O3-BEGIN"
SQLITE SELECT SELECT ID,MARK FROM AP WHERE ID=1;
FORMULA "SQLSEL-WS-O3-END"
SQLITE EXEC UPDATE BP SET MARK='B_DONE' WHERE ID=1;
FORMULA "SQLSEL-WS-O4-BEGIN"
SQLITE SELECT SELECT ID,MARK FROM BP WHERE ID=1;
FORMULA "SQLSEL-WS-O4-END"
SQLITE CLOSE
FORMULA "SQLSEL-WS-ORACLE-END"

WORKSPACE CLOSE ALL
WORKSPACE DESTROY SQLWSA
WORKSPACE DESTROY SQLWSB
SET PATH DBF DBF/SANDBOX/SQLWSA
ERASE SQLWSP CONFIRM
ERASE SQLWSC CONFIRM
SET PATH DBF DBF/SANDBOX/SQLWSB
ERASE SQLWSP CONFIRM
ERASE SQLWSC CONFIRM
SET PATH DBF DBF
