* ============================================================
* MCC MUTATION X32 DISPOSABLE CANARY
* ============================================================
* Purpose:
*   Extensive reversible mutation coverage for MCC x32/CNX.
*
* Rules:
*   - Bootstraps its own environment.
*   - Uses disposable table copies only.
*   - Builds disposable CNX containers explicitly.
*   - Verifies workspace/index bring-up, append, replace,
*     multirep, calcwrite, table-buffer commit/rollback,
*     delete/recall, and pack.
* ============================================================

SET ECHO ON
SET DELETED ON

ECHO ============================================================
ECHO MCC MUTATION X32 DISPOSABLE CANARY
ECHO ============================================================

ERASE students_mut_canary_x32 CONFIRM
ERASE students_mut_canary_x32.cnx CONFIRM
ERASE students_mut_canary_x32.inx CONFIRM
ERASE enroll_mut_canary_x32 CONFIRM
ERASE enroll_mut_canary_x32.cnx CONFIRM
ERASE enroll_mut_canary_x32.inx CONFIRM

SET PATH DBF DBF/x32
SET PATH INDEXES INDEXES/x32
WORKSPACE CLOSE
WORKSPACE LOAD mcc_x32

ECHO --- WORKSPACE AUTO-ATTACH PROBE: STUDENTS / ENROLL ---
SELECT STUDENTS
AREA
SELECT ENROLL
AREA

ECHO --- STUDENTS COPY / CNX BUILD ---
SELECT STUDENTS
COPY TO students_mut_canary_x32 OVERWRITE
CLOSE
USE students_mut_canary_x32
CNX CREATE
CNX ADDTAG SID
CNX ADDTAG LNAME
REBUILD
SET INDEX TO students_mut_canary_x32
SET ORDER TO TAG SID
TOP
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS APPEND / FILL / SEEK ---
APPEND
BOTTOM
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL
REPLACE LNAME WITH "CANARY_X32"
REPLACE FNAME WITH "ALPHA"
CALCWRITE DOB = CTOD("2001-01-02")
REPLACE DOB WITH "20010103"
REPLACE GENDER WITH "X"
REPLACE MAJOR WITH "CSCI"
CALCWRITE ENROLL_D = CTOD("2026-01-15")
CALCWRITE GPA = 3.25
REPLACE EMAIL WITH "canary_x32@mcc.edu"
SET ORDER TO TAG LNAME
SEEK CANARY_X32
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS INDEXED FIELD MUTATION ---
REPLACE LNAME WITH "CANARY_X32B"
SEEK CANARY_X32B
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS MULTIREP / CALCWRITE ---
MULTIREP FNAME WITH "BETA", EMAIL WITH "canary_x32b@mcc.edu"
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL
CALCWRITE GPA = GPA + 0.25
TUPLE GPA
CALCWRITE GPA = GPA - 0.25
TUPLE GPA

ECHO --- STUDENTS TABLE BUFFER ROLLBACK ---
TABLE ON
REPLACE MAJOR WITH "ZZRB"
TUPLE MAJOR
ROLLBACK
TUPLE MAJOR
TABLE OFF

ECHO --- STUDENTS TABLE BUFFER COMMIT ---
TABLE ON
REPLACE MAJOR WITH "ZZCM"
COMMIT
TUPLE MAJOR
TABLE OFF
REPLACE MAJOR WITH "CSCI"
TUPLE MAJOR

ECHO --- STUDENTS DELETE / RECALL / PACK ---
SET ORDER TO TAG LNAME
SEEK CANARY_X32B
DELETE
COUNT DELETED
RECALL
COUNT DELETED
SEEK CANARY_X32B
DELETE
PACK
COUNT FOR LNAME = "CANARY_X32B"
CLOSE
ERASE students_mut_canary_x32 CONFIRM
ERASE students_mut_canary_x32.cnx CONFIRM
ERASE students_mut_canary_x32.inx CONFIRM

ECHO --- ENROLL COPY / CNX BUILD ---
SELECT ENROLL
COPY TO enroll_mut_canary_x32 OVERWRITE
CLOSE
USE enroll_mut_canary_x32
CNX CREATE
CNX ADDTAG SID
CNX ADDTAG CLS_ID
REBUILD
SET INDEX TO enroll_mut_canary_x32
SET ORDER TO TAG SID
TOP
TUPLE SID,CLS_ID,GRADE

ECHO --- ENROLL APPEND / FILL / SEEK ---
APPEND
BOTTOM
TUPLE SID,CLS_ID,GRADE
REPLACE CLS_ID WITH "X32C9001"
REPLACE GRADE WITH "A-"
SET ORDER TO TAG CLS_ID
SEEK X32C9001
TUPLE SID,CLS_ID,GRADE

ECHO --- ENROLL MUTATE / RECALL / PACK ---
MULTIREP GRADE WITH "B+"
TUPLE SID,CLS_ID,GRADE
DELETE
COUNT DELETED
RECALL
COUNT DELETED
DELETE
PACK
COUNT FOR CLS_ID = "X32C9001"
CLOSE
ERASE enroll_mut_canary_x32 CONFIRM
ERASE enroll_mut_canary_x32.cnx CONFIRM
ERASE enroll_mut_canary_x32.inx CONFIRM

WORKSPACE CLOSE

ECHO ============================================================
ECHO MCC MUTATION X32 DISPOSABLE CANARY DONE
ECHO ============================================================
