* ============================================================
* MCC MUTATION X64 DISPOSABLE CANARY
* ============================================================
* Purpose:
*   Extensive reversible mutation coverage for MCC X64/CDX/LMDB.
*
* Rules:
*   - Bootstraps its own environment.
*   - Uses disposable table copies only.
*   - Builds disposable CDX/LMDB containers explicitly.
*   - Verifies workspace/index bring-up, append, replace,
*     multirep, calcwrite, table-buffer commit/rollback,
*     delete/recall, and pack.
* ============================================================

SET ECHO ON
SET DELETED ON

ECHO ============================================================
ECHO MCC MUTATION X64 DISPOSABLE CANARY
ECHO ============================================================

ERASE students_mut_canary_x64 CONFIRM
ERASE students_mut_canary_x64.cdx CONFIRM
ERASE enroll_mut_canary_x64 CONFIRM
ERASE enroll_mut_canary_x64.cdx CONFIRM

SET PATH DBF DBF/x64
SET PATH INDEXES INDEXES/x64
SET PATH LMDB LMDB/x64
WORKSPACE CLOSE
WORKSPACE LOAD mcc_x64

ECHO --- WORKSPACE AUTO-ATTACH PROBE: STUDENTS / ENROLL ---
SELECT STUDENTS
AREA
SELECT ENROLL
AREA

ECHO --- STUDENTS COPY / CDX BUILD ---
SELECT STUDENTS
COPY TO students_mut_canary_x64 OVERWRITE
CLOSE
USE students_mut_canary_x64
CDX CREATE
CDX ADDTAG SID
CDX ADDTAG LNAME
BUILDLMDB AUTO
SET INDEX TO students_mut_canary_x64
SET ORDER TO TAG SID
TOP
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS APPEND / FILL / SEEK ---
APPEND
BOTTOM
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL
REPLACE LNAME WITH "CANARY_X64"
REPLACE FNAME WITH "ALPHA"
CALCWRITE DOB = CTOD("2001-01-04")
REPLACE DOB WITH "20010105"
REPLACE GENDER WITH "X"
REPLACE MAJOR WITH "CSCI"
CALCWRITE ENROLL_D = CTOD("2026-01-17")
CALCWRITE GPA = 3.45
REPLACE EMAIL WITH "canary_x64@mcc.edu"
SET ORDER TO TAG LNAME
SEEK CANARY_X64
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS INDEXED FIELD MUTATION ---
REPLACE LNAME WITH "CANARY_X64B"
SEEK CANARY_X64B
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL

ECHO --- STUDENTS MULTIREP / CALCWRITE ---
MULTIREP FNAME WITH "BETA", EMAIL WITH "canary_x64b@mcc.edu"
TUPLE SID,LNAME,FNAME,DOB,MAJOR,GPA,EMAIL
CALCWRITE GPA = GPA + 0.25
TUPLE GPA
CALCWRITE GPA = GPA - 0.25
TUPLE GPA

ECHO --- STUDENTS TABLE BUFFER ROLLBACK ---
TABLE ON
REPLACE MAJOR WITH "ZZRB"
TUPLE MAJOR
ROLLBACK
TUPLE MAJOR
TABLE OFF

ECHO --- STUDENTS TABLE BUFFER COMMIT ---
TABLE ON
REPLACE MAJOR WITH "ZZCM"
COMMIT
TUPLE MAJOR
TABLE OFF
REPLACE MAJOR WITH "CSCI"
TUPLE MAJOR

ECHO --- STUDENTS DELETE / RECALL / PACK ---
SET ORDER TO TAG LNAME
SEEK CANARY_X64B
DELETE
COUNT DELETED
RECALL
COUNT DELETED
SEEK CANARY_X64B
DELETE
PACK
COUNT FOR LNAME = "CANARY_X64B"
CLOSE
ERASE students_mut_canary_x64 CONFIRM
ERASE students_mut_canary_x64.cdx CONFIRM

ECHO --- ENROLL COPY / CDX BUILD ---
SELECT ENROLL
COPY TO enroll_mut_canary_x64 OVERWRITE
CLOSE
USE enroll_mut_canary_x64
CDX CREATE
CDX ADDTAG SID
CDX ADDTAG CLS_ID
BUILDLMDB AUTO
SET INDEX TO enroll_mut_canary_x64
SET ORDER TO TAG SID
TOP
TUPLE SID,CLS_ID,GRADE

ECHO --- ENROLL APPEND / FILL / SEEK ---
APPEND
BOTTOM
TUPLE SID,CLS_ID,GRADE
REPLACE CLS_ID WITH "X64C9001"
REPLACE GRADE WITH "A-"
SET ORDER TO TAG CLS_ID
SEEK X64C9001
TUPLE SID,CLS_ID,GRADE

ECHO --- ENROLL MUTATE / RECALL / PACK ---
MULTIREP GRADE WITH "B+"
TUPLE SID,CLS_ID,GRADE
DELETE
COUNT DELETED
RECALL
COUNT DELETED
DELETE
PACK
COUNT FOR CLS_ID = "X64C9001"
CLOSE
ERASE enroll_mut_canary_x64 CONFIRM
ERASE enroll_mut_canary_x64.cdx CONFIRM

WORKSPACE CLOSE

ECHO ============================================================
ECHO MCC MUTATION X64 DISPOSABLE CANARY DONE
ECHO ============================================================
