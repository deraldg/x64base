* ------------------------------------------------------------
* 06. Reset to en-US
* ------------------------------------------------------------
SET LANGUAGE en-US
ECHO --- en-US : stable result-payload boundary probe ---
INDEXSEEK "__RESULT_CHANNEL_AUDIT__"
ECHO === LANGUAGE SHAKEDOWN CANARY DONE ===
