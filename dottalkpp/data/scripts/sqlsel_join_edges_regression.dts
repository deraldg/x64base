; ============================================================================
; AIF-074 P4.2 -- adversarial SQLsel INNER JOIN paths and edge semantics
;
; Status: CANDIDATE / explicit-run
; Safety: MUTATING (SANDBOX only; four fixtures and sidecars self-erase)
;
; Proves:
;   JE1 numeric duplicate keys multiply rows on seek and scan paths.
;   JE2 deleted outer and inner rows never enter SQLsel results, even while
;       SET DELETED OFF makes them visible to the surrounding xBase session.
;   JE3 an unmatched outer and an unmatched inner key add no rows.
;   JE4 CDX character-key case collisions are candidates, not matches: SQLsel
;       re-verifies landed rows with its typed ON equality.
;   JE5 an active tag on the wrong inner field selects scan, not false seek.
;   JE6 four source cursors survive all successful and refused statements.
;   JE7 duplicate aliases, same-side ON, a second JOIN, and self-join refuse.
;   ORACLE four marked SQLsel row sets equal SQLite.
;
; Read rule: REGRESSION SQLSEL_JOIN_EDGES must print
;   SQLSEL JOIN EDGES ORACLE: PASS.
; The validator requires exactly 2 CDX seek, 2 nested-loop scan, 0 hybrid and
; exact probe/candidate counts. Same rows through an unproven path are a FAIL.
; A direct DOTSCRIPT run prints evidence but does not invoke the validator.
; ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF
SET DELETED OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-JE-BEGIN"

ERASE TABLE SQLJNL CONFIRM
ERASE TABLE SQLJNR CONFIRM
ERASE TABLE SQLJCL CONFIRM
ERASE TABLE SQLJCR CONFIRM

; Numeric outer: row 4 is deleted and would multiply ID=1 if it leaked.
CREATE X64 SQLJNL (ID N(6,0), LBL C(8))
APPEND
REPLACE ID WITH "1"
REPLACE LBL WITH "L1"
APPEND
REPLACE ID WITH "2"
REPLACE LBL WITH "L2"
APPEND
REPLACE ID WITH "3"
REPLACE LBL WITH "L3"
APPEND
REPLACE ID WITH "1"
REPLACE LBL WITH "GHOSTL"
CLOSE

; Numeric inner: ID=1 duplicates, row 3 is a deleted-only match for ID=2,
; and ID=9 is unmatched on the inner side.
CREATE X64 SQLJNR (ID N(6,0), PAYLOAD C(8))
APPEND
REPLACE ID WITH "1"
REPLACE PAYLOAD WITH "R1A"
APPEND
REPLACE ID WITH "1"
REPLACE PAYLOAD WITH "R1B"
APPEND
REPLACE ID WITH "2"
REPLACE PAYLOAD WITH "GHOSTR"
APPEND
REPLACE ID WITH "3"
REPLACE PAYLOAD WITH "R3"
APPEND
REPLACE ID WITH "9"
REPLACE PAYLOAD WITH "ORPHAN"
CLOSE

; Character outer: row 4 is deleted. Case is deliberately significant to ON.
CREATE X64 SQLJCL (CKEY C(4), LBL C(8))
APPEND
REPLACE CKEY WITH "aa"
REPLACE LBL WITH "C1"
APPEND
REPLACE CKEY WITH "AA"
REPLACE LBL WITH "C2"
APPEND
REPLACE CKEY WITH "Bb"
REPLACE LBL WITH "C3"
APPEND
REPLACE CKEY WITH "aa"
REPLACE LBL WITH "GHOSTC"
CLOSE

; CDX normalizes character keys to uppercase. The three aa/AA rows and the
; two BB/Bb rows collide in the index, so only row revalidation can produce
; the case-sensitive SQLsel/SQLite answer.
CREATE X64 SQLJCR (CKEY C(4), ALT C(4), PAYLOAD C(8))
APPEND
REPLACE CKEY WITH "aa"
REPLACE ALT WITH "A1"
REPLACE PAYLOAD WITH "lower1"
APPEND
REPLACE CKEY WITH "aa"
REPLACE ALT WITH "A2"
REPLACE PAYLOAD WITH "lower2"
APPEND
REPLACE CKEY WITH "AA"
REPLACE ALT WITH "A3"
REPLACE PAYLOAD WITH "upper"
APPEND
REPLACE CKEY WITH "BB"
REPLACE ALT WITH "A4"
REPLACE PAYLOAD WITH "wrong"
APPEND
REPLACE CKEY WITH "Bb"
REPLACE ALT WITH "A5"
REPLACE PAYLOAD WITH "exact"
APPEND
REPLACE CKEY WITH "zz"
REPLACE ALT WITH "A6"
REPLACE PAYLOAD WITH "orphan"
CLOSE

SELECT 1
USE SQLJNL
GO 4
DELETE
GO 3

SELECT 2
USE SQLJNR
CDX CREATE
CDX ADDTAG ID
BUILDLMDB CLEAN YES
SET INDEX TO SQLJNR
SET ORDER TO TAG ID
GO 3
DELETE
GO 5

SELECT 3
USE SQLJCL
GO 4
DELETE
GO 2

SELECT 4
USE SQLJCR
CDX CREATE
CDX ADDTAG CKEY
CDX ADDTAG ALT
BUILDLMDB CLEAN YES
SET INDEX TO SQLJCR
SET ORDER TO TAG CKEY
GO 6

SELECT 1
FORMULA "SQLSEL-JE-NUM-SEEK-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLJNL L JOIN SQLJNR R ON L.ID = R.ID ORDER BY R.PAYLOAD
FORMULA "SQLSEL-JE-NUM-SEEK-END"

SELECT 2
SET ORDER TO 0
GO 5
SELECT 1
FORMULA "SQLSEL-JE-NUM-SCAN-BEGIN"
SQLSEL L.LBL,R.PAYLOAD FROM SQLJNL L JOIN SQLJNR R ON L.ID = R.ID ORDER BY R.PAYLOAD
FORMULA "SQLSEL-JE-NUM-SCAN-END"

SELECT 4
SET ORDER TO TAG CKEY
GO 6
SELECT 1
FORMULA "SQLSEL-JE-CHAR-SEEK-BEGIN"
SQLSEL L.LBL,L.CKEY,R.PAYLOAD FROM SQLJCL L JOIN SQLJCR R ON L.CKEY = R.CKEY ORDER BY R.PAYLOAD
FORMULA "SQLSEL-JE-CHAR-SEEK-END"

; ALT is a valid active CDX tag, but it does not index the ON field.
SELECT 4
SET ORDER TO TAG ALT
GO 6
SELECT 1
FORMULA "SQLSEL-JE-CHAR-SCAN-BEGIN"
SQLSEL L.LBL,L.CKEY,R.PAYLOAD FROM SQLJCL L JOIN SQLJCR R ON L.CKEY = R.CKEY ORDER BY R.PAYLOAD
FORMULA "SQLSEL-JE-CHAR-SCAN-END"

SELECT 1
? "JE_C1_numeric_left_cursor_restored:" + (ID = 3 AND ALLTRIM(LBL) = "L3")
SELECT 2
? "JE_C2_numeric_right_cursor_restored:" + (ID = 9 AND ALLTRIM(PAYLOAD) = "ORPHAN")
SELECT 3
? "JE_C3_char_left_cursor_restored:" + (ALLTRIM(CKEY) = "AA" AND ALLTRIM(LBL) = "C2")
SELECT 4
? "JE_C4_char_right_cursor_restored:" + (ALLTRIM(CKEY) = "zz" AND ALLTRIM(PAYLOAD) = "orphan")

FORMULA "SQLSEL-JE-REFUSALS-BEGIN"
SQLSEL X.LBL FROM SQLJNL X JOIN SQLJNR X ON X.ID = X.ID
SQLSEL L.LBL FROM SQLJNL L JOIN SQLJNR R ON L.ID = L.ID
SQLSEL L.LBL FROM SQLJNL L JOIN SQLJNR R ON L.ID = R.ID JOIN SQLJCL C ON R.ID = C.CKEY
SQLSEL A.LBL FROM SQLJNL A JOIN SQLJNL B ON A.ID = B.ID
FORMULA "SQLSEL-JE-REFUSALS-END"

FORMULA "SQLSEL-JE-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLJNL (ID INTEGER, LBL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLJNR (ID INTEGER, PAYLOAD TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLJCL (CKEY TEXT, LBL TEXT, D INTEGER);
SQLITE EXEC CREATE TABLE SQLJCR (CKEY TEXT, ALT TEXT, PAYLOAD TEXT, D INTEGER);
SQLITE EXEC INSERT INTO SQLJNL VALUES (1,'L1',0),(2,'L2',0),(3,'L3',0),(1,'GHOSTL',1);
SQLITE EXEC INSERT INTO SQLJNR VALUES (1,'R1A',0),(1,'R1B',0),(2,'GHOSTR',1),(3,'R3',0),(9,'ORPHAN',0);
SQLITE EXEC INSERT INTO SQLJCL VALUES ('aa','C1',0),('AA','C2',0),('Bb','C3',0),('aa','GHOSTC',1);
SQLITE EXEC INSERT INTO SQLJCR VALUES ('aa','A1','lower1',0),('aa','A2','lower2',0),('AA','A3','upper',0),('BB','A4','wrong',0),('Bb','A5','exact',0),('zz','A6','orphan',0);

FORMULA "SQLSEL-JE-ON1-BEGIN"
SQLITE SELECT SELECT L.LBL,R.PAYLOAD FROM SQLJNL L JOIN SQLJNR R ON L.ID=R.ID WHERE L.D=0 AND R.D=0 ORDER BY R.PAYLOAD;
FORMULA "SQLSEL-JE-ON1-END"

FORMULA "SQLSEL-JE-ON2-BEGIN"
SQLITE SELECT SELECT L.LBL,R.PAYLOAD FROM SQLJNL L JOIN SQLJNR R ON L.ID=R.ID WHERE L.D=0 AND R.D=0 ORDER BY R.PAYLOAD;
FORMULA "SQLSEL-JE-ON2-END"

FORMULA "SQLSEL-JE-OC1-BEGIN"
SQLITE SELECT SELECT L.LBL,L.CKEY,R.PAYLOAD FROM SQLJCL L JOIN SQLJCR R ON L.CKEY=R.CKEY WHERE L.D=0 AND R.D=0 ORDER BY R.PAYLOAD;
FORMULA "SQLSEL-JE-OC1-END"

FORMULA "SQLSEL-JE-OC2-BEGIN"
SQLITE SELECT SELECT L.LBL,L.CKEY,R.PAYLOAD FROM SQLJCL L JOIN SQLJCR R ON L.CKEY=R.CKEY WHERE L.D=0 AND R.D=0 ORDER BY R.PAYLOAD;
FORMULA "SQLSEL-JE-OC2-END"

SQLITE CLOSE
FORMULA "SQLSEL-JE-ORACLE-END"

SELECT 4
CLOSE
SELECT 3
CLOSE
SELECT 2
CLOSE
SELECT 1
CLOSE

ERASE TABLE SQLJNL CONFIRM
ERASE TABLE SQLJNR CONFIRM
ERASE TABLE SQLJCL CONFIRM
ERASE TABLE SQLJCR CONFIRM

SET DELETED ON
FORMULA "SQLSEL-JE-END"
