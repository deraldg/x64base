* ============================================================================
* AIF-074 P4.1 -- SQLsel two-table INNER JOIN, oracle-gated (G4a)
*
* Status: CANDIDATE / explicit-run
* Safety: MUTATING (SANDBOX only; both fixtures self-erase)
* Proves:
*   J1 aliases + qualified projection + numeric equi-key
*   J2 row multiplication (one parent key matches two inner rows)
*   J3 joined TupleRow WHERE with a qualified right-side field
*   J4 ORDER BY and LIMIT operate on the joined set
*   J5 COUNT(*) counts joined rows
*   J6 both source cursors are restored by data, not RECNO text
*   J7 corrective errors: ambiguous projection, unqualified ON, unopened table
*   ORACLE identical data and queries in SQLite in the same run
* Read rule: REGRESSION SQLSEL_INNER_JOIN must print SQLSEL JOIN ORACLE: PASS.
*   The executable validator compares J1/J3/J4/J5 row values, order and counts
*   with O1/O3/O4/O5; requires both cursor guards, all three corrective
*   refusals and four reported access paths. Missing or silent output = FAIL.
*   A direct DOTSCRIPT run prints both sides but does not invoke the validator.
* ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "SQLSEL-G4A-BEGIN"

ERASE TABLE SQLJSTU CONFIRM
ERASE TABLE SQLJENR CONFIRM

CREATE X64 SQLJSTU (SID N(6,0), LNAME C(12))
APPEND
REPLACE SID WITH "1"
REPLACE LNAME WITH "ADAMS"
APPEND
REPLACE SID WITH "2"
REPLACE LNAME WITH "BAKER"
APPEND
REPLACE SID WITH "3"
REPLACE LNAME WITH "CARTER"
CLOSE

CREATE X64 SQLJENR (SID N(6,0), COURSE C(8))
APPEND
REPLACE SID WITH "1"
REPLACE COURSE WITH "CS101"
APPEND
REPLACE SID WITH "1"
REPLACE COURSE WITH "CS102"
APPEND
REPLACE SID WITH "3"
REPLACE COURSE WITH "HI201"
APPEND
REPLACE SID WITH "9"
REPLACE COURSE WITH "NOJOIN"
CLOSE

SELECT 1
USE SQLJSTU
GO 2
SELECT 2
USE SQLJENR
GO 4

FORMULA "SQLSEL-J1-J2-BEGIN"
SQLSEL S.SID,S.LNAME,E.COURSE FROM SQLJSTU AS S INNER JOIN SQLJENR AS E ON S.SID = E.SID ORDER BY E.COURSE
FORMULA "SQLSEL-J1-J2-END"

FORMULA "SQLSEL-J3-BEGIN"
SQLSEL SELECT S.LNAME,E.COURSE FROM SQLJSTU S JOIN SQLJENR E ON S.SID = E.SID WHERE E.COURSE = 'CS102'
FORMULA "SQLSEL-J3-END"

FORMULA "SQLSEL-J4-BEGIN"
SQLSEL S.LNAME,E.COURSE FROM SQLJSTU S JOIN SQLJENR E ON S.SID = E.SID ORDER BY E.COURSE DESC LIMIT 2
FORMULA "SQLSEL-J4-END"

FORMULA "SQLSEL-J5-BEGIN"
SQLSEL COUNT(*) FROM SQLJSTU S JOIN SQLJENR E ON S.SID = E.SID
FORMULA "SQLSEL-J5-END"

SELECT 1
? "J6A_left_cursor_restored:" + (ALLTRIM(LNAME) = "BAKER")
SELECT 2
? "J6B_right_cursor_restored:" + (ALLTRIM(COURSE) = "NOJOIN")

FORMULA "SQLSEL-J7-BEGIN"
SQLSEL SID FROM SQLJSTU S JOIN SQLJENR E ON S.SID = E.SID
SQLSEL S.LNAME FROM SQLJSTU S JOIN SQLJENR E ON SID = E.SID
SQLSEL S.LNAME FROM SQLJSTU S JOIN NOSUCH E ON S.SID = E.SID
FORMULA "SQLSEL-J7-END"

FORMULA "SQLSEL-G4A-ORACLE-BEGIN"
SQLITE OPEN :memory:
SQLITE EXEC CREATE TABLE SQLJSTU (SID INTEGER, LNAME TEXT);
SQLITE EXEC CREATE TABLE SQLJENR (SID INTEGER, COURSE TEXT);
SQLITE EXEC INSERT INTO SQLJSTU VALUES (1,'ADAMS'),(2,'BAKER'),(3,'CARTER');
SQLITE EXEC INSERT INTO SQLJENR VALUES (1,'CS101'),(1,'CS102'),(3,'HI201'),(9,'NOJOIN');
FORMULA "SQLSEL-O1-BEGIN"
SQLITE SELECT SELECT S.SID,S.LNAME,E.COURSE FROM SQLJSTU S INNER JOIN SQLJENR E ON S.SID=E.SID ORDER BY E.COURSE;
FORMULA "SQLSEL-O1-END"
FORMULA "SQLSEL-O3-BEGIN"
SQLITE SELECT SELECT S.LNAME,E.COURSE FROM SQLJSTU S INNER JOIN SQLJENR E ON S.SID=E.SID WHERE E.COURSE='CS102';
FORMULA "SQLSEL-O3-END"
FORMULA "SQLSEL-O4-BEGIN"
SQLITE SELECT SELECT S.LNAME,E.COURSE FROM SQLJSTU S INNER JOIN SQLJENR E ON S.SID=E.SID ORDER BY E.COURSE DESC LIMIT 2;
FORMULA "SQLSEL-O4-END"
FORMULA "SQLSEL-O5-BEGIN"
SQLITE SELECT SELECT COUNT(*) AS JOINED_ROWS FROM SQLJSTU S INNER JOIN SQLJENR E ON S.SID=E.SID;
FORMULA "SQLSEL-O5-END"
SQLITE CLOSE
FORMULA "SQLSEL-G4A-ORACLE-END"

SELECT 2
CLOSE
SELECT 1
CLOSE
ERASE TABLE SQLJSTU CONFIRM
ERASE TABLE SQLJENR CONFIRM

FORMULA "SQLSEL-G4A-END"
