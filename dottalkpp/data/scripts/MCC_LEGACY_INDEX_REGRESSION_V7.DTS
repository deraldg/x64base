SET ECHO OFF
* ============================================================
* MCC_LEGACY_INDEX_REGRESSION_V7.DTS
*
* Purpose:
*   Legacy / transitional index regression for v32-facing table
*   workflows, INX/CNX transitional behavior, and safe index
*   diagnostics that do NOT assume x64/LMDB attachment success.
*
* Scope:
*   - SET INDEX TO <cdx> attach surface
*   - SHOW INDEX / AREA after attach attempts
*   - REINDEX transitional behavior
*   - INDEXSEEK on legacy/transitional path where valid
*   - ordered attach attempts recorded as observation, not failure
*
* Excludes:
*   - LMDB utility commands
*   - x64/XDBF-only assumptions
*   - SEEK/FIND canaries that require active LMDB-backed order
* ============================================================

ECHO ===== V7 LEGACY INDEX START =====
COLOR DEFAULT
VERSION

ECHO ===== INIT / PATHS =====
INIT
SET PATH
SCHEMAS CLOSE
REL CLEAR ALL
SCHEMAS OPEN DBF

ECHO ===== BUILDING: TRANSITIONAL CDX + REINDEX =====
SELECT BUILDING
AREA
SHOW INDEX
SET INDEX TO BUILDING.cdx
AREA
SHOW INDEX
SET ORDER TO TAG BLDG
AREA
SHOW INDEX
TOP
LIST 3
REINDEX
SHOW INDEX
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== ROOMS: TRANSITIONAL CDX ATTACH =====
SELECT ROOMS
AREA
SHOW INDEX
SET INDEX TO ROOMS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG ROOM
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== DEPT: TRANSITIONAL CDX ATTACH =====
SELECT DEPT
AREA
SHOW INDEX
SET INDEX TO DEPT.cdx
AREA
SHOW INDEX
SET ORDER TO TAG DEPT_ID
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== MAJORS: TRANSITIONAL CDX ATTACH =====
SELECT MAJORS
AREA
SHOW INDEX
SET INDEX TO MAJORS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG MAJOR
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== COURSES: TRANSITIONAL CDX ATTACH =====
SELECT COURSES
AREA
SHOW INDEX
SET INDEX TO COURSES.cdx
AREA
SHOW INDEX
SET ORDER TO TAG CID
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== CLASSES: TRANSITIONAL CDX ATTACH =====
SELECT CLASSES
AREA
SHOW INDEX
SET INDEX TO CLASSES.cdx
AREA
SHOW INDEX
SET ORDER TO TAG CLS_ID
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== TEACHERS: EXPECTED OBSERVATION (METADATA MISMATCH CURRENTLY ACCEPTED) =====
SELECT TEACHERS
AREA
SHOW INDEX
SET INDEX TO TEACHERS.cdx
AREA
SHOW INDEX
SET ORDER TO TAG LNAME
AREA
SHOW INDEX
TOP
LIST 3
SET ORDER TO 0
AREA
SHOW INDEX

ECHO ===== STUDENTS: PUBLIC INDEX WORKFLOW (TRANSITIONAL) =====
SELECT STUDENTS
AREA
SHOW INDEX
SET INDEX TO STUDENTS.cdx
AREA
SHOW INDEX

ECHO [OBSERVE] ORDER ATTACH MAY FAIL WHILE LEGACY TABLE/X64 INDEX CONTRACT IS UNFINISHED:
SET ORDER TO TAG LNAME
AREA
SHOW INDEX
TOP
RECNO
LIST 5

ECHO ===== STUDENTS: LEGACY / TRANSITIONAL REINDEX =====
REINDEX
SHOW INDEX
INDEXSEEK "DAVIS"

ECHO ===== STUDENTS: TRANSITIONAL BUFFER + REINDEX =====
LOCATE lname = Taylor
TUPLE *
TABLE ON
REPLACE FNAME WITH "DeraldNew"
TUPLE *
LIST 1
COMMIT
SHOW INDEX
LIST 1
REPLACE FNAME WITH "Derald"
COMMIT
SHOW INDEX
LIST 1
TABLE OFF

ECHO ===== STUDENTS: CALCWRITE + REINDEX =====
LOCATE lname = Taylor
TABLE ON
TUPLE GPA
CALC GPA = GPA + 0.01
TUPLE GPA
COMMIT
SHOW INDEX
LIST 1
CALC GPA = GPA - 0.01
COMMIT
SHOW INDEX
LIST 1
TABLE OFF

ECHO ===== BUILDING: REINDEX DIAGNOSTIC =====
SELECT BUILDING
SET INDEX TO BUILDING.cdx
SET ORDER TO TAG BLDG
REINDEX
SHOW INDEX

ECHO ===== STUDENTS: REINDEX DIAGNOSTIC =====
SELECT STUDENTS
SET INDEX TO STUDENTS.cdx
SET ORDER TO TAG LNAME
REINDEX
SHOW INDEX
INDEXSEEK "DAVIS"

ECHO ===== CLEAN SHUTDOWN =====
SET ORDER TO 0
SCHEMAS
SCHEMAS CLOSE
ECHO ===== V7 LEGACY INDEX END =====
QUIT