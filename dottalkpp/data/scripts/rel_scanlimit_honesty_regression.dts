* rel_scanlimit_honesty_regression.dts
* ============================================================================
* AIF-074 P1.3 -- scan-limit honesty (RDB-06) + REL SCANLIMIT reach (OQ-1)
*
* NOTE: "scan-limit truncation" = RESULT-SET rows cut off by the relation
* engine's scan-step cap. Unrelated to x64base long-name mangling.
*
* Status: CANDIDATE / explicit-run
* Safety: MUTATING (SANDBOX only: throwaway RSLPAR/RSLCHD; session scan limit
*         is restored to the 500000 default at the end)
* Proves:
*   T1  REL SCANLIMIT reports and sets (previously unreachable from CLI)
*   T2  With limit 1, REL LIST's match count scan warns
*       "REL: scan limit (1) reached; results may be incomplete."  (RED path)
*   T3  Warning appears ONCE per REL command even with multiple children
*       -- ADDED 2026-08-28. The header claimed T3 from the start and NO T3
*       BLOCK WAS EMITTED: the fixture declared exactly one child, so the latch
*       (note_scan_truncated) was never exercised. The registered spec named
*       both the gap and the remedy -- "a second child plus its own marked
*       block" -- and this is that. T1/T2/T4 are UNTOUCHED so the assertions
*       already registered against them still read the same output.
*   T5  A truncated REL LIST also states, AT THE RESULT, that its match counts
*       are LOWER BOUNDS. New: scan_truncated() had no pollers until 2026-08-28.
*   T6  With TWO children and NO path, REL ENUM must name the CHILDREN it
*       cannot choose between -- not the internal function that returned false.
*   T7  The same traversal with an EXPLICIT child emits and is warning-free.
* Read rules:
*   T2 block MUST contain the warning; T4 block MUST NOT.
*   T3 block MUST contain the warning EXACTLY ONCE despite two children.
*   T5 block MUST contain "LOWER BOUNDS".
*   T6 block MUST contain both child names and MUST NOT contain the string
*      "enum_emit_for_current_parent" -- a refusal that names its own internals
*      instead of its cause reads as a crash.
*   T7 block MUST contain a row and MUST NOT contain any scan-limit warning.
* ============================================================================

SET ECHO OFF
STOP_ON_ERROR OFF

SET PATH DBF DBF/SANDBOX
SET PATH INDEXES INDEXES/SANDBOX
SET PATH LMDB LMDB/SANDBOX

FORMULA "RELSCAN-REGRESSION-BEGIN"

ERASE TABLE RSLPAR CONFIRM
ERASE TABLE RSLCHD CONFIRM
ERASE TABLE RSLCHD2 CONFIRM
REL CLEAR ALL

CREATE X64 RSLPAR (PK C(4), PLBL C(10))
APPEND
REPLACE PK WITH "A"
REPLACE PLBL WITH "P_ONE"
CLOSE

CREATE X64 RSLCHD (CK C(4), CLBL C(10))
APPEND
REPLACE CK WITH "ZZ"
REPLACE CLBL WITH "C_TOP"
APPEND
REPLACE CK WITH "A"
REPLACE CLBL WITH "C_A1"
APPEND
REPLACE CK WITH "A"
REPLACE CLBL WITH "C_A2"
CLOSE

CREATE X64 RSLCHD2 (CK2 C(4), CLBL2 C(10))
APPEND
REPLACE CK2 WITH "A"
REPLACE CLBL2 WITH "D_A1"
APPEND
REPLACE CK2 WITH "QQ"
REPLACE CLBL2 WITH "D_TOP"
CLOSE

SELECT 1
USE RSLPAR
SELECT 2
USE RSLCHD
SELECT RSLPAR
REL ADD RSLPAR RSLCHD ON PK TO CK

* --- T1: report, then set to 1 ---
FORMULA "RELSCAN-T1-BEGIN"
REL SCANLIMIT
REL SCANLIMIT 1
FORMULA "RELSCAN-T1-END"

* --- T2/T3: limit 1 forces the honesty warning, once per command ---
FORMULA "RELSCAN-T2-BEGIN"
REL LIST
FORMULA "RELSCAN-T2-END"

* --- T4: default restored; same command must be warning-free ---
REL SCANLIMIT 500000
FORMULA "RELSCAN-T4-BEGIN"
REL LIST
FORMULA "RELSCAN-T4-END"

* ============================================================================
* SECOND CHILD -- everything below is ADDITIVE. T1/T2/T4 above ran against a
* single child on purpose and their blocks are unchanged.
* ============================================================================

* RSLCHD2 is CREATED with the others above, deliberately. CREATE opens the new
* table INTO THE CURRENT AREA, so creating it here -- after SELECT 1 / USE
* RSLPAR -- displaced RSLPAR from area 1 and the following CLOSE left area 1
* empty. Proven by a run 2026-08-28: SELECT RSLPAR then reported "no area
* matches", REL ADD reported "parent/child not open", and T3/T5 rooted on
* RSLCHD2 instead. Creating early and only OPENING here keeps T1/T2/T4
* untouched, since RSLCHD2 has no relation until the REL ADD below.

SELECT 3
USE RSLCHD2
SELECT RSLPAR
REL ADD RSLPAR RSLCHD2 ON PK TO CK2

* --- T3: TWO children, limit 1. The warning must appear ONCE, not twice. ---
REL SCANLIMIT 1
FORMULA "RELSCAN-T3-BEGIN"
REL LIST
FORMULA "RELSCAN-T3-END"

* --- T5: the same truncated LIST must ALSO say the counts are lower bounds ---
FORMULA "RELSCAN-T5-BEGIN"
REL LIST
FORMULA "RELSCAN-T5-END"

* --- T6: ambiguity, NOT truncation. Restore the limit first so the only ---
* --- reason ENUM can refuse is that it cannot choose between two children. ---
REL SCANLIMIT 500000
FORMULA "RELSCAN-T6-BEGIN"
REL ENUM LIMIT 5 TUPLE RSLPAR.PLBL, RSLCHD.CLBL
FORMULA "RELSCAN-T6-END"

* --- T7: name the child explicitly; must emit, and must not warn ---
FORMULA "RELSCAN-T7-BEGIN"
REL ENUM RSLCHD LIMIT 5 TUPLE RSLPAR.PLBL, RSLCHD.CLBL
FORMULA "RELSCAN-T7-END"

* --- cleanup ---
REL CLEAR ALL
SELECT 1
CLOSE
SELECT 2
CLOSE
SELECT 3
CLOSE
ERASE TABLE RSLPAR CONFIRM
ERASE TABLE RSLCHD CONFIRM
ERASE TABLE RSLCHD2 CONFIRM

FORMULA "RELSCAN-REGRESSION-END"
