    "sqlite_kind": "view",
    "sqlite_object": "v_Open_Sales_Orders",
    "sqlite_sql": "CREATE VIEW v_Open_Sales_Orders AS\nSELECT\n    so.SO_ID,\n    so.SO_Number,\n    so.Order_Date,\n    so.Required_Date,\n    so.Status,\n    c.Customer_Code,\n    c.Customer_Name,\n    e.Employee_Code AS Sales_Rep_Code,\n    e.First_Name || ' ' || e.Last_Name AS Sales_Rep,\n    so.Total_Amount\nFROM Sales_Orders so\nJOIN Customers c ON c.Customer_ID = so.Customer_ID\nLEFT JOIN Employees e ON e.Employee_ID = so.Sales_Rep_ID\nWHERE so.Status NOT IN ('CLOSED','CANCELLED')"
