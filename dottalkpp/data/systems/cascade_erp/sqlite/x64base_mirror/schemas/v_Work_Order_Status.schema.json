    "sqlite_kind": "view",
    "sqlite_object": "v_Work_Order_Status",
    "sqlite_sql": "CREATE VIEW v_Work_Order_Status AS\nSELECT\n    wo.WO_ID,\n    wo.WO_Number,\n    i.SKU,\n    i.Description,\n    wo.Qty_Ordered,\n    wo.Qty_Completed,\n    wo.Qty_Scrapped,\n    wo.Status,\n    wo.Start_Date,\n    wo.Due_Date,\n    so.SO_Number\nFROM Work_Orders wo\nJOIN Items i ON i.Item_ID = wo.Item_ID\nLEFT JOIN Sales_Orders so ON so.SO_ID = wo.SO_ID"
