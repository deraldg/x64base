    "constraint_enforcement": "sidecar_only_on_x64base",
    "sqlite_kind": "view",
    "sqlite_object": "v_AP_Aging",
    "sqlite_sql": "CREATE VIEW v_AP_Aging AS\nSELECT\n    ap.AP_Invoice_ID,\n    ap.Invoice_Number,\n    v.Vendor_Code,\n    v.Vendor_Name,\n    ap.Invoice_Date,\n    ap.Due_Date,\n    CAST(julianday('now') - julianday(ap.Due_Date) AS INTEGER) AS Days_Past_Due,\n    ap.Total_Amount,\n    ap.Amount_Paid,\n    (ap.Total_Amount - ap.Amount_Paid) AS Balance,\n    ap.Status\nFROM AP_Invoices ap\nLEFT JOIN Vendors v ON v.Vendor_ID = ap.Vendor_ID\nWHERE ap.Status IN ('OPEN','PARTIAL')"
  }
