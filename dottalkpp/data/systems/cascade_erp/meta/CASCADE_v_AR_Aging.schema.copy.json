    "sqlite_kind": "view",
    "sqlite_object": "v_AR_Aging",
    "sqlite_sql": "CREATE VIEW v_AR_Aging AS\nSELECT\n    ar.AR_Invoice_ID,\n    ar.Invoice_Number,\n    c.Customer_Code,\n    c.Customer_Name,\n    ar.Invoice_Date,\n    ar.Due_Date,\n    CAST(julianday('now') - julianday(ar.Due_Date) AS INTEGER) AS Days_Past_Due,\n    ar.Total_Amount,\n    ar.Amount_Paid,\n    (ar.Total_Amount - ar.Amount_Paid) AS Balance,\n    ar.Status\nFROM AR_Invoices ar\nJOIN Customers c ON c.Customer_ID = ar.Customer_ID\nWHERE ar.Status IN ('OPEN','PARTIAL')"
  }
