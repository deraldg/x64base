    "sqlite_kind": "view",
    "sqlite_object": "v_Available_Stock",
    "sqlite_sql": "CREATE VIEW v_Available_Stock AS\nSELECT\n    i.Item_ID,\n    i.SKU,\n    i.Description,\n    i.Item_Type,\n    w.Warehouse_Code,\n    w.Warehouse_Name,\n    s.Bin_Location,\n    s.Qty_OnHand,\n    s.Qty_Committed,\n    s.Qty_OnOrder,\n    (s.Qty_OnHand - s.Qty_Committed) AS Available,\n    i.Reorder_Point,\n    i.Reorder_Qty\nFROM Stock_Levels s\nJOIN Items i ON i.Item_ID = s.Item_ID\nJOIN Warehouses w ON w.Warehouse_ID = s.Warehouse_ID"
  }
