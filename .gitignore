node_modules

# next
.next
out
dist
# Generated by Next on every run, and the two run modes disagree: `next dev`
# writes ".next/dev/types/routes.d.ts", `next build` writes ".next/types/...".
# Tracked, it flip-flops between the dev server and the publish build, and the
# publish guard (a blanket `git status --short`) then refuses to publish over a
# file nobody edited. Untracked, it is regenerated correctly by whichever mode
# runs -- which is what upstream Next recommends. No process needs stopping.
next-env.d.ts
.sites-artifact
.gh-pages-deploy
x64base-sites-artifact.tar.gz

