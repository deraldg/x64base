{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dottalk:ddict:native:v1",
  "title": "Native read-only DDICT projection",
  "type": "object",
  "required": ["schema", "physical_tables", "tables", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "dottalk.ddict.native.v1"},
    "physical_tables": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["physical_name", "logical_name", "family", "state", "rows", "fields"],
      "properties": {
        "physical_name": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "logical_name": {"type": "string"},
        "family": {"enum": ["LEGACY", "X64"]},
        "state": {"enum": ["READY", "MISSING", "ERROR"]},
        "rows": {"type": "integer", "minimum": 0},
        "fields": {"type": "array", "items": {
          "type": "object", "required": ["name", "type", "width"], "additionalProperties": false,
          "properties": {"name": {"type": "string"}, "type": {"type": "string", "minLength": 1, "maxLength": 1}, "width": {"type": "integer", "minimum": 0}}
        }}
      }
    }},
    "tables": {
      "type": "object", "minProperties": 11, "maxProperties": 11,
      "required": ["DDRUN", "DDBASE", "DDSOURCE", "DDOBJECT", "DDATTR", "DDEDGE", "DDEVID", "DDGATE", "DDREVIEW", "DDARTIF", "DDPROFILE"],
      "additionalProperties": {"type": "array", "items": {
        "type": "object", "required": ["_DD_FAMILY", "_DD_TABLE", "_DD_ID"],
        "additionalProperties": {"type": "string"}
      }}
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
