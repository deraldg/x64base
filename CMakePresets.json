{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "DOTTALK_PROFILE": "PROD",
        "DOTTALK_INDEX_MODE": "NONE",
        "DOTTALK_PRODUCT": "LEAN",
        "DOTTALK_WITH_TV": "OFF",
        "DOTTALK_WITH_GUI": "OFF",
        "DOTTALK_WITH_WX": "OFF",
        "BUILD_PYDOTTALK": "OFF",
        "DOTTALK_BUILD_METACOLLECT": "OFF"
      }
    },
    {
      "name": "core",
      "displayName": "Portable core (system dependencies)",
      "inherits": "core-base",
      "generator": "Ninja"
    },
    {
      "name": "core-vcpkg",
      "displayName": "Portable core (vcpkg)",
      "inherits": "core-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-core",
      "displayName": "Windows lean table-only (MSVC + vcpkg)",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-lean-table",
      "displayName": "Windows LEAN + table-only + pydottalk",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "python",
        "DOTTALK_INDEX_MODE": "NONE",
        "DOTTALK_PRODUCT": "LEAN",
        "BUILD_PYDOTTALK": "ON"
      }
    },
    {
      "name": "windows-lean-lmdb",
      "displayName": "Windows LEAN + LMDB index",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "index",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "LEAN"
      }
    },
    {
      "name": "windows-educational-lmdb",
      "displayName": "Windows EDUCATIONAL + LMDB index",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "index",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "EDUCATIONAL"
      }
    },
    {
      "name": "windows-development-lmdb",
      "displayName": "Windows DEVELOPMENT + LMDB index",
      "inherits": "core-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "index",
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT"
      }
    },
    {
      "name": "index-vcpkg",
      "displayName": "Core plus LMDB indexing (vcpkg)",
      "inherits": "core-base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "LEAN",
        "VCPKG_MANIFEST_FEATURES": "index"
      }
    },
    {
      "name": "pro-md",
      "displayName": "DotTalk++ development (MSVC, /MD, TV + index)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "tv;index",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT",
        "DOTTALK_WITH_TV": "ON",
        "BUILD_PYDOTTALK": "OFF"
      }
    },
    {
      "name": "pro-md-labtalk",
      "displayName": "DotTalk++ + pydottalk development (MSVC, /MD)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "${sourceDir}/build-labtalk",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "tv;index;python",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT",
        "DOTTALK_WITH_TV": "ON",
        "BUILD_PYDOTTALK": "ON"
      }
    },
    {
      "name": "ansi-mt",
      "displayName": "ANSI (MSVC, /MT, no TV)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "binaryDir": "${sourceDir}/build-ansi-mt",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT",
        "DOTTALK_WITH_TV": "OFF"
      }
    },
    {
      "name": "wsl",
      "displayName": "WSL (Linux, Ninja, no TV)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-wsl",
      "cacheVariables": {
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT",
        "DOTTALK_WITH_TV": "OFF"
      }
    },
    {
      "name": "wsl-lean",
      "displayName": "WSL lean (Linux, Ninja, LMDB, no TV/WX)",
      "description": "Fast in-loop Linux build. Uses the canonical vcpkg.json with VCPKG_MANIFEST_FEATURES=index, so vcpkg installs only the four base packages and never builds tvision or wxwidgets -- no vcpkg-wsl.json swap needed. Lean means lean DEPENDENCIES, not a lean command surface: PRODUCT=DEVELOPMENT and WITH_DEV=ON keep REGRESSION available. vcpkg_installed is per-build-dir, so this does not disturb build-wsl.",
      "inherits": "core-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-wsl-lean",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_FEATURES": "index",
        "DOTTALK_PROFILE": "DEV",
        "DOTTALK_INDEX_MODE": "LMDB",
        "DOTTALK_PRODUCT": "DEVELOPMENT",
        "DOTTALK_WITH_DEV": "ON",
        "DOTTALK_WITH_TV": "OFF",
        "DOTTALK_WITH_GUI": "OFF",
        "DOTTALK_WITH_WX": "OFF",
        "BUILD_PYDOTTALK": "OFF"
      }
    },
    {
      "name": "wsl-gui-core",
      "displayName": "WSL GUI-neutral core (Linux, Ninja, LMDB, no TV/WX)",
      "description": "wsl-lean plus DOTTALK_WITH_GUI=ON. src/CMakeLists.txt gates gui/core on (DOTTALK_WITH_GUI OR DOTTALK_WITH_WX) and gui/wx on DOTTALK_WITH_WX alone, so this compiles and tests dottalk_gui_core with no toolkit present. dottalk_gui_core links only xbase and memo and contains no wx include; every extra source it pulls in (path_state, path_resolver, the four ddict_*, order_iterator, order_state) already builds on Linux in wsl-lean. Use this to compile and run GUI application logic in the Linux loop; the wx widget layer still requires a Windows MSVC build.",
      "inherits": "wsl-lean",
      "binaryDir": "${sourceDir}/build-wsl-gui-core",
      "cacheVariables": {
        "DOTTALK_WITH_GUI": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "core", "configurePreset": "core" },
    { "name": "core-vcpkg", "configurePreset": "core-vcpkg" },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Release" },
    { "name": "windows-lean-table", "configurePreset": "windows-lean-table", "configuration": "Release" },
    { "name": "windows-lean-lmdb", "configurePreset": "windows-lean-lmdb", "configuration": "Release" },
    { "name": "windows-educational-lmdb", "configurePreset": "windows-educational-lmdb", "configuration": "Release" },
    { "name": "windows-development-lmdb", "configurePreset": "windows-development-lmdb", "configuration": "Release" },
    { "name": "index-vcpkg", "configurePreset": "index-vcpkg" },
    { "name": "pro-md-Release", "configurePreset": "pro-md", "configuration": "Release" },
    { "name": "pro-md-labtalk-Release", "configurePreset": "pro-md-labtalk", "configuration": "Release" },
    { "name": "ansi-mt-Release", "configurePreset": "ansi-mt", "configuration": "Release" },
    { "name": "wsl-Release", "configurePreset": "wsl", "configuration": "Release" },
    { "name": "wsl-lean", "configurePreset": "wsl-lean", "configuration": "Release" },
    { "name": "wsl-gui-core", "configurePreset": "wsl-gui-core", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "core", "configurePreset": "core", "output": { "outputOnFailure": true } },
    { "name": "core-vcpkg", "configurePreset": "core-vcpkg", "output": { "outputOnFailure": true } },
    { "name": "windows-core", "configurePreset": "windows-core", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-lean-table", "configurePreset": "windows-lean-table", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-lean-lmdb", "configurePreset": "windows-lean-lmdb", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-educational-lmdb", "configurePreset": "windows-educational-lmdb", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-development-lmdb", "configurePreset": "windows-development-lmdb", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "index-vcpkg", "configurePreset": "index-vcpkg", "output": { "outputOnFailure": true } },
    { "name": "pro-md-Release", "configurePreset": "pro-md", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "pro-md-labtalk-Release", "configurePreset": "pro-md-labtalk", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ansi-mt-Release", "configurePreset": "ansi-mt", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "wsl-Release", "configurePreset": "wsl", "output": { "outputOnFailure": true } },
    { "name": "wsl-gui-core", "configurePreset": "wsl-gui-core", "output": { "outputOnFailure": true } }
  ]
}
